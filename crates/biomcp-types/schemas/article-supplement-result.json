    "Reply_SourceNotice": {
      "description": "A source notice or request recovery step.",
      "oneOf": [
        {
          "description": "Local request limits and source-specific recovery guidance.",
          "properties": {
            "kind": {
              "const": "request-guidance",
              "type": "string"
            },
            "message": {
              "description": "Reviewed guidance without provider response text.",
              "type": "string"
            },
            "retry_after_seconds": {
              "description": "Seconds left before another source request may be admitted.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "Registered conditions lack the literal words requested in a condition search.",
          "properties": {
            "kind": {
              "const": "condition-word-mismatch",
              "type": "string"
            },
            "message": {
              "description": "The source searches several fields and can expand terms; no expansion cause is inferred.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "A checked provider answer survived a local cache failure.",
          "properties": {
            "kind": {
              "const": "cache-problem",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/Reply_CacheProblem",
              "description": "Bounded local failure without paths or database diagnostics."
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The source still has graph pages after the bounded fetch window.",
          "properties": {
            "fallback": {
              "$ref": "#/$defs/Reply_Text",
              "description": "Default-source command offering another graph view."
            },
            "kind": {
              "const": "graph-truncated",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "fallback"
          ],
          "type": "object"
        },
        {
          "description": "An empty LitVar lookup can be repeated with a caller-supplied rsID.",
          "properties": {
            "kind": {
              "const": "litvar-rsid-hint",
              "type": "string"
            },
            "message": {
              "description": "Guidance that never supplies or infers an rsID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "PubMed supplied a named ESearch warning without changing its phrases.",
          "properties": {
            "kind": {
              "const": "pubmed-warning",
              "type": "string"
            },
            "name": {
              "description": "Original provider warning name, including names added by PubMed later.",
              "type": "string"
            },
            "phrases": {
              "description": "Original provider phrases, preserving whitespace and quotes.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "PubMed did not index these words.",
          "properties": {
            "kind": {
              "const": "not-found-words",
              "type": "string"
            },
            "words": {
              "description": "Whole source words.",
              "items": {
                "$ref": "#/$defs/Reply_Text"
              },
              "type": "array"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Reply_SourceOutcome": {
      "description": "One source's outcome, without provider text.",
      "properties": {
        "count": {
          "description": "Provider matching count.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "notices": {
          "description": "Source notices and request recovery guidance.",
          "items": {
            "$ref": "#/$defs/Reply_SourceNotice"
          },
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Failure or stale-fallback reason."
        },
        "retrieved_count": {
          "description": "Number of retrieved identities.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "Asked source."
        },
        "state": {
          "$ref": "#/$defs/Reply_SourceState",
          "description": "Retained state."
        },
        "term": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact provider search term."
        },
        "terms": {
          "description": "Publisher terms name from the source registry.",
          "type": "string"
        },
        "terms_url": {
          "description": "Publisher page documenting the terms.",
          "format": "uri",
          "type": "string"
        },
        "use": {
          "$ref": "#/$defs/Reply_Use",
          "description": "Reviewed source use category; publisher terms remain authoritative."
        }
      },
      "required": [
        "source",
        "use",
        "terms",
        "terms_url",
        "state"
      ],
      "type": "object"
    },
    "Reply_SourceRecord": {
      "description": "The source's own entry for an entity.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Native source identifier."
        },
        "namespace": {
          "$ref": "#/$defs/Reply_IdentifierNamespace",
          "description": "Native authority; unknown means the source did not state one."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Link to that entry.",
          "format": "uri"
        }
      },
      "required": [
        "namespace",
        "id"
      ],
      "type": "object",
      "x-identifier": true
    },
    "Reply_SourceState": {
      "description": "State of a source actually asked by the command.",
      "enum": [
        "ok",
        "stale",
        "syncing",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "Reply_Status": {
      "description": "Overall command outcome.",
      "enum": [
        "complete",
        "partial",
        "absent",
        "failed"
      ],
      "type": "string"
    },
    "Reply_Step": {
      "description": "A command argument list spelled from a typed action.",
      "properties": {
        "args": {
          "description": "CLI and MCP arguments.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/Reply_StepKind",
          "description": "Purpose of the action."
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "Reply_StepKind": {
      "description": "Purpose of an available next command.",
      "enum": [
        "restart",
        "section",
        "sort",
        "page",
        "fresh",
        "disambiguate",
        "pivot",
        "sync",
        "key",
        "configure"
      ],
      "type": "string"
    },
    "Reply_SupplementContent": {
      "description": "Downloaded bounded file contents or an unsupported format's original URL.",
      "properties": {
        "forms": {
          "description": "Explicit variant spellings searched.",
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": [
            "array",
            "null"
          ]
        },
        "license": {
          "$ref": "#/$defs/Reply_License",
          "description": "Article license."
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Typed unsupported reason."
        },
        "rows": {
          "description": "Selected original rows.",
          "items": {
            "$ref": "#/$defs/Reply_SheetRow"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "saved": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_ArticleSaved"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit original-byte save receipt."
        },
        "search_message": {
          "description": "Explicit absence of matching text from the returned search page.",
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Hash of the original downloaded bytes; absent when no download occurred."
        },
        "sheets": {
          "description": "Original sheet dimensions.",
          "items": {
            "$ref": "#/$defs/Reply_SheetInfo"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Unsupported file URL, returned without downloading it.",
          "format": "uri"
        }
      },
      "required": [
        "license"
      ],
      "type": "object"
    },
    "Reply_Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    },
    "Reply_Use": {
      "description": "Reviewed source-use category, without inferring rights in individual records.",
      "enum": [
        "open",
        "attribution",
        "noncommercial",
        "restricted"
      ],
      "type": "string"
    }
  },
  "$id": "biomcp.article-supplement/7",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One versioned command response; schema identity comes only from its body type.\nJSON readers ignore unknown fields and unknown growable enum values within a major.",
  "properties": {
    "local_error": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_CacheProblem"
        },
        {
          "type": "null"
        }
      ],
      "description": "Bounded local cache failure, independent of provider outcomes."
    },
    "next": {
      "description": "Available next commands.",
      "items": {
        "$ref": "#/$defs/Reply_Step"
      },
      "type": "array"
    },
    "page": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_PageInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Search page metadata."
    },
    "problems": {
      "description": "Rejected source fields.",
      "items": {
        "$ref": "#/$defs/Reply_Problem"
      },
      "type": "array"
    },
    "query": {
      "$ref": "#/$defs/Reply_ArticleSupplement",
      "description": "Parsed query."
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_ArticleSupplementResult"
        },
        {
          "type": "null"
        }
      ],
      "description": "Answer when available."
    },
    "schema": {
      "const": "biomcp.article-supplement/7",
      "type": "string"
    },
    "sources": {
      "description": "Sources actually asked.",
      "items": {
        "$ref": "#/$defs/Reply_SourceOutcome"
      },
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/Reply_Status",
      "description": "Overall outcome."
    }
  },
  "required": [
    "schema",
    "status",
    "query"
  ],
  "title": "Envelope",
  "type": "object"
}
