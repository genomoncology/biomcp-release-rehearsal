{
  "$defs": {
    "Reply_ArticleInput": {
      "description": "A validated canonical ArticleInput string.",
      "pattern": "(^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$|^PMC(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$|(?=PPR)^(?=.{1,64}$)[A-Z]{1,8}[0-9]*[1-9][0-9]*$|^(?:https?://doi\\.org/)?10\\.[0-9]+/[^\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f]+$)",
      "type": "string"
    },
    "Reply_ArticleSaved": {
      "description": "Explicit saved article file, owned by the caller.",
      "properties": {
        "bytes": {
          "description": "Exact byte count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "parts": {
          "description": "Number of ordered text parts; absent for original supplement bytes.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Absolute caller destination."
        },
        "sha256": {
          "$ref": "#/$defs/Reply_Text",
          "description": "SHA-256 of the saved bytes."
        },
        "url": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Source URL for the original material.",
          "format": "uri"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256",
        "url"
      ],
      "type": "object"
    },
    "Reply_ArticleSupplement": {
      "description": "Read a checked supplement file or page its original rows.",
      "properties": {
        "file": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Exact file name from the supplements section.",
          "x-positional": 1
        },
        "find": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Literal case-insensitive needle."
        },
        "input": {
          "$ref": "#/$defs/Reply_ArticleInput",
          "description": "PubMed or PMC identity.",
          "x-positional": 0
        },
        "offset": {
          "default": 0,
          "description": "Matching-row or text-fragment offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "replace": {
          "description": "Replace an existing destination only when explicitly requested with save.",
          "type": "boolean"
        },
        "rows": {
          "$ref": "#/$defs/Reply_SheetRows",
          "description": "Inclusive original row range."
        },
        "save": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Save the whole original document to an explicit file or existing folder."
        },
        "sheet": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Sheet name for row selection."
        },
        "variant": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Explicit protein substitution."
        }
      },
      "required": [
        "input",
        "file"
      ],
      "type": "object"
    },
    "Reply_ArticleSupplementResult": {
      "description": "One supplement reader answer.",
      "properties": {
        "content": {
          "$ref": "#/$defs/Reply_Section_SupplementContent",
          "description": "Independently licensed supplement content."
        },
        "pmcid": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Pmcid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Resolved PMC identity."
        }
      },
      "required": [
        "content"
      ],
      "type": "object"
    },
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_CellFragment": {
      "description": "A bounded portion of one original first-row or selected-row cell.",
      "properties": {
        "column": {
          "description": "Original one-based column.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "first_row": {
          "description": "Whether the cell belongs to the first source row.",
          "type": "boolean"
        },
        "offset": {
          "description": "Unicode character offset within this cell.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "description": "Original cell text at this offset.",
          "type": "string"
        }
      },
      "required": [
        "first_row",
        "column",
        "offset",
        "text"
      ],
      "type": "object"
    },
    "Reply_FirstSheetRow": {
      "description": "The first original row without interpreting its cells as column headings.",
      "properties": {
        "cells": {
          "description": "Original cells, empty when represented by cell fragments.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "row": {
          "description": "Original one-based row number.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "row"
      ],
      "type": "object"
    },
    "Reply_IdentifierNamespace": {
      "description": "A source-stated authority or an explicit unknown authority, represented by the string unknown.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    },
    "Reply_License": {
      "description": "License reported by the bucket metadata record.",
      "type": "string",
      "x-enum-descriptions": [
        " Creative Commons Attribution.",
        " Creative Commons Attribution NonCommercial.",
        " Creative Commons Attribution ShareAlike.",
        " Creative Commons Attribution NonCommercial ShareAlike.",
        " Creative Commons Attribution NoDerivatives.",
        " Creative Commons Attribution NonCommercial NoDerivatives.",
        " Creative Commons public-domain dedication.",
        " Public domain.",
        " Text and data mining manuscript terms.",
        " The bucket reports another license."
      ],
      "x-extensible-enum": [
        "cc_by",
        "cc_by_nc",
        "cc_by_sa",
        "cc_by_nc_sa",
        "cc_by_nd",
        "cc_by_nc_nd",
        "cc0",
        "public_domain",
        "tdm",
        "other"
      ]
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_Pmcid": {
      "description": "Canonical PMC identifier, with an explicit namespace.",
      "pattern": "^PMC(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "Reply_Section_SupplementContent": {
      "description": "A requested section has exactly one state.",
      "oneOf": [
        {
          "description": "The source returned data.",
          "properties": {
            "data": {
              "$ref": "#/$defs/Reply_SupplementContent",
              "description": "Whole section data."
            },
            "source": {
              "$ref": "#/$defs/Reply_Source",
              "description": "Source identity."
            },
            "state": {
              "const": "data",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "data"
          ],
          "type": "object"
        },
        {
          "description": "The source answered with no data.",
          "properties": {
            "record": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Reply_SourceRecord"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native entry, if any."
            },
            "source": {
              "$ref": "#/$defs/Reply_Source",
              "description": "Source identity."
            },
            "state": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source"
          ],
          "type": "object"
        },
        {
          "description": "A requested source failed.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reply_Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Reply_Source",
              "description": "Source identity."
            },
            "state": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "User settings prevented the source request.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reply_Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Reply_Source",
              "description": "Source identity."
            },
            "state": {
              "const": "skipped",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "Entity facts rule this section out.",
          "properties": {
            "state": {
              "const": "not-applicable",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "Reply_SheetInfo": {
      "description": "Source sheet with its maximum original row number.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Sheet name."
        },
        "rows": {
          "description": "Last original row number, preserving gaps.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "rows"
      ],
      "type": "object"
    },
    "Reply_SheetRow": {
      "description": "One original sparse row with its numbered first source row.",
      "properties": {
        "cells": {
          "description": "This row's cells, including empty cells before populated columns.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "first_row": {
          "$ref": "#/$defs/Reply_FirstSheetRow",
          "description": "First original row, including empty cells; never inferred column headings."
        },
        "fragment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_CellFragment"
            },
            {
              "type": "null"
            }
          ],
          "description": "Sparse source cell fragment when the complete row exceeds the output bound."
        },
        "row": {
          "description": "Original one-based row number.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sheet": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Original sheet name."
        }
      },
      "required": [
        "sheet",
        "row",
        "first_row"
      ],
      "type": "object"
    },
    "Reply_SheetRows": {
      "description": "Inclusive original one-based row range. The parser additionally requires the end to be at least the start and fewer than 200 rows after it.",
      "pattern": "^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})-(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
