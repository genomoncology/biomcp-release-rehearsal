{
  "$defs": {
    "Reply_Attribution": {
      "description": "Provenance for one source record.",
      "properties": {
        "approved": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source approval date."
        },
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "published": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source publication date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_ComponentLabel": {
      "description": "Terms attached to a named carried component on a consumer response.",
      "properties": {
        "component": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Native component name."
        },
        "terms": {
          "$ref": "#/$defs/Reply_ComponentTerms",
          "description": "Canonical publisher terms."
        }
      },
      "required": [
        "component",
        "terms"
      ],
      "type": "object"
    },
    "Reply_ComponentTerms": {
      "description": "Terms attached to one independently licensed source component.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Publisher terms name."
        },
        "url": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Publisher terms page.",
          "format": "uri"
        },
        "usage": {
          "$ref": "#/$defs/Reply_Use",
          "description": "Publisher use category."
        }
      },
      "required": [
        "usage",
        "name",
        "url"
      ],
      "type": "object"
    },
    "Reply_Curie": {
      "description": "Checked prefix:local ontology identifier.",
      "pattern": "^[A-Za-z0-9_.-]+:[^:/\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f][^:\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f]*$",
      "type": "string"
    },
    "Reply_DiseaseCard": {
      "description": "Exact identity and available pages without hidden enrichment.",
      "properties": {
        "alias": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_DiseaseRelation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native relation proving a source-accepted alternate identifier."
        },
        "attribution": {
          "$ref": "#/$defs/Reply_Attribution",
          "description": "Publisher record and version."
        },
        "components": {
          "description": "Applicable component terms.",
          "items": {
            "$ref": "#/$defs/Reply_ComponentLabel"
          },
          "type": "array"
        },
        "concept": {
          "$ref": "#/$defs/Reply_DiseaseConcept",
          "description": "Native identity and complete primary label."
        },
        "consider": {
          "description": "Publisher alternatives, never an automatic replacement.",
          "items": {
            "$ref": "#/$defs/Reply_Curie"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "definition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Complete source definition when supplied."
        },
        "obsolete": {
          "description": "Publisher obsolete flag.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "replaced_by": {
          "description": "Publisher explicit replacement identifiers; null preserves no native replacement.",
          "items": {
            "$ref": "#/$defs/Reply_Curie"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "requested_id": {
          "$ref": "#/$defs/Reply_Curie",
          "description": "Exact requested identifier."
        },
        "returned_id": {
          "$ref": "#/$defs/Reply_Curie",
          "description": "Actual returned identifier."
        },
        "sections": {
          "description": "Available named sections.",
          "items": {
            "$ref": "#/$defs/Reply_DiseaseSection"
          },
          "type": "array"
        }
      },
      "required": [
        "requested_id",
        "returned_id",
        "concept",
        "attribution"
      ],
      "type": "object"
    },
    "Reply_DiseaseConcept": {
      "description": "A disease identity whose optional display label never determines record admission.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Curie"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-stated exact identifier."
        },
        "label": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Native display label when supplied and valid."
        }
      },
      "type": "object"
    },
    "Reply_DiseaseEndpoint": {
      "description": "One native endpoint with an identifier and an optional source label.\nNative associations use this reference because a source may omit a display label.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_Curie",
          "description": "Exact source identifier."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source label when supplied."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Reply_DiseaseGet": {
      "description": "Exact concept or native SEER site with independently paged section.",
      "properties": {
        "age_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native age-range code."
        },
        "dataset": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Requested native dataset selector, not proof of returned membership."
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Exact ontology CURIE or an explicit SEER catalog site ID.",
          "x-positional": 0
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Survival-only interval code."
        },
        "ontology": {
          "$ref": "#/$defs/Reply_DiseaseOntology",
          "default": "mondo",
          "description": "One OLS ontology."
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Incidence-only native period code."
        },
        "race": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native race code."
        },
        "section": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_DiseaseSection"
            },
            {
              "type": "null"
            }
          ],
          "description": "One named section; absent means identity card only.",
          "x-positional": 1
        },
        "section_limit": {
          "description": "Native rows per page: default 2 for Monarch genes, 1 for Monarch phenotypes, otherwise 5.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "section_offset": {
          "default": 0,
          "description": "Native row offset within the selected section.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sex": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native sex code."
        },
        "source": {
          "$ref": "#/$defs/Reply_DiseaseSource",
          "default": "mydisease",
          "description": "Default MyDisease; no automatic fallback."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Reply_DiseaseOntology": {
      "description": "One explicit OLS ontology.",
      "enum": [
        "mondo",
        "doid",
        "ncit"
      ],
      "type": "string"
    },
    "Reply_DiseaseRelation": {
      "description": "A publisher relation with distinct endpoints and predicate.",
      "properties": {
        "attribution": {
          "$ref": "#/$defs/Reply_Attribution",
          "description": "Publisher record and version."
        },
        "description": {
          "description": "Unchanged native cross-reference description when supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "object": {
          "$ref": "#/$defs/Reply_DiseaseEndpoint",
          "description": "Native object."
        },
        "predicate": {
          "$ref": "#/$defs/Reply_Curie",
          "description": "Publisher predicate, without equivalence promotion."
        },
        "subject": {
          "$ref": "#/$defs/Reply_DiseaseEndpoint",
          "description": "Native subject."
        }
      },
      "required": [
        "subject",
        "predicate",
        "object",
        "attribution"
      ],
      "type": "object"
    },
    "Reply_DiseaseSection": {
      "description": "One named disease page.",
      "enum": [
        "synonyms",
        "xrefs",
        "hierarchy",
        "genes",
        "phenotypes",
        "incidence",
        "survival"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Publisher scoped synonyms.",
        " Native cross references.",
        " Native parent relations.",
        " Native gene association rows.",
        " Native phenotype association rows.",
        " Native stage incidence rows.",
        " Annual survival rows."
      ]
    },
    "Reply_DiseaseSource": {
      "description": "An explicit disease source without fallback.",
      "enum": [
        "ols",
        "mydisease",
        "monarch",
        "seer"
      ],
      "type": "string"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
