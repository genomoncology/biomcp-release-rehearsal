{
  "$defs": {
    "ArticleInput": {
      "description": "A validated canonical ArticleInput string.",
      "pattern": "(^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$|^PMC(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$|(?=PPR)^(?=.{1,64}$)[A-Z]{1,8}[0-9]*[1-9][0-9]*$|^(?:https?://doi\\.org/)?10\\.[0-9]+/[^\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f]+$)",
      "type": "string"
    },
    "Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    }
  },
  "$id": "biomcp.article-evidence/3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Read every source context and optional explicit full-text citation paragraph.",
  "properties": {
    "cited": {
      "$ref": "#/$defs/ArticleInput",
      "description": "Cited PMID, PMC identity or DOI.",
      "x-positional": 1
    },
    "citing": {
      "$ref": "#/$defs/ArticleInput",
      "description": "Citing PMID, PMC identity or DOI.",
      "x-positional": 0
    },
    "fulltext": {
      "description": "Include the citing paper's own explicit reference paragraphs.",
      "type": "boolean"
    },
    "offset": {
      "default": 0,
      "description": "Context fragment position returned by the advancing step.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "paragraph_offset": {
      "default": 0,
      "description": "Full-text fragment position returned by the advancing step.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "pool": {
      "$ref": "#/$defs/Text",
      "description": "Stored checked source scan and original hit positions."
    }
  },
  "required": [
    "citing",
    "cited"
  ],
  "title": "ArticleEvidence",
  "type": "object"
}
