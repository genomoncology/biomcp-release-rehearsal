{
  "$defs": {
    "PhenotypeSource": {
      "description": "One independent term publisher.",
      "enum": [
        "hpo",
        "monarch"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Direct HPO term metadata.",
        " Monarch term search and associations."
      ]
    }
  },
  "$id": "biomcp.phenotype-search-query/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Search literal human HP term candidates through Monarch with bounded native pages. A term lookup answers terminology and does not establish a diagnosis.",
  "properties": {
    "limit": {
      "default": 5,
      "description": "Maximum native headers, default five.",
      "format": "uint32",
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "description": "Native source row offset.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/PhenotypeSource",
      "default": "monarch",
      "description": "Monarch only; HPO search is unsupported; help search phenotype\nMonarch only; HPO search is unsupported."
    },
    "text": {
      "description": "Unchanged literal term search text.",
      "minLength": 1,
      "type": "string",
      "x-positional": 0
    }
  },
  "required": [
    "text"
  ],
  "title": "PhenotypeSearch",
  "type": "object"
}
