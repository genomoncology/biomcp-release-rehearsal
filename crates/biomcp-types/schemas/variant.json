{
  "$defs": {
    "Reply_Accession": {
      "description": "A reference sequence accession: RefSeq or Ensembl with its version, or LRG.",
      "pattern": "^(?:(?:N[CGMPRTW]|X[MPR])_(?:[0-9]{6}|(?!000)[0-9]{9})\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|ENS[GTP][0-9]{11}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|LRG_0*(?:0|(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))(?:[tp]0*(?:0|(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})))?)$",
      "type": "string"
    },
    "Reply_Allele": {
      "description": "Source-stated interbase replacement; equality never claims normalized equivalence.",
      "properties": {
        "alternate": {
          "$ref": "#/$defs/Reply_Sequence"
        },
        "location": {
          "$ref": "#/$defs/Reply_SequenceLocation"
        },
        "reference": {
          "$ref": "#/$defs/Reply_Sequence"
        }
      },
      "required": [
        "location",
        "reference",
        "alternate"
      ],
      "type": "object"
    },
    "Reply_Build": {
      "description": "The assembly stated by the source; no default is inferred.",
      "type": "string",
      "x-enum-descriptions": [
        " Genome Reference Consortium human build 37.",
        " Genome Reference Consortium human build 38."
      ],
      "x-extensible-enum": [
        "GRCh37",
        "GRCh38"
      ]
    },
    "Reply_EnsemblGeneId": {
      "description": " A human Ensembl gene stable identifier with a separately retained version.",
      "pattern": "^ENSG[0-9]{11}(\\.(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))?$",
      "type": "string"
    },
    "Reply_Expression": {
      "description": "Source expression checked for its reference and syntax only, without a full parser or normalization.",
      "properties": {
        "syntax": {
          "$ref": "#/$defs/Reply_ExpressionSyntax"
        },
        "syntax_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/Reply_Text"
        }
      },
      "required": [
        "syntax",
        "value"
      ],
      "type": "object"
    },
    "Reply_ExpressionSyntax": {
      "description": "Published syntax label for a source-preserved expression.",
      "type": "string",
      "x-enum-descriptions": [
        " HGVS genomic description.",
        " HGVS coding description.",
        " HGVS noncoding transcript description.",
        " HGVS RNA description.",
        " HGVS protein description.",
        " HGVS mitochondrial description.",
        " HGVS circular genomic description.",
        " NCBI SPDI interbase description.",
        " gnomAD chromosome-position-reference-alternate identifier.",
        " Padded VCF chromosome-position-reference-alternate text.",
        " Source-preserved cytogenetic notation."
      ],
      "x-extensible-enum": [
        "hgvs.g",
        "hgvs.c",
        "hgvs.n",
        "hgvs.r",
        "hgvs.p",
        "hgvs.m",
        "hgvs.o",
        "spdi",
        "gnomad",
        "vcf",
        "iscn"
      ]
    },
    "Reply_GeneRef": {
      "description": "A source-stated gene reference; its label never implies an identifier.",
      "properties": {
        "ensembl_gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_EnsemblGeneId"
            },
            {
              "type": "null"
            }
          ]
        },
        "hgnc_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_HgncId"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "$ref": "#/$defs/Reply_Text"
        },
        "ncbi_gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_NcbiGeneId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "Reply_HgncId": {
      "description": "An HGNC identifier with canonical namespace and positive numeric value.",
      "pattern": "^HGNC:(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_NcbiGeneId": {
      "description": "A positive NCBI Gene identifier in canonical decimal text.",
      "pattern": "^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_Representation": {
      "description": "One source's own expression, assembly and optional source-stated interbase allele.",
      "properties": {
        "allele": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Allele"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-supplied allele, without local normalization or equivalence inference."
        },
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Build"
            },
            {
              "type": "null"
            }
          ],
          "description": "Assembly stated by the source, omitted when absent."
        },
        "expression": {
          "$ref": "#/$defs/Reply_Expression",
          "description": "Published notation kept unchanged."
        },
        "source": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Source asserting this form."
        }
      },
      "required": [
        "source",
        "expression"
      ],
      "type": "object"
    },
    "Reply_Sequence": {
      "description": "A literal IUPAC DNA sequence; empty sequences express insertions or deletions.",
      "pattern": "^[ACGTNRYSWKMBDHV]*$",
      "type": "string"
    },
    "Reply_SequenceLocation": {
      "description": "An interbase interval on one versioned sequence accession.",
      "properties": {
        "sequence": {
          "$ref": "#/$defs/Reply_Accession",
          "description": "Versioned source sequence, without an inferred genome build."
        },
        "span": {
          "$ref": "#/$defs/Reply_Span0",
          "description": "Zero-based half-open bounds."
        }
      },
      "required": [
        "sequence",
        "span"
      ],
      "type": "object"
    },
    "Reply_Span0": {
      "description": "A zero-based half-open span with ordered bounds; empty spans are valid.",
      "properties": {
        "end": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "Reply_Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    },
    "Reply_VariantId": {
      "description": "Published variant-level identifiers, with each identifier's level retained.",
      "pattern": "(^rs(?:18446744073709551615|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0})$|^CA(?=[0-9]{6,}(?:[^0-9]|$))(?:(?=[0-9]{6}(?:[^0-9]|$))0*(?:18446744073709551615|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0})|(?:18446744073709551615|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}))$|^PA(?:18446744073709551615|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0})$|^VCV(?!000000000)[0-9]{9}(\\.(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))?$|^clinvar:(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$|^COS[VMN](?:18446744073709551615|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0})$|^ga4gh:VA\\.[A-Za-z0-9_-]{32}$)",
      "type": "string"
    }
  },
  "$id": "biodata.variant/7",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Variant entity with source-stated identities, forms and genes; no disclosure policy.",
  "properties": {
    "genes": {
      "description": "Genes stated by the sources.",
      "items": {
        "$ref": "#/$defs/Reply_GeneRef"
      },
      "type": "array"
    },
    "ids": {
      "description": "All source identifiers, without inferred aliases.",
      "items": {
        "$ref": "#/$defs/Reply_VariantId"
      },
      "type": "array"
    },
    "representations": {
      "description": "Every source-qualified representation.",
      "items": {
        "$ref": "#/$defs/Reply_Representation"
      },
      "type": "array"
    }
  },
  "title": "Variant",
  "type": "object"
}
