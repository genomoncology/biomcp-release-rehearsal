{
  "$defs": {
    "Reply_Attribution": {
      "description": "Provenance for one source record.",
      "properties": {
        "approved": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source approval date."
        },
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "published": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source publication date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_CivicClaimKind": {
      "description": "CIViC native claim collection.",
      "enum": [
        "evidence",
        "assertions"
      ],
      "type": "string"
    },
    "Reply_DrugGet": {
      "description": "A source-selected drug request echoed with a native ID after name resolution.",
      "properties": {
        "civic_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native continuation cursor for that exact drug, profile and claim collection."
        },
        "civic_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_CivicClaimKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "Independent native evidence or assertion collection within the selected profile."
        },
        "civic_profile": {
          "description": "Selected native CIViC molecular profile for a drug-scoped claim stream.",
          "format": "uint64",
          "maximum": 2147483647,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "input": {
          "$ref": "#/$defs/Reply_DrugId"
        },
        "label_section": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact published openFDA SPL section field, including table fields; required for the label section."
        },
        "product_number": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit native application product number, only for approvals."
        },
        "section": {
          "description": "Explicit named disclosures; empty means identity only.",
          "items": {
            "$ref": "#/$defs/Reply_DrugSection"
          },
          "type": "array",
          "x-positional": 1
        },
        "section_limit": {
          "description": "Named section page size, refused on an identity-only card.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "section_offset": {
          "description": "Named section continuation, refused on an identity-only card.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/Reply_DrugSource"
        }
      },
      "required": [
        "input",
        "source"
      ],
      "type": "object"
    },
    "Reply_DrugHeader": {
      "description": "One source candidate, without authorization, targets, label text or interactions.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_DrugId",
          "description": "Published native identifier."
        },
        "identity_level": {
          "$ref": "#/$defs/Reply_DrugIdentityLevel",
          "description": "Level established only by the endpoint or record type."
        },
        "matched_name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_DrugNameMatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "Complete native name fields matching the search input; omitted outside label searches."
        },
        "name": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Original source display name."
        },
        "name_resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_DrugNameResolution"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact name choice, ranking rule and bounded alternative commands; omitted for native ID calls."
        },
        "source": {
          "$ref": "#/$defs/Reply_DrugSource",
          "description": "The single source responsible for this header."
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native record type."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record URL.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native source revision, omitted when the source supplies none."
        }
      },
      "required": [
        "id",
        "source",
        "identity_level"
      ],
      "type": "object"
    },
    "Reply_DrugId": {
      "description": "A published native drug record identifier, without a consumer source prefix.",
      "pattern": "^(?:[A-Z][A-Z0-9_.-]*:)?[A-Za-z0-9][A-Za-z0-9_.-]*(/[A-Za-z0-9_.-]+)*$",
      "type": "string"
    },
    "Reply_DrugIdentityLevel": {
      "description": "Identity level established by the source endpoint or record type, never inferred from ID shape.",
      "type": "string",
      "x-enum-descriptions": [
        " Source-stated ingredient identity.",
        " Source-stated salt identity.",
        " Source-stated clinical formulation identity.",
        " Source-stated branded product identity.",
        " Source-stated spl set identity.",
        " Source-stated spl version identity.",
        " Source-stated ndc package identity.",
        " Source-stated fda application identity.",
        " Source-stated fda product identity.",
        " Source-stated ema authorization identity.",
        " Source-stated ema application identity.",
        " Source-stated orphan designation identity.",
        " Source-stated unknown identity."
      ],
      "x-extensible-enum": [
        "ingredient",
        "salt",
        "clinical_formulation",
        "branded_product",
        "spl_set",
        "spl_version",
        "ndc_package",
        "fda_application",
        "fda_product",
        "ema_authorization",
        "ema_application",
        "orphan_designation",
        "unknown"
      ]
    },
    "Reply_DrugLabel": {
      "description": "One explicit native label heading and text continuation.",
      "properties": {
        "identity": {
          "$ref": "#/$defs/Reply_DrugHeader",
          "description": "Selected native identity, checked independently of section facts."
        },
        "label": {
          "$ref": "#/$defs/Reply_Section_DrugLabelText",
          "description": "Existing typed section state, preserving empty, unavailable and skipped outcomes."
        }
      },
      "required": [
        "identity",
        "label"
      ],
      "type": "object"
    },
    "Reply_DrugLabelFragment": {
      "description": "One slice of a native label array element, partitioning the page's unchanged text.",
      "properties": {
        "characters": {
          "description": "Consecutive Unicode scalars consumed from the page text for this fragment.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source_offset": {
          "description": "Unicode scalar offset inside that original array element.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source_part": {
          "description": "Zero-based native array element; empty elements have a zero-character fragment.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "source_part",
        "source_offset",
        "characters"
      ],
      "type": "object"
    },
    "Reply_DrugLabelReference": {
      "description": "One independently identified label set and revision.",
      "properties": {
        "attribution": {
          "$ref": "#/$defs/Reply_Attribution",
          "description": "Label provenance."
        },
        "id": {
          "$ref": "#/$defs/Reply_DrugId",
          "description": "Published SPL set or native label record ID."
        },
        "revised": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-stated revision date."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native label URL.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native label revision."
        }
      },
      "required": [
        "id",
        "attribution"
      ],
      "type": "object"
    },
    "Reply_DrugLabelText": {
      "description": "A mechanical continuation of one native label heading.",
      "properties": {
        "fragments": {
          "description": "Native array boundaries; consume the flat text in this order without separators.",
          "items": {
            "$ref": "#/$defs/Reply_DrugLabelFragment"
          },
          "type": "array"
        },
        "heading": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Exact native label heading."
        },
        "label": {
          "$ref": "#/$defs/Reply_DrugLabelReference",
          "description": "Exact source label set and revision."
        },
        "offset": {
          "description": "Zero-based bounded text fragment offset; section_limit is a maximum fragment count.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "retrieved": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Original source reply retrieval date; absent for legacy captures without a timestamp."
        },
        "text": {
          "description": "Original text slice, preserving whitespace and wording.",
          "type": "string"
        },
        "total": {
          "description": "Total bounded text fragments, including fragments for empty native array elements.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "label",
        "heading",
        "text",
        "offset"
      ],
      "type": "object"
    },
    "Reply_DrugNameMatch": {
      "description": "Complete native name fields matching the requested label name.",
      "type": "string",
      "x-enum-descriptions": [
        " The complete brand name matches.",
        " The complete generic name matches.",
        " Both complete name fields match."
      ],
      "x-extensible-enum": [
        "brand",
        "generic",
        "both"
      ]
    },
    "Reply_DrugNameResolution": {
      "description": "Exact source name choice; brand before generic, original FDA application then earliest approval, otherwise source order.",
      "properties": {
        "alternatives": {
          "description": "Up to five other exact records as ready get commands.",
          "items": {
            "$ref": "#/$defs/Reply_Step"
          },
          "type": "array"
        },
        "basis": {
          "$ref": "#/$defs/Reply_DrugNameMatch",
          "description": "Name basis selected after demoting a brand identical to its own ingredient."
        },
        "input": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Original complete name matched case-insensitively."
        },
        "ranking": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Applied ambiguity ordering, emitted only from fixed nonempty rule text."
        },
        "total": {
          "description": "Total exact source records, including the selected record.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "input",
        "basis",
        "ranking",
        "total"
      ],
      "type": "object"
    },
    "Reply_DrugSection": {
      "description": "Explicit drug disclosures; identity cards never expand into these sections.",
      "type": "string",
      "x-enum-descriptions": [
        " All native identity cross-references and product links, mechanically paged.",
        " Native target and mechanism relations.",
        " Native indication wording.",
        " Native CIViC therapy evidence and profile context.",
        " One exact native label heading.",
        " Native application and product history rows.",
        " Source-scoped regulator events.",
        " Native DDInter partner rows and levels; five rows per default page, with explicit section limits preserved."
      ],
      "x-extensible-enum": [
        "xrefs",
        "targets",
        "indications",
        "civic",
        "label",
        "approvals",
        "regulatory",
        "interactions"
      ]
    },
    "Reply_DrugSource": {
      "description": "A supported drug data source.",
      "type": "string",
      "x-extensible-enum": [
        "who-pq",
        "fda-drug-recall",
        "mychem",
        "chembl",
        "opentargets",
        "civic",
        "openfda-label",
        "drugsfda",
        "ema",
        "ddinter"
      ]
    },
    "Reply_IdentifierNamespace": {
      "description": "A source-stated authority or an explicit unknown authority, represented by the string unknown.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "Reply_Section_DrugLabelText": {
      "description": "A requested section has exactly one state.",
      "oneOf": [
        {
          "description": "The source returned data.",
          "properties": {
            "data": {
              "$ref": "#/$defs/Reply_DrugLabelText",
              "description": "Whole section data."
            },
            "source": {
              "$ref": "#/$defs/Reply_Source",
              "description": "Source identity."
            },
            "state": {
              "const": "data",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "data"
          ],
          "type": "object"
        },
        {
          "description": "The source answered with no data.",
          "properties": {
            "record": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Reply_SourceRecord"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native entry, if any."
            },
            "source": {
              "$ref": "#/$defs/Reply_Source",
              "description": "Source identity."
            },
            "state": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source"
          ],
          "type": "object"
        },
        {
          "description": "A requested source failed.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reply_Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Reply_Source",
              "description": "Source identity."
            },
            "state": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "User settings prevented the source request.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reply_Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Reply_Source",
              "description": "Source identity."
            },
            "state": {
              "const": "skipped",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "Entity facts rule this section out.",
          "properties": {
            "state": {
              "const": "not-applicable",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "Reply_Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " WikiPathways published pathway catalogs.",
        " Human Protein Atlas.",
        " UniProt.",
        " Integrated InterPro entries.",
        " Complex Portal.",
        " gnomAD.",
        " ClinVar component source policy.",
        " ClinGen Evidence Repository.",
        " GWAS Catalog v2.",
        " ClinGen.",
        " GenCC submitter assessments.",
        " PubMed.",
        " Europe PMC.",
        " NCBI LitVar2.",
        " NCBI LitSense2.",
        " Semantic Scholar.",
        " ORCID public registry.",
        " PMC Open Access bucket.",
        " NIH iCite.",
        " PubTator.",
        " ClinicalTrials.gov.",
        " NCI Clinical Trials Search.",
        " CIViC.",
        " Cancer Hotspots residue recurrence.",
        " AlphaGenome.",
        " OncoKB.",
        " MyVariant.info aggregation.",
        " ClinGen Allele Registry.",
        " Mutalyzer.",
        " VariantValidator.",
        " MyChem.info aggregation.",
        " ChEMBL native records and carried component.",
        " Open Targets.",
        " openFDA SPL labels.",
        " Drugs@FDA application records.",
        " European Medicines Agency.",
        " WHO finished pharmaceutical products.",
        " DDInter interaction records.",
        " MyChem DrugBank Open identity subset only.",
        " MyChem DrugCentral component.",
        " MyChem Guide to Pharmacology component.",
        " MyChem UNII identities.",
        " MyChem NDC package identities.",
        " MyChem openFDA cross-references only.",
        " Ontology Lookup Service.",
