        "fda-device-recall",
        "fda-drug-recall",
        "cpic",
        "clinpgx",
        "cbioportal",
        "cellosaurus"
      ]
    },
    "Reply_SourceNotice": {
      "description": "A source notice or request recovery step.",
      "oneOf": [
        {
          "description": "Local request limits and source-specific recovery guidance.",
          "properties": {
            "kind": {
              "const": "request-guidance",
              "type": "string"
            },
            "message": {
              "description": "Reviewed guidance without provider response text.",
              "type": "string"
            },
            "retry_after_seconds": {
              "description": "Seconds left before another source request may be admitted.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "Registered conditions lack the literal words requested in a condition search.",
          "properties": {
            "kind": {
              "const": "condition-word-mismatch",
              "type": "string"
            },
            "message": {
              "description": "The source searches several fields and can expand terms; no expansion cause is inferred.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "A checked provider answer survived a local cache failure.",
          "properties": {
            "kind": {
              "const": "cache-problem",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/Reply_CacheProblem",
              "description": "Bounded local failure without paths or database diagnostics."
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The source still has graph pages after the bounded fetch window.",
          "properties": {
            "fallback": {
              "$ref": "#/$defs/Reply_Text",
              "description": "Default-source command offering another graph view."
            },
            "kind": {
              "const": "graph-truncated",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "fallback"
          ],
          "type": "object"
        },
        {
          "description": "An empty LitVar lookup can be repeated with a caller-supplied rsID.",
          "properties": {
            "kind": {
              "const": "litvar-rsid-hint",
              "type": "string"
            },
            "message": {
              "description": "Guidance that never supplies or infers an rsID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "PubMed supplied a named ESearch warning without changing its phrases.",
          "properties": {
            "kind": {
              "const": "pubmed-warning",
              "type": "string"
            },
            "name": {
              "description": "Original provider warning name, including names added by PubMed later.",
              "type": "string"
            },
            "phrases": {
              "description": "Original provider phrases, preserving whitespace and quotes.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "PubMed did not index these words.",
          "properties": {
            "kind": {
              "const": "not-found-words",
              "type": "string"
            },
            "words": {
              "description": "Whole source words.",
              "items": {
                "$ref": "#/$defs/Reply_Text"
              },
              "type": "array"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Reply_SourceOutcome": {
      "description": "One source's outcome, without provider text.",
      "properties": {
        "count": {
          "description": "Provider matching count.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "notices": {
          "description": "Source notices and request recovery guidance.",
          "items": {
            "$ref": "#/$defs/Reply_SourceNotice"
          },
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Failure or stale-fallback reason."
        },
        "retrieved_count": {
          "description": "Number of retrieved identities.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "Asked source."
        },
        "state": {
          "$ref": "#/$defs/Reply_SourceState",
          "description": "Retained state."
        },
        "term": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact provider search term."
        },
        "terms": {
          "description": "Publisher terms name from the source registry.",
          "type": "string"
        },
        "terms_url": {
          "description": "Publisher page documenting the terms.",
          "format": "uri",
          "type": "string"
        },
        "use": {
          "$ref": "#/$defs/Reply_Use",
          "description": "Reviewed source use category; publisher terms remain authoritative."
        }
      },
      "required": [
        "source",
        "use",
        "terms",
        "terms_url",
        "state"
      ],
      "type": "object"
    },
    "Reply_SourceRecord": {
      "description": "The source's own entry for an entity.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Native source identifier."
        },
        "namespace": {
          "$ref": "#/$defs/Reply_IdentifierNamespace",
          "description": "Native authority; unknown means the source did not state one."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Link to that entry.",
          "format": "uri"
        }
      },
      "required": [
        "namespace",
        "id"
      ],
      "type": "object",
      "x-identifier": true
    },
    "Reply_SourceState": {
      "description": "State of a source actually asked by the command.",
      "enum": [
        "ok",
        "stale",
        "syncing",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "Reply_Status": {
      "description": "Overall command outcome.",
      "enum": [
        "complete",
        "partial",
        "absent",
        "failed"
      ],
      "type": "string"
    },
    "Reply_Step": {
      "description": "A command argument list spelled from a typed action.",
      "properties": {
        "args": {
          "description": "CLI and MCP arguments.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/Reply_StepKind",
          "description": "Purpose of the action."
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "Reply_StepKind": {
      "description": "Purpose of an available next command.",
      "enum": [
        "restart",
        "section",
        "sort",
        "page",
        "fresh",
        "disambiguate",
        "pivot",
        "sync",
        "key",
        "configure"
      ],
      "type": "string"
    },
    "Reply_Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    },
    "Reply_TrialDocument": {
      "description": "A posted source document; a URL never comes from caller-supplied filename text.",
      "properties": {
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source document date."
        },
        "filename": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Exact advertised portable source filename."
        },
        "has_icf": {
          "description": "Source says this contains an informed consent form.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "has_protocol": {
          "description": "Source says this contains a protocol.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "has_sap": {
          "description": "Source says this contains a statistical analysis plan.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "kind": {
          "description": "Native document type abbreviation.",
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "description": "Source label.",
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "$ref": "#/$defs/Reply_License",
          "description": "No blanket reuse license is inferred from registry availability."
        },
        "size": {
          "description": "Source byte count, when supplied.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "uploaded": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_TrialUploadTime"
            },
            {
              "type": "null"
            }
          ],
          "description": "Original upload timestamp, without guessing a timezone."
        },
        "url": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Fixed registry CDN URL for this manifest entry.",
          "format": "uri"
        }
      },
      "required": [
        "filename",
        "url",
        "license"
      ],
      "type": "object"
    },
    "Reply_TrialDocumentGet": {
      "description": "Download one exact ClinicalTrials.gov manifest PDF to an explicit caller path; never read its text. CLI and stdio MCP support saves; HTTP refuses with the source URL.",
      "properties": {
        "file": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Exact filename from the registry manifest; never a URL or inferred path.",
          "x-positional": 1
        },
        "input": {
          "$ref": "#/$defs/Reply_NctId",
          "description": "Exact registry identity.",
          "x-positional": 0
        },
        "replace": {
          "description": "Replace an existing file only when explicitly requested.",
          "type": "boolean"
        },
        "save": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Caller-owned file or existing folder."
        }
      },
      "required": [
        "input",
        "file",
        "save"
      ],
      "type": "object"
    },
    "Reply_TrialDocumentResult": {
      "description": "Original trial PDF download, never document text.",
      "properties": {
        "file": {
          "$ref": "#/$defs/Reply_Section_TrialDocumentSaved",
          "description": "Saved receipt, confirmed absence, or a source failure."
        }
      },
      "required": [
        "file"
      ],
      "type": "object"
    },
