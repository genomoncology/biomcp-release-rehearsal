{
  "$defs": {
    "Reply_AdverseEventFaersCard": {
      "description": "FAERS card with native report-level facts and independent collection lengths.",
      "properties": {
        "available_sections": {
          "description": "Named sections available in this report.",
          "items": {
            "$ref": "#/$defs/Reply_AdverseEventSection"
          },
          "type": "array"
        },
        "components": {
          "description": "Applicable component terms.",
          "items": {
            "$ref": "#/$defs/Reply_ComponentLabel"
          },
          "type": "array"
        },
        "drug_count": {
          "description": "Actual drug-array length, never count bucket.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "first_received_format": {
          "description": "Native first_received_format string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "header": {
          "$ref": "#/$defs/Reply_AdverseEventHeader",
          "description": "Exact selected report identity."
        },
        "latest_received": {
          "description": "Native latest_received string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "latest_received_format": {
          "description": "Native latest_received_format string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "patient": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_AdverseEventPatient"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fixed native patient strings."
        },
        "reaction_count": {
          "description": "Actual reaction-array length, never causal pairs.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "report_url": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Exact successful source request URL, never guessed.",
          "format": "uri"
        },
        "reporter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_AdverseEventReporter"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional reporter facts."
        },
        "seriousness": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_FaersSeriousness"
            },
            {
              "type": "null"
            }
          ],
          "description": "Independent source report flags."
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Opaque checked retained-report snapshot identity."
        },
        "source_url": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Publisher overview, never a next step.",
          "format": "uri"
        },
        "transmitted": {
          "description": "Native transmitted string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "transmitted_format": {
          "description": "Native transmitted_format string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "header",
        "drug_count",
        "reaction_count",
        "source_url",
        "report_url"
      ],
      "type": "object"
    },
    "Reply_AdverseEventGet": {
      "description": "Exact native report identity and an optional independently paged section.",
      "properties": {
        "drug_index": {
          "description": "Absolute source-array index; required only for identifier sections.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/Reply_ReportId",
          "description": "Published report ID with no source prefix.",
          "x-positional": 0
        },
        "section": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_AdverseEventSection"
            },
            {
              "type": "null"
            }
          ],
          "description": "FAERS owns drugs, reactions and identifiers; MAUDE owns devices and narrative. Omitted means card only.",
          "x-positional": 1
        },
        "section_limit": {
          "default": 5,
          "description": "Whole source rows per section page.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "section_offset": {
          "default": 0,
          "description": "Offset within the selected native section.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Checked retained report snapshot for provider-free continuation."
        },
        "source": {
          "default": "faers",
          "description": "FAERS by default; MAUDE is explicit.",
          "enum": [
            "faers",
            "maude"
          ],
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Reply_AdverseEventHeader": {
      "description": "Small source report header without a drug title, flattened lists or count buckets.",
      "properties": {
        "event_type": {
          "description": "Native event_type string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "first_received": {
          "description": "Native first_received string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/Reply_ReportId",
          "description": "Exact published source identity."
        },
        "serious": {
          "description": "Native serious string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/Reply_AdverseEventSource",
          "description": "Explicit report family."
        },
        "version": {
          "description": "Native version string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "source"
      ],
      "type": "object"
    },
    "Reply_AdverseEventPatient": {
      "description": "Native patient facts with the published word beside the sex code.",
      "properties": {
        "age": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_WithUnit_FiniteNumber_FaersAgeUnit"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native numeric age with the exact publisher unit code, when stated."
        },
        "sex": {
          "description": "Native sex string, including a present empty value.",
          "type": [
            "string",
            "null"
          ]
        },
        "sex_label": {
          "description": "Published word for the sex code, when the code is on openFDA's list.",
          "type": [
            "string",
            "null"
          ]
        },
        "weight": {
          "description": "Native weight string, including a present empty value.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Reply_AdverseEventReporter": {
      "description": "Native reporter facts with the published word beside the qualification code.",
      "properties": {
        "country": {
          "description": "Native country string, including a present empty value.",
          "type": [
            "string",
            "null"
          ]
        },
        "qualification": {
          "description": "Native qualification string, including a present empty value.",
          "type": [
            "string",
            "null"
          ]
        },
        "qualification_label": {
          "description": "Published word for the qualification code, when the code is on openFDA's list.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Reply_AdverseEventSection": {
      "description": "One source-owned section; no all or reporter section.",
      "enum": [
        "drugs",
        "reactions",
        "unii",
        "rxcui",
        "product-ndc",
        "package-ndc",
        "spl-id",
        "spl-set-id",
        "application-number",
        "devices",
        "narrative"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Independent native drug rows.",
        " Independent native reaction rows.",
        " Native UNII strings.",
        " Native RxCUI strings.",
        " Native product NDC strings.",
        " Native package NDC strings.",
        " Native SPL IDs.",
        " Native SPL set IDs.",
        " Native application numbers.",
        " Native device rows.",
        " Complete native narrative rows."
      ]
    },
    "Reply_AdverseEventSource": {
      "description": "An explicit source; never probe the other family.",
      "enum": [
        "faers",
        "maude",
        "vaers"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Drug event reports.",
        " Device event reports.",
        " Explicit CDC WONDER vaccine aggregate tables."
      ]
    },
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_ComponentLabel": {
      "description": "Terms attached to a named carried component on a consumer response.",
      "properties": {
        "component": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Native component name."
        },
        "terms": {
          "$ref": "#/$defs/Reply_ComponentTerms",
          "description": "Canonical publisher terms."
        }
      },
      "required": [
        "component",
        "terms"
      ],
      "type": "object"
    },
    "Reply_ComponentTerms": {
      "description": "Terms attached to one independently licensed source component.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Publisher terms name."
        },
        "url": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Publisher terms page.",
          "format": "uri"
        },
        "usage": {
          "$ref": "#/$defs/Reply_Use",
          "description": "Publisher use category."
        }
      },
      "required": [
        "usage",
        "name",
        "url"
      ],
      "type": "object"
    },
    "Reply_FaersAgeUnit": {
      "description": "Exact openFDA patientonsetageunit codes.",
      "enum": [
        "800",
        "801",
        "802",
        "803",
        "804",
        "805"
      ],
      "type": "string"
    },
    "Reply_FaersSeriousness": {
      "description": "Independent overlapping report-level flags; no CTCAE or reaction-outcome conversion.",
      "properties": {
        "congenitalanomali": {
          "description": "Native congenitalanomali string, including a present empty value.",
          "type": [
            "string",
            "null"
          ]
        },
        "death": {
          "description": "Native death string, including a present empty value.",
          "type": [
            "string",
            "null"
          ]
        },
        "disabling": {
          "description": "Native disabling string, including a present empty value.",
          "type": [
            "string",
            "null"
          ]
        },
        "hospitalization": {
          "description": "Native hospitalization string, including a present empty value.",
          "type": [
            "string",
            "null"
          ]
        },
        "lifethreatening": {
          "description": "Native lifethreatening string, including a present empty value.",
          "type": [
            "string",
            "null"
          ]
        },
        "other": {
          "description": "Native other string, including a present empty value.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Reply_FiniteNumber": {
      "description": "A finite decimal that JSON can represent without losing its value to null.",
      "format": "double",
      "type": "number"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "Reply_ReportId": {
      "description": "Opaque published digits with source carried separately, never a prefixed wrapper.",
      "pattern": "^[0-9]+$",
      "type": "string"
    },
