{
  "$defs": {
    "Reply_AbstractPart": {
      "description": "One source-labelled abstract paragraph.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source label, when supplied."
        },
        "text": {
          "$ref": "#/$defs/Reply_Markdown",
          "description": "Whole paragraph text."
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "Reply_Correction": {
      "description": "One correction relationship supplied by PubMed.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/Reply_CorrectionKind",
          "description": "Correction category."
        },
        "pmid": {
          "$ref": "#/$defs/Reply_Pmid",
          "description": "Related PMID, when supplied."
        },
        "relation": {
          "$ref": "#/$defs/Reply_CorrectionRelation",
          "description": "Whether the related record is a notice or original."
        }
      },
      "required": [
        "kind",
        "relation"
      ],
      "type": "object"
    },
    "Reply_CorrectionKind": {
      "description": "Source correction relationship kind.",
      "type": "string",
      "x-enum-descriptions": [
        " Retraction relationship.",
        " Erratum relationship.",
        " Expression of concern relationship."
      ],
      "x-extensible-enum": [
        "retraction",
        "erratum",
        "expression-of-concern"
      ]
    },
    "Reply_CorrectionRelation": {
      "description": "Direction of a source correction relationship.",
      "type": "string",
      "x-enum-descriptions": [
        " The related record is the notice.",
        " The related record is the original."
      ],
      "x-extensible-enum": [
        "notice",
        "original"
      ]
    },
    "Reply_Doi": {
      "description": "DOI preserving source spelling with ASCII-insensitive equality.",
      "pattern": "^10\\.[0-9]+/[^\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f]+$",
      "type": "string"
    },
    "Reply_EuropePmcId": {
      "description": "Europe PMC source prefix followed by its positive numeric local identifier.",
      "pattern": "^(?=.{1,64}$)[A-Z]{1,8}[0-9]*[1-9][0-9]*$",
      "type": "string"
    },
    "Reply_Markdown": {
      "description": "Nonempty source Markdown retains LF, CR and tab formatting; unsafe controls use visible escapes. The parser additionally rejects whitespace-only values.",
      "format": "markdown",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_Pmcid": {
      "description": "Canonical PMC identifier, with an explicit namespace.",
      "pattern": "^PMC(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_Pmid": {
      "description": "Positive PubMed identifier.",
      "pattern": "^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_PublicationType": {
      "description": "Clinically meaningful PubMed publication types.",
      "type": "string",
      "x-enum-descriptions": [
        " Randomized controlled trial.",
        " Clinical trial.",
        " Phase one trial.",
        " Phase two trial.",
        " Phase three trial.",
        " Phase four trial.",
        " Meta-analysis.",
        " Systematic review.",
        " Review.",
        " Practice guideline.",
        " Guideline.",
        " Case report.",
        " Observational study.",
        " Multicenter study.",
        " Letter.",
        " Comment.",
        " Editorial.",
        " Preprint.",
        " Retracted publication.",
        " Retraction notice.",
        " Erratum."
      ],
      "x-extensible-enum": [
        "randomized-controlled-trial",
        "clinical-trial",
        "clinical-trial-phase-1",
        "clinical-trial-phase-2",
        "clinical-trial-phase-3",
        "clinical-trial-phase-4",
        "meta-analysis",
        "systematic-review",
        "review",
        "practice-guideline",
        "guideline",
        "case-report",
        "observational-study",
        "multicenter-study",
        "letter",
        "comment",
        "editorial",
        "preprint",
        "retracted-publication",
        "retraction-notice",
        "erratum"
      ]
    },
    "Reply_Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    }
  },
  "$id": "biomcp.article/4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "required": [
        "pmid"
      ]
    },
    {
      "required": [
        "pmcid"
      ]
    },
    {
      "required": [
        "doi"
      ]
    },
    {
      "required": [
        "europepmc_id"
      ]
    }
  ],
  "description": "Article facts with at least one checked identity.",
  "properties": {
    "abstract_parts": {
      "description": "Whole abstract, preserving labels and source order.",
      "items": {
        "$ref": "#/$defs/Reply_AbstractPart"
      },
      "type": "array"
    },
    "authors": {
      "description": "Authors in source order.",
      "items": {
        "$ref": "#/$defs/Reply_Text"
      },
      "type": "array"
    },
    "corrections": {
      "description": "Related correction notices or originals.",
      "items": {
        "$ref": "#/$defs/Reply_Correction"
      },
      "type": "array"
    },
    "date": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_PartialDate"
        },
        {
          "type": "null"
        }
      ],
      "description": "Publication date at source precision."
    },
    "doi": {
      "$ref": "#/$defs/Reply_Doi",
      "description": "DOI assigned to this article."
    },
    "electronic_date": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_PartialDate"
        },
        {
          "type": "null"
        }
      ],
      "description": "Electronic publication date when different from the publication date."
    },
    "europepmc_id": {
      "$ref": "#/$defs/Reply_EuropePmcId",
      "description": "Europe PMC identity when this card comes from its core record."
    },
    "journal": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Journal name."
    },
    "pmcid": {
      "$ref": "#/$defs/Reply_Pmcid",
      "description": "PMC identity assigned to this article."
    },
    "pmid": {
      "$ref": "#/$defs/Reply_Pmid",
      "description": "PubMed identity."
    },
    "title": {
      "$ref": "#/$defs/Reply_Text",
      "description": "Whole title with inline text preserved."
    },
    "types": {
      "description": "Every clinically meaningful source publication type.",
      "items": {
        "$ref": "#/$defs/Reply_PublicationType"
      },
      "type": "array"
    }
  },
  "required": [
    "authors"
  ],
  "title": "Article",
  "type": "object"
}
