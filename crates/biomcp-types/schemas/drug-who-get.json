{
  "$defs": {
    "DrugSource": {
      "description": "A supported drug data source.",
      "enum": [
        "who-pq",
        "fda-drug-recall",
        "mychem",
        "chembl",
        "opentargets",
        "civic",
        "openfda-label",
        "drugsfda",
        "ema",
        "ddinter"
      ],
      "type": "string"
    },
    "Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    }
  },
  "$id": "biomcp.drug-who-get/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "WHO exact-reference selector keeps the shared DrugId contract unchanged.",
  "properties": {
    "input": {
      "$ref": "#/$defs/Text",
      "description": "Exact WHO reference number, including native spaces; no name or alias resolution.",
      "x-positional": 0
    },
    "source": {
      "$ref": "#/$defs/DrugSource",
      "description": "Explicit source who-pq; prequalification is source-scoped."
    }
  },
  "required": [
    "input",
    "source"
  ],
  "title": "DrugWhoGet",
  "type": "object"
}
