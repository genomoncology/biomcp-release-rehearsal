{
  "$defs": {
    "Reply_Build": {
      "description": "The assembly stated by the source; no default is inferred.",
      "type": "string",
      "x-enum-descriptions": [
        " Genome Reference Consortium human build 37.",
        " Genome Reference Consortium human build 38."
      ],
      "x-extensible-enum": [
        "GRCh37",
        "GRCh38"
      ]
    },
    "Reply_Chromosome": {
      "description": "A primary chromosome in the caller's reference build.",
      "pattern": "^([1-9]|1[0-9]|2[0-2]|X|Y|MT)$",
      "type": "string"
    },
    "Reply_EnsemblGeneId": {
      "description": " A human Ensembl gene stable identifier with a separately retained version.",
      "pattern": "^ENSG[0-9]{11}(\\.(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))?$",
      "type": "string"
    },
    "Reply_Gene": {
      "description": "Human gene identity and whole source annotations, independent of response cards.",
      "properties": {
        "aliases": {
          "description": "All stated HGNC aliases.",
          "items": {
            "$ref": "#/$defs/Reply_Text"
          },
          "type": "array"
        },
        "ensembl_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_EnsemblGeneId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Ensembl gene identifier, if stated."
        },
        "entrez_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_NcbiGeneId"
            },
            {
              "type": "null"
            }
          ],
          "description": "NCBI Gene identifier, if stated."
        },
        "hgnc_id": {
          "$ref": "#/$defs/Reply_HgncId",
          "description": "HGNC identifier."
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_GeneLocation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-stated location, including unparsed publisher text."
        },
        "locus_group": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_LocusGroup"
            },
            {
              "type": "null"
            }
          ],
          "description": "HGNC locus group."
        },
        "locus_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_LocusType"
            },
            {
              "type": "null"
            }
          ],
          "description": "HGNC locus type, if stated and recognized."
        },
        "mane": {
          "description": "Versioned MANE Select transcript pair, if stated.",
          "items": {
            "$ref": "#/$defs/Reply_Mane"
          },
          "type": "array"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Gene name."
        },
        "omim": {
          "description": "All stated OMIM identifiers.",
          "items": {
            "$ref": "#/$defs/Reply_OmimId"
          },
          "type": "array"
        },
        "previous_symbols": {
          "description": "All stated previous symbols.",
          "items": {
            "$ref": "#/$defs/Reply_GeneSymbol"
          },
          "type": "array"
        },
        "spans": {
          "description": "Source intervals with explicit assembly and counting rule.",
          "items": {
            "$ref": "#/$defs/Reply_GenomicInterval"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/Reply_GeneStatus",
          "description": "HGNC record status."
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Summary"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whole attributed summary, if stated."
        },
        "symbol": {
          "$ref": "#/$defs/Reply_GeneSymbol",
          "description": "Source-preserved symbol."
        },
        "uniprot": {
          "description": "All stated UniProt base accessions.",
          "items": {
            "$ref": "#/$defs/Reply_UniProtAcc"
          },
          "type": "array"
        }
      },
      "required": [
        "hgnc_id",
        "symbol",
        "status"
      ],
      "type": "object"
    },
    "Reply_GeneHeader": {
      "description": "Enough gene identity to choose a search result.",
      "properties": {
        "hgnc_id": {
          "$ref": "#/$defs/Reply_HgncId",
          "description": "HGNC identifier."
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_GeneLocation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-stated location, including unparsed publisher text."
        },
        "locus_group": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_LocusGroup"
            },
            {
              "type": "null"
            }
          ],
          "description": "HGNC locus group."
        },
        "match": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Match"
            },
            {
              "type": "null"
            }
          ],
          "description": "Match information when this header answers an input."
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Gene name."
        },
        "status": {
          "$ref": "#/$defs/Reply_GeneStatus",
          "description": "HGNC record status."
        },
        "symbol": {
          "$ref": "#/$defs/Reply_GeneSymbol",
          "description": "Source-preserved symbol."
        }
      },
      "required": [
        "hgnc_id",
        "symbol",
        "status"
      ],
      "type": "object"
    },
    "Reply_GeneLocation": {
      "description": "HGNC location text with a parsed interpretation when its syntax is known.",
      "type": "string"
    },
    "Reply_GeneStatus": {
      "description": "HGNC approval status.",
      "type": "string",
      "x-enum-descriptions": [
        " An HGNC approved record.",
        " An HGNC withdrawn record."
      ],
      "x-extensible-enum": [
        "approved",
        "withdrawn"
      ]
    },
    "Reply_GeneSymbol": {
      "description": "Source spelling of a gene symbol, with ASCII case-insensitive identity.",
      "pattern": "^[A-Za-z][A-Za-z0-9._/@-]{0,254}$",
      "type": "string"
    },
    "Reply_GenomicInterval": {
      "description": "An assembly-qualified zero-based half-open source interval.",
      "properties": {
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Build"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-stated assembly, omitted when absent."
        },
        "chromosome": {
          "$ref": "#/$defs/Reply_Chromosome",
          "description": "Canonical primary chromosome."
        },
        "span": {
          "$ref": "#/$defs/Reply_Span0",
          "description": "Checked zero-based half-open bounds; an empty span remains valid."
        },
        "strand": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Strand"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-stated strand, if available."
        }
      },
      "required": [
        "chromosome",
        "span"
      ],
      "type": "object"
    },
    "Reply_HgncId": {
      "description": "An HGNC identifier with canonical namespace and positive numeric value.",
      "pattern": "^HGNC:(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_HgncStatus": {
      "description": "HGNC's stated withdrawn-file status.",
      "type": "string",
      "x-enum-descriptions": [
        " Entry withdrawn.",
        " Entry merged or split."
      ],
      "x-extensible-enum": [
        "entry_withdrawn",
        "merged_split"
      ]
    },
    "Reply_LocusGroup": {
      "description": "HGNC locus group, separate from a missing source value.",
      "type": "string",
      "x-enum-descriptions": [
        " Protein coding.",
        " Non-coding RNA.",
        " Pseudogene.",
        " Phenotype.",
        " HGNC's stated other group."
      ],
      "x-extensible-enum": [
        "protein_coding",
        "non_coding_rna",
        "pseudogene",
        "phenotype",
        "other"
      ]
    },
    "Reply_LocusType": {
      "description": "HGNC locus type; Unknown is a source-stated value, distinct from absence.",
      "type": "string",
      "x-enum-descriptions": [
        " HGNC gene with protein product.",
        " HGNC rna cluster.",
        " HGNC long non coding rna.",
        " HGNC micro rna.",
        " HGNC misc rna.",
        " HGNC ribosomal rna.",
        " HGNC small nuclear rna.",
        " HGNC small nucleolar rna.",
        " HGNC transfer rna.",
        " HGNC vault rna.",
        " HGNC y rna.",
        " HGNC phenotype only.",
        " HGNC pseudogene.",
        " HGNC complex locus constituent.",
        " HGNC endogenous retrovirus.",
        " HGNC fragile site.",
        " HGNC immunoglobulin gene.",
        " HGNC immunoglobulin pseudogene.",
        " HGNC readthrough.",
        " HGNC region.",
        " HGNC t cell receptor gene.",
        " HGNC t cell receptor pseudogene.",
        " HGNC transposable element.",
        " HGNC unknown.",
        " HGNC virus integration site."
      ],
      "x-extensible-enum": [
        "gene_with_protein_product",
        "rna_cluster",
        "long_non_coding_rna",
        "micro_rna",
        "misc_rna",
        "ribosomal_rna",
        "small_nuclear_rna",
        "small_nucleolar_rna",
        "transfer_rna",
        "vault_rna",
        "y_rna",
        "phenotype_only",
        "pseudogene",
        "complex_locus_constituent",
        "endogenous_retrovirus",
        "fragile_site",
        "immunoglobulin_gene",
        "immunoglobulin_pseudogene",
        "readthrough",
        "region",
        "t_cell_receptor_gene",
        "t_cell_receptor_pseudogene",
        "transposable_element",
        "unknown",
        "virus_integration_site"
      ]
    },
    "Reply_Mane": {
      "description": "A source-stated MANE pair with versioned sequence accessions.",
      "properties": {
        "ensembl": {
          "description": "Versioned Ensembl accession.",
          "pattern": "^ENST[0-9]{11}\\.[1-9][0-9]*$",
          "type": "string"
        },
        "refseq": {
          "description": "Versioned RefSeq accession.",
          "pattern": "^(NM_|NR_)([0-9]{6}|[0-9]{9})\\.[1-9][0-9]*$",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Reply_ManeStatus",
          "description": "Source-stated transcript status."
        }
      },
      "required": [
        "status",
        "refseq",
        "ensembl"
      ],
      "type": "object"
    },
    "Reply_ManeStatus": {
      "description": "The source-stated MANE transcript status.",
      "type": "string",
      "x-enum-descriptions": [
        " MANE Select transcript pair.",
        " MANE Plus Clinical transcript pair."
      ],
      "x-extensible-enum": [
        "select",
        "plus_clinical"
      ]
    },
    "Reply_Match": {
      "description": "A source-stated match, preserving the text that matched.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/Reply_MatchKind",
          "description": "The match category."
        },
        "text": {
          "$ref": "#/$defs/Reply_Text",
          "description": "The source text that matched the input."
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "type": "object"
    },
    "Reply_MatchKind": {
      "description": "How a source matched a gene input.",
      "type": "string",
      "x-enum-descriptions": [
        " Current symbol.",
        " Previous symbol.",
        " HGNC alias.",
        " NCBI-only alias.",
        " HGNC identifier.",
        " NCBI Gene identifier.",
        " Ensembl gene identifier.",
        " Cytogenetic band."
      ],
      "x-extensible-enum": [
        "symbol",
        "previous_symbol",
        "alias",
        "ncbi_alias",
        "hgnc_id",
        "entrez_id",
        "ensembl_id",
        "band"
      ]
    },
    "Reply_NcbiGeneId": {
      "description": "A positive NCBI Gene identifier in canonical decimal text.",
      "pattern": "^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_OmimId": {
      "description": " A six-digit OMIM identifier, preserving all six digits.",
      "pattern": "^[1-6][0-9]{5}$",
      "type": "string"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_Span0": {
      "description": "A zero-based half-open span with ordered bounds; empty spans are valid.",
      "properties": {
        "end": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "Reply_Strand": {
      "description": "Source-stated forward or reverse strand.",
      "type": "string",
      "x-enum-descriptions": [
        " Forward strand.",
        " Reverse strand."
      ],
      "x-extensible-enum": [
        "+",
        "-"
      ]
    },
    "Reply_Summary": {
      "description": "A whole source-provided summary with attribution and stated date precision.",
      "properties": {
        "dated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Date stated by the source, if any."
        },
        "source": {
          "$ref": "#/$defs/Reply_SummarySource",
          "description": "The summary's attribution, independent of the fetching provider."
        },
        "text": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Entire summary text."
        }
      },
      "required": [
        "text",
        "source"
      ],
      "type": "object"
    },
    "Reply_SummarySource": {
      "description": "The attribution on a source-provided summary, independent of fetch providers.",
      "type": "string",
      "x-enum-descriptions": [
        " RefSeq attribution."
      ],
      "x-extensible-enum": [
        "refseq"
      ]
    },
    "Reply_Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    },
    "Reply_UniProtAcc": {
      "description": " A whole UniProt base accession, without an isoform suffix.",
      "pattern": "^([OPQ][0-9][A-Z0-9]{3}[0-9]|[A-NR-Z][0-9]([A-Z][A-Z0-9]{2}[0-9]){1,2})$",
      "type": "string"
    }
  },
  "$id": "biomcp.gene-resolution/7",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Resolution outcomes preserve ambiguity and withdrawn identity.",
  "oneOf": [
    {
      "description": "One resolved identity and its source match.",
      "properties": {
        "gene": {
          "$ref": "#/$defs/Reply_Gene",
          "description": "The whole gene entity."
        },
        "match": {
          "$ref": "#/$defs/Reply_Match",
          "description": "How the source matched the input."
        },
        "resolution": {
          "const": "resolved",
          "type": "string"
        }
      },
      "required": [
        "resolution",
        "gene",
        "match"
      ],
      "type": "object"
    },
    {
      "description": "Every candidate, with no silent selection.",
      "properties": {
        "candidates": {
          "description": "Ordered candidates supplied by the resolver.",
          "items": {
            "$ref": "#/$defs/Reply_GeneHeader"
          },
          "type": "array"
        },
        "resolution": {
          "const": "ambiguous",
          "type": "string"
        }
      },
      "required": [
        "resolution"
      ],
      "type": "object"
    },
    {
      "description": "The original withdrawn identity and stated successors.",
      "properties": {
        "hgnc_id": {
          "$ref": "#/$defs/Reply_HgncId",
          "description": "Original HGNC identifier."
        },
        "hgnc_status": {
          "$ref": "#/$defs/Reply_HgncStatus",
          "description": "Stated HGNC withdrawn-file status."
        },
        "merged_into": {
          "description": "All stated merge destinations.",
          "items": {
            "$ref": "#/$defs/Reply_HgncId"
          },
          "type": "array"
        },
        "resolution": {
          "const": "withdrawn",
          "type": "string"
        },
        "symbol": {
          "$ref": "#/$defs/Reply_GeneSymbol",
          "description": "Original symbol."
        }
      },
      "required": [
        "resolution",
        "hgnc_id",
        "symbol",
        "hgnc_status"
      ],
      "type": "object"
    },
    {
      "description": "No source identity matched.",
      "properties": {
        "resolution": {
          "const": "not-found",
          "type": "string"
        }
      },
      "required": [
        "resolution"
      ],
      "type": "object"
    }
  ],
  "title": "GeneResolution"
}
