{
  "$defs": {
    "Reply_Curie": {
      "description": "Checked prefix:local ontology identifier.",
      "pattern": "^[A-Za-z0-9_.-]+:[^:/\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f][^:\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f]*$",
      "type": "string"
    },
    "Reply_Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    }
  },
  "$id": "biodata.disease-endpoint/3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One native endpoint with an identifier and an optional source label.\nNative associations use this reference because a source may omit a display label.",
  "properties": {
    "id": {
      "$ref": "#/$defs/Reply_Curie",
      "description": "Exact source identifier."
    },
    "label": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Source label when supplied."
    }
  },
  "required": [
    "id"
  ],
  "title": "DiseaseEndpoint",
  "type": "object"
}
