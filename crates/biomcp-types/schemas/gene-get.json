{
  "$defs": {
    "GeneInput": {
      "description": "An input classified before source resolution; aliases remain free text.",
      "pattern": "^[\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*(?:HGNC:(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})|ENSG[0-9]{11}(\\.(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))?|(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})|(?!(?:[Hh][Gg][Nn][Cc]:|[Ee][Nn][Ss][Gg]))(?![0-9]+[\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*$)[^\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](?:[\\s\\S]*[^\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])?)[\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*$",
      "type": "string"
    },
    "GeneSectionWord": {
      "description": "A section request word, including expansion to all landed sections.",
      "enum": [
        "protein",
        "civic",
        "clingen",
        "gencc",
        "constraint",
        "expression",
        "pathways",
        "oncokb",
        "all"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Reviewed human proteins.",
        " CIViC gene curation.",
        " ClinGen validity and dosage.",
        " GenCC submitter assessments.",
        " Population constraint metrics.",
        " Human Protein Atlas expression.",
        " Human Reactome pathways.",
        " Keyed OncoKB annotations.",
        " Every landed section."
      ]
    }
  },
  "$id": "biomcp.gene-get/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Get one to twenty human gene inputs in their original order.",
  "properties": {
    "input": {
      "description": "Gene symbols or checked identifiers, in input order.",
      "items": {
        "$ref": "#/$defs/GeneInput"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array",
      "x-positional": 0
    },
    "section": {
      "description": "Requested section words, preserving caller order and repetitions.\nTrailing section words select sections. Use --section WORD to keep inputs that equal a section word as inputs.",
      "items": {
        "$ref": "#/$defs/GeneSectionWord"
      },
      "type": "array",
      "x-trailing-section": true
    }
  },
  "required": [
    "input"
  ],
  "title": "GeneGet",
  "type": "object"
}
