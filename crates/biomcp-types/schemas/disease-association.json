{
  "$defs": {
    "Reply_Attribution": {
      "description": "Provenance for one source record.",
      "properties": {
        "approved": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source approval date."
        },
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "published": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source publication date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "Reply_Curie": {
      "description": "Checked prefix:local ontology identifier.",
      "pattern": "^[A-Za-z0-9_.-]+:[^:/\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f][^:\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f]*$",
      "type": "string"
    },
    "Reply_DiseaseAssociationQualifier": {
      "description": "A named native qualifier without an inferred role.",
      "properties": {
        "field": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Original native qualifier field."
        },
        "id": {
          "$ref": "#/$defs/Reply_Curie",
          "description": "Native qualifier identity."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native label when supplied."
        }
      },
      "required": [
        "field",
        "id"
      ],
      "type": "object"
    },
    "Reply_DiseaseAssociationReference": {
      "description": "One native association reference, with no invented display label or link.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_Curie",
          "description": "Native evidence or publication identity."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native label when supplied."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Unchanged native link when supplied.",
          "format": "uri"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Reply_DiseaseEndpoint": {
      "description": "One native endpoint with an identifier and an optional source label.\nNative associations use this reference because a source may omit a display label.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_Curie",
          "description": "Exact source identifier."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source label when supplied."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Reply_FiniteNumber": {
      "description": "A finite decimal that JSON can represent without losing its value to null.",
      "format": "double",
      "type": "number"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    }
  },
  "$id": "biodata.disease-association/7",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A native source association without clinical interpretation.",
  "properties": {
    "agent_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native agent type."
    },
    "aggregator_knowledge_source": {
      "description": "Native aggregator knowledge sources; missing, null and lists remain distinct.",
      "items": {
        "$ref": "#/$defs/Reply_Curie"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "attribution": {
      "$ref": "#/$defs/Reply_Attribution",
      "description": "Native row provenance and version."
    },
    "category": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Curie"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native association category."
    },
    "evidence": {
      "description": "Source evidence terms; unavailable evidence stays absent.",
      "items": {
        "$ref": "#/$defs/Reply_DiseaseAssociationReference"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "evidence_count": {
      "description": "Native evidence count, distinct from returned reference count.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "has_count": {
      "description": "Native annotation count, without a computed denominator.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "has_percentage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_FiniteNumber"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native percentage, never computed from another field."
    },
    "has_quotient": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_FiniteNumber"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native quotient, never computed from another field."
    },
    "has_total": {
      "description": "Native annotation total, without inferring an assayed denominator.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "knowledge_level": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native source knowledge level."
    },
    "negated": {
      "description": "Source negation; absent is not false.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "object": {
      "$ref": "#/$defs/Reply_DiseaseEndpoint",
      "description": "Native returned object."
    },
    "object_closure": {
      "description": "Native object closure.",
      "items": {
        "$ref": "#/$defs/Reply_Curie"
      },
      "type": "array"
    },
    "original_object": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Curie"
        },
        {
          "type": "null"
        }
      ],
      "description": "Original source object before source normalization."
    },
    "original_predicate": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native pre-normalization predicate, without interpretation."
    },
    "original_subject": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Curie"
        },
        {
          "type": "null"
        }
      ],
      "description": "Original source subject before source normalization."
    },
    "predicate": {
      "$ref": "#/$defs/Reply_Curie",
      "description": "Native source predicate."
    },
    "primary_knowledge_source": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Curie"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native primary knowledge source."
    },
    "provided_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native providing collection."
    },
    "publications": {
      "description": "Native publication references, without inferred links or labels.",
      "items": {
        "$ref": "#/$defs/Reply_DiseaseAssociationReference"
      },
      "type": "array"
    },
    "qualifiers": {
      "description": "Native qualifiers, including frequency or onset if supplied.",
      "items": {
        "$ref": "#/$defs/Reply_DiseaseAssociationQualifier"
      },
      "type": "array"
    },
    "requested_id": {
      "$ref": "#/$defs/Reply_Curie",
      "description": "The exact requested concept, including a queried parent."
    },
    "subject": {
      "$ref": "#/$defs/Reply_DiseaseEndpoint",
      "description": "Native returned subject."
    },
    "subject_closure": {
      "description": "Native subject closure.",
      "items": {
        "$ref": "#/$defs/Reply_Curie"
      },
      "type": "array"
    },
    "subject_taxon": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Curie"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native subject taxon, only as supplied by the publisher."
    }
  },
  "required": [
    "requested_id",
    "subject",
    "predicate",
    "object",
    "attribution"
  ],
  "title": "DiseaseAssociation",
  "type": "object"
}
