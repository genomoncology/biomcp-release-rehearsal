{
  "$defs": {
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_Curie": {
      "description": "Checked prefix:local ontology identifier.",
      "pattern": "^[A-Za-z0-9_.-]+:[^:/\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f][^:\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f]*$",
      "type": "string"
    },
    "Reply_GeneSymbol": {
      "description": "Source spelling of a gene symbol, with ASCII case-insensitive identity.",
      "pattern": "^[A-Za-z][A-Za-z0-9._/@-]{0,254}$",
      "type": "string"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PgxAnnotationKind": {
      "description": "Independent ClinPGx collection kinds, never merged.",
      "enum": [
        "clinical",
        "guideline",
        "label"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Clinical annotation min tier.",
        " Guideline references.",
        " Label references."
      ]
    },
    "Reply_PgxDiplotype": {
      "description": "Every source-returned mapping for the exact declared expression.",
      "properties": {
        "diplotypes": {
          "description": "Zero, one or multiple native mappings; never a selected patient phenotype.",
          "items": {
            "$ref": "#/$defs/Reply_PgxDiplotypeResult"
          },
          "type": "array"
        },
        "header": {
          "$ref": "#/$defs/Reply_PgxHeader",
          "description": "Explicit gene and source."
        }
      },
      "required": [
        "header"
      ],
      "type": "object"
    },
    "Reply_PgxDiplotypeExpression": {
      "description": "Unchanged declared source diplotype expression; no allele sorting, phase or score calculation.",
      "pattern": "[^\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "type": "string"
    },
    "Reply_PgxDiplotypeResult": {
      "description": "Source-native PgxDiplotypeResult fields; no clinical interpretation.\n```compile_fail\nfn interpret(value: biodata::PgxDiplotypeResult) -> biodata::Statement { value }\n```",
      "properties": {
        "activityvalue1": {
          "description": "Native `activityvalue1`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "activityvalue2": {
          "description": "Native `activityvalue2`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "consultationtext": {
          "description": "Native `consultationtext`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "description": "Native `description`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "diplotype": {
          "description": "Native `diplotype`; literal source value.",
          "type": "string"
        },
        "diplotypekey": {
          "description": "Native `diplotypekey`; literal source value.",
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9._/@-]{0,254}$": {
              "additionalProperties": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "type": "object"
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "ehrpriority": {
          "description": "Native `ehrpriority`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "function1": {
          "description": "Native `function1`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "function2": {
          "description": "Native `function2`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "generesult": {
          "description": "Native `generesult`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "genesymbol": {
          "$ref": "#/$defs/Reply_GeneSymbol",
          "description": "Native `genesymbol`; literal source value."
        },
        "lookupkey": {
          "description": "Native `lookupkey`; literal source value.",
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9._/@-]{0,254}$": {
              "type": "string"
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "totalactivityscore": {
          "description": "Native `totalactivityscore`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "genesymbol",
        "diplotype"
      ],
      "type": "object"
    },
    "Reply_PgxGet": {
      "description": "PGx card or section. No phenotype, phase or dose is calculated.",
      "properties": {
        "diplotype": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PgxDiplotypeExpression"
            },
            {
              "type": "null"
            }
          ],
          "description": "Unchanged declared expression required for the diplotype section only."
        },
        "drug_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Curie"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact published CPIC drug key; recommendations only."
        },
        "gene": {
          "$ref": "#/$defs/Reply_GeneSymbol",
          "description": "Explicit source gene symbol."
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PgxAnnotationKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "One ClinPGx collection; clinical is the default only on annotations."
        },
        "section": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PgxSection"
            },
            {
              "type": "null"
            }
          ],
          "description": "One named section; omitted means the CPIC gene card.",
          "x-positional": 0
        },
        "section_limit": {
          "description": "Rows per page: three clinical, five elsewhere.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "section_offset": {
          "default": 0,
          "description": "Offset within the selected section.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Retained collection for local continuation."
        },
        "source": {
          "$ref": "#/$defs/Reply_PgxSource",
          "description": "Required source, checked against the section."
        }
      },
      "required": [
        "gene",
        "source"
      ],
      "type": "object"
    },
    "Reply_PgxHeader": {
      "description": "Source and declared gene context; no chosen pair or patient result.",
      "properties": {
        "gene": {
          "$ref": "#/$defs/Reply_GeneSymbol",
          "description": "Declared source symbol."
        },
        "source": {
          "$ref": "#/$defs/Reply_PgxSource",
          "description": "Explicit source."
        }
      },
      "required": [
        "source",
        "gene"
      ],
      "type": "object"
    },
    "Reply_PgxSection": {
      "description": "One independent named section.",
      "enum": [
        "recommendations",
        "guidelines",
        "diplotype",
        "annotations"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Complete native recommendation contexts.",
        " Native guideline references.",
        " Declared source diplotype lookup.",
        " One ClinPGx annotation kind."
      ]
    },
    "Reply_PgxSource": {
      "description": "Explicit independent source.",
      "enum": [
        "cpic",
        "clinpgx"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " CPIC source-native records.",
        " ClinPGx annotation records."
      ]
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "Reply_Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " WikiPathways published pathway catalogs.",
        " Human Protein Atlas.",
        " UniProt.",
        " Integrated InterPro entries.",
        " Complex Portal.",
        " gnomAD.",
        " ClinVar component source policy.",
        " ClinGen Evidence Repository.",
        " GWAS Catalog v2.",
        " ClinGen.",
        " GenCC submitter assessments.",
        " PubMed.",
        " Europe PMC.",
        " NCBI LitVar2.",
        " NCBI LitSense2.",
        " Semantic Scholar.",
        " ORCID public registry.",
