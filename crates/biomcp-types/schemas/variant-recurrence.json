{
  "$defs": {
    "Reply_Accession": {
      "description": "A reference sequence accession: RefSeq or Ensembl with its version, or LRG.",
      "pattern": "^(?:(?:N[CGMPRTW]|X[MPR])_(?:[0-9]{6}|(?!000)[0-9]{9})\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|ENS[GTP][0-9]{11}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|LRG_0*(?:0|(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))(?:[tp]0*(?:0|(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})))?)$",
      "type": "string"
    },
    "Reply_Allele": {
      "description": "Source-stated interbase replacement; equality never claims normalized equivalence.",
      "properties": {
        "alternate": {
          "$ref": "#/$defs/Reply_Sequence"
        },
        "location": {
          "$ref": "#/$defs/Reply_SequenceLocation"
        },
        "reference": {
          "$ref": "#/$defs/Reply_Sequence"
        }
      },
      "required": [
        "location",
        "reference",
        "alternate"
      ],
      "type": "object"
    },
    "Reply_Build": {
      "description": "The assembly stated by the source; no default is inferred.",
      "type": "string",
      "x-enum-descriptions": [
        " Genome Reference Consortium human build 37.",
        " Genome Reference Consortium human build 38."
      ],
      "x-extensible-enum": [
        "GRCh37",
        "GRCh38"
      ]
    },
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_EnsemblGeneId": {
      "description": " A human Ensembl gene stable identifier with a separately retained version.",
      "pattern": "^ENSG[0-9]{11}(\\.(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))?$",
      "type": "string"
    },
    "Reply_Expression": {
      "description": "Source expression checked for its reference and syntax only, without a full parser or normalization.",
      "properties": {
        "syntax": {
          "$ref": "#/$defs/Reply_ExpressionSyntax"
        },
        "syntax_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/Reply_Text"
        }
      },
      "required": [
        "syntax",
        "value"
      ],
      "type": "object"
    },
    "Reply_ExpressionSyntax": {
      "description": "Published syntax label for a source-preserved expression.",
      "type": "string",
      "x-enum-descriptions": [
        " HGVS genomic description.",
        " HGVS coding description.",
        " HGVS noncoding transcript description.",
        " HGVS RNA description.",
        " HGVS protein description.",
        " HGVS mitochondrial description.",
        " HGVS circular genomic description.",
        " NCBI SPDI interbase description.",
        " gnomAD chromosome-position-reference-alternate identifier.",
        " Padded VCF chromosome-position-reference-alternate text.",
        " Source-preserved cytogenetic notation."
      ],
      "x-extensible-enum": [
        "hgvs.g",
        "hgvs.c",
        "hgvs.n",
        "hgvs.r",
        "hgvs.p",
        "hgvs.m",
        "hgvs.o",
        "spdi",
        "gnomad",
        "vcf",
        "iscn"
      ]
    },
    "Reply_GeneRef": {
      "description": "A source-stated gene reference; its label never implies an identifier.",
      "properties": {
        "ensembl_gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_EnsemblGeneId"
            },
            {
              "type": "null"
            }
          ]
        },
        "hgnc_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_HgncId"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "$ref": "#/$defs/Reply_Text"
        },
        "ncbi_gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_NcbiGeneId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "Reply_GeneSymbol": {
      "description": "Source spelling of a gene symbol, with ASCII case-insensitive identity.",
      "pattern": "^[A-Za-z][A-Za-z0-9._/@-]{0,254}$",
      "type": "string"
    },
    "Reply_HgncId": {
      "description": "An HGNC identifier with canonical namespace and positive numeric value.",
      "pattern": "^HGNC:(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_NcbiGeneId": {
      "description": "A positive NCBI Gene identifier in canonical decimal text.",
      "pattern": "^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "Reply_RecurrenceGranularity": {
      "description": "Source fields required for a recurrence observation.",
      "enum": [
        "exact-genomic-allele"
      ],
      "type": "string"
    },
    "Reply_RecurrenceSource": {
      "description": "Source requiring explicit study, profile and sample set.",
      "enum": [
        "cbioportal"
      ],
      "type": "string"
    },
    "Reply_RecurrenceStudy": {
      "description": "Source-native descriptive metadata, without treating access groups as licenses.",
      "properties": {
        "citation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source publication citation."
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Complete source description, including any literal reuse notice."
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source study title."
        }
      },
      "type": "object"
    },
    "Reply_RecurrenceTerms": {
      "description": "Public access grants no study-specific commercial reuse permission.",
      "properties": {
        "notice": {
          "description": "Source warning about possible commercial restrictions.",
          "type": "string"
        },
        "unverified": {
          "description": "Study-specific rights remain unverified.",
          "type": "boolean"
        },
        "url": {
          "description": "Publisher FAQ explaining study-specific terms.",
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "unverified",
        "notice",
        "url"
      ],
      "type": "object"
    },
    "Reply_Representation": {
      "description": "One source's own expression, assembly and optional source-stated interbase allele.",
      "properties": {
        "allele": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Allele"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-supplied allele, without local normalization or equivalence inference."
        },
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Build"
            },
            {
              "type": "null"
            }
          ],
          "description": "Assembly stated by the source, omitted when absent."
        },
        "expression": {
          "$ref": "#/$defs/Reply_Expression",
          "description": "Published notation kept unchanged."
        },
        "source": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Source asserting this form."
        }
      },
      "required": [
        "source",
        "expression"
      ],
      "type": "object"
    },
    "Reply_Sequence": {
      "description": "A literal IUPAC DNA sequence; empty sequences express insertions or deletions.",
      "pattern": "^[ACGTNRYSWKMBDHV]*$",
      "type": "string"
    },
    "Reply_SequenceLocation": {
      "description": "An interbase interval on one versioned sequence accession.",
      "properties": {
        "sequence": {
          "$ref": "#/$defs/Reply_Accession",
          "description": "Versioned source sequence, without an inferred genome build."
        },
        "span": {
          "$ref": "#/$defs/Reply_Span0",
          "description": "Zero-based half-open bounds."
        }
      },
      "required": [
        "sequence",
        "span"
      ],
      "type": "object"
    },
    "Reply_Source": {
