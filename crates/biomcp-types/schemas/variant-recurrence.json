    "Reply_VariantRecurrence": {
      "description": "Exact-allele observations confined to one explicitly bounded source page.",
      "properties": {
        "all_pages_read": {
          "description": "True only when this invocation read the whole gene query from its first page.",
          "type": "boolean"
        },
        "entrez_gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_NcbiGeneId"
            },
            {
              "type": "null"
            }
          ],
          "description": "HGNC-resolved gene query bound."
        },
        "examined_rows": {
          "description": "Number of source mutation rows examined on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Variant"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-qualified resolved identity; omitted when resolution failed."
        },
        "matching_granularity": {
          "$ref": "#/$defs/Reply_RecurrenceGranularity",
          "default": "exact-genomic-allele",
          "description": "Genomic allele equality only, never a protein, residue or gene match."
        },
        "more": {
          "description": "Source has further rows or cannot yet establish its end.",
          "type": "boolean"
        },
        "observed_sample_count": {
          "description": "Distinct exact-matched samples on this source page only; absent on failure.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "selected_sample_count": {
          "description": "Sample-list size as stated by that source; never an assayed denominator.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "study": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_RecurrenceStudy"
            },
            {
              "type": "null"
            }
          ],
          "description": "Study title, citation and description kept as the source states them."
        },
        "terms": {
          "$ref": "#/$defs/Reply_RecurrenceTerms",
          "description": "Study-specific reuse restrictions require verification even for public data."
        }
      },
      "required": [
        "examined_rows",
        "all_pages_read",
        "more",
        "terms"
      ],
      "type": "object"
    },
    "Reply_VariantRecurrenceQuery": {
      "description": "Observe exact-allele samples within one caller-selected source page.",
      "properties": {
        "gene": {
          "$ref": "#/$defs/Reply_GeneSymbol",
          "description": "HGNC symbol resolved to the source's Entrez gene identifier."
        },
        "input": {
          "$ref": "#/$defs/Reply_VariantInput",
          "description": "Published variant identity; ambiguous identities are never selected silently.",
          "x-positional": 0
        },
        "limit": {
          "default": 10,
          "description": "Source mutation rows per page, including excluded alleles.",
          "format": "uint32",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "page": {
