{
  "$defs": {
    "Curie": {
      "description": "Checked prefix:local ontology identifier.",
      "pattern": "^[A-Za-z0-9_.-]+:[^:/\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f][^:\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f]*$",
      "type": "string"
    },
    "GeneInput": {
      "description": "An input classified before source resolution; aliases remain free text.",
      "pattern": "^[\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*(?:HGNC:(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})|ENSG[0-9]{11}(\\.(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))?|(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})|(?!(?:[Hh][Gg][Nn][Cc]:|[Ee][Nn][Ss][Gg]))(?![0-9]+[\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*$)[^\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](?:[\\s\\S]*[^\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])?)[\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*$",
      "type": "string"
    },
    "NciBiomarkerUse": {
      "description": "NCI's native biomarker eligibility criterion, without clinical interpretation.",
      "enum": [
        "inclusion",
        "exclusion"
      ],
      "type": "string"
    },
    "NcitId": {
      "description": "A native NCI Thesaurus concept code.",
      "pattern": "^C[0-9]+$",
      "type": "string"
    },
    "NctId": {
      "description": "Canonical ClinicalTrials.gov identifier.",
      "pattern": "^NCT(?!00000000)[0-9]{8}$",
      "type": "string"
    },
    "PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "SponsorType": {
      "description": "Registry funding category facet.",
      "enum": [
        "nih",
        "fed",
        "industry",
        "other"
      ],
      "type": "string"
    },
    "StudyType": {
      "description": "Source-native registry value.",
      "enum": [
        "INTERVENTIONAL",
        "OBSERVATIONAL",
        "EXPANDED_ACCESS"
      ],
      "type": "string"
    },
    "Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    },
    "TrialPhaseFilter": {
      "enum": [
        "early-1",
        "1",
        "2",
        "3",
        "4",
        "not-applicable",
        "1/2",
        "2/3",
        "NA",
        "0",
        "I",
        "I_II",
        "II",
        "II_III",
        "III",
        "IV"
      ],
      "type": "string"
    },
    "TrialSex": {
      "description": "Source-native registry value.",
      "enum": [
        "ALL",
        "FEMALE",
        "MALE"
      ],
      "type": "string"
    },
    "TrialSource": {
      "description": "Independent trial providers; results are never folded or used as fallbacks.",
      "enum": [
        "ctgov",
        "nci"
      ],
      "type": "string"
    },
    "TrialStatusFilter": {
      "enum": [
        "ACTIVE_NOT_RECRUITING",
        "COMPLETED",
        "ENROLLING_BY_INVITATION",
        "NOT_YET_RECRUITING",
        "RECRUITING",
        "SUSPENDED",
        "TERMINATED",
        "WITHDRAWN",
        "AVAILABLE",
        "NO_LONGER_AVAILABLE",
        "TEMPORARILY_NOT_AVAILABLE",
        "APPROVED_FOR_MARKETING",
        "WITHHELD",
        "UNKNOWN",
        "Active",
        "Administratively Complete",
        "Approved",
        "Closed to Accrual",
        "Closed to Accrual and Intervention",
        "Complete",
        "INACTIVE",
        "Enrolling by Invitation",
        "Temporarily Closed to Accrual",
        "Temporarily Closed to Accrual and Intervention",
        "Withdrawn"
      ],
      "type": "string"
    }
  },
  "$id": "biomcp.trial-search/6",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Search ClinicalTrials.gov or keyed NCI with native counts. NCI --facility matches exact organization names; a listed site is not necessarily enrolling.",
  "properties": {
    "age": {
      "description": "Age in years; unstated source bounds count as no limit.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "biomarker_code": {
      "$ref": "#/$defs/NcitId",
      "description": "Exact NCIt biomarker concept listed by NCI in trial criteria; NCI source only. This listing does not establish biomarker positivity or patient eligibility."
    },
    "biomarker_use": {
      "$ref": "#/$defs/NciBiomarkerUse",
      "description": "Filter by NCI's native inclusion or exclusion criterion. Check each result's biomarker entry and reported problems."
    },
    "condition": {
      "description": "Condition alternatives joined with OR; NCI requires NCIt codes.",
      "items": {
        "$ref": "#/$defs/Text"
      },
      "maxItems": 5,
      "type": "array"
    },
    "condition_id": {
      "$ref": "#/$defs/Curie",
      "description": "Exact MONDO or DOID CURIE resolved by MyDisease; NCI also accepts explicit NCIT:C codes."
    },
    "count_only": {
      "description": "Source total only; no returned study rows.",
      "type": "boolean"
    },
    "country": {
      "description": "Exact ClinicalTrials.gov country label; repeat for OR. Trials must list a site in a named country. NCI uses its native country filter.",
