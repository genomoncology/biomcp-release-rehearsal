    },
    "criteria": {
      "$ref": "#/$defs/Text",
      "description": "Search literal registry eligibility text for discovery only; no eligibility judgment."
    },
    "distance": {
      "$ref": "#/$defs/Text",
      "description": "Source distance with explicit mi or km units."
    },
    "exact_condition": {
      "description": "Ask ClinicalTrials.gov to restrict matching to the registered condition phrase; its support is partial.",
      "type": "boolean"
    },
    "facility": {
      "$ref": "#/$defs/Text",
      "description": "Facility phrase; ClinicalTrials.gov broadens after zero exact matches. NCI matches exact names. Cannot combine with radius."
    },
    "gene": {
      "$ref": "#/$defs/GeneInput",
      "description": "Resolve one checked gene for registry text discovery only; no eligibility judgment."
    },
    "has_results": {
      "description": "Require posted source results.",
      "type": "boolean"
    },
    "id": {
      "$ref": "#/$defs/NctId",
      "description": "Exact NCT identity in a conjunction with other filters."
    },
    "intervention": {
      "description": "Intervention alternatives joined with OR; supported by ClinicalTrials.gov.",
      "items": {
        "$ref": "#/$defs/Text"
      },
      "maxItems": 5,
      "type": "array"
    },
    "keyword": {
      "description": "Repeat for ClinicalTrials.gov general text alternatives joined with OR; different filters combine with AND. NCI accepts one keyword.",
      "items": {
        "$ref": "#/$defs/Text"
      },
      "maxItems": 5,
      "type": "array"
    },
    "lat": {
      "$ref": "#/$defs/Text",
      "description": "Radius center latitude in degrees."
    },
    "limit": {
      "default": 10,
      "description": "Headers per page; NCI applies its own lower publisher limit.",
      "format": "uint32",
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "lon": {
      "$ref": "#/$defs/Text",
      "description": "Radius center longitude in degrees."
    },
    "next_page": {
      "$ref": "#/$defs/Text",
      "description": "Opaque registry continuation; keep filters unchanged."
    },
    "offset": {
      "default": 0,
      "description": "Zero-based offset of the first row in this continuation page.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "phase": {
      "$ref": "#/$defs/TrialPhaseFilter",
      "description": "Exact source phase. ClinicalTrials.gov: 1, 2, 3, 4, early-1, not-applicable, 1/2, 2/3. NCI: NA, 0, I, I_II, II, II_III, III, IV."
    },
    "query": {
      "$ref": "#/$defs/Text",
      "description": "General registry discovery text.",
      "x-positional": 0
    },
    "sex": {
      "$ref": "#/$defs/TrialSex",
      "description": "Registry sex facet."
    },
    "source": {
      "$ref": "#/$defs/TrialSource",
      "description": "Explicit provider; defaults to ClinicalTrials.gov and never falls back."
    },
    "sponsor": {
      "$ref": "#/$defs/Text",
      "description": "Sponsor name; ClinicalTrials.gov broadens after zero exact matches. Use --sponsor-type for the funding category."
    },
    "sponsor_type": {
      "$ref": "#/$defs/SponsorType",
      "description": "Registry sponsor funding category; use --sponsor for a sponsor name."
    },
    "status": {
      "$ref": "#/$defs/TrialStatusFilter",
      "description": "Exact source status. NCI: Active, Administratively Complete, Approved, Closed to Accrual, Closed to Accrual and Intervention, Complete, INACTIVE, Enrolling by Invitation, Temporarily Closed to Accrual, Temporarily Closed to Accrual and Intervention, Withdrawn. ClinicalTrials.gov uses registry labels."
    },
    "study_type": {
      "$ref": "#/$defs/StudyType",
      "description": "Exact registry study type."
    },
    "updated_since": {
      "$ref": "#/$defs/PartialDate",
      "description": "First included registry update date."
    },
    "updated_until": {
      "$ref": "#/$defs/PartialDate",
      "description": "Last included registry update date."
    },
    "variant": {
      "$ref": "#/$defs/Text",
      "description": "Literal variant text for registry discovery only; no eligibility judgment."
    }
  },
  "title": "TrialSearch",
  "type": "object"
}
