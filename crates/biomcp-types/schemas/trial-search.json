    "criteria": {
      "$ref": "#/$defs/Text",
      "description": "Criteria text.\nClinicalTrials.gov only: search exact registry eligibility text for discovery; no eligibility judgment."
    },
    "distance": {
      "$ref": "#/$defs/Text",
      "description": "Radius, mi or km.\nClinicalTrials.gov only: source distance with explicit mi or km units."
    },
    "exact_condition": {
      "description": "Exact condition.\nAsk ClinicalTrials.gov to restrict matching to the registered condition phrase; its support is partial.",
      "type": "boolean"
    },
    "exact_term": {
      "description": "Search typed treatment terms without resolving their other names.",
      "type": "boolean"
    },
    "facility": {
      "$ref": "#/$defs/Text",
      "description": "Facility.\nFacility phrase; ClinicalTrials.gov broadens after zero exact matches. NCI matches exact names. Cannot combine with radius."
    },
    "gene": {
      "$ref": "#/$defs/GeneInput",
      "description": "Gene symbol/ID.\nClinicalTrials.gov only: resolve one checked gene for registry text discovery; no eligibility judgment."
    },
    "has_results": {
      "description": "Posted results.\nClinicalTrials.gov only: require posted source results.",
      "type": "boolean"
    },
    "id": {
      "$ref": "#/$defs/NctId",
      "description": "NCT identifier.\nClinicalTrials.gov only: exact NCT identity in a conjunction with other filters."
    },
    "intervention": {
      "description": "Treatment terms; OR.\nIntervention alternatives joined with OR; supported by ClinicalTrials.gov.",
      "items": {
        "$ref": "#/$defs/Text"
      },
      "maxItems": 5,
      "type": "array"
    },
    "keyword": {
      "description": "Text; OR.\nRepeat for ClinicalTrials.gov general text alternatives joined with OR; different filters combine with AND. NCI accepts one keyword.",
      "items": {
        "$ref": "#/$defs/Text"
      },
      "maxItems": 5,
      "type": "array"
    },
    "lat": {
      "$ref": "#/$defs/Text",
      "description": "Latitude degrees.\nClinicalTrials.gov only: radius center latitude in degrees."
    },
    "limit": {
      "default": 10,
      "description": "Page size.\nHeaders per page; NCI applies its own lower publisher limit.",
      "format": "uint32",
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "lon": {
      "$ref": "#/$defs/Text",
      "description": "Longitude degrees.\nClinicalTrials.gov only: radius center longitude in degrees."
    },
    "next_page": {
      "$ref": "#/$defs/Text",
      "description": "Page token.\nOpaque registry continuation; keep filters unchanged."
    },
    "offset": {
      "default": 0,
      "description": "Page offset.\nZero-based offset of the first row in this continuation page.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "phase": {
      "$ref": "#/$defs/TrialPhaseFilter",
      "description": "Native phase; biomcp_help search trial\nNative phase.\nExact source phase. ClinicalTrials.gov: 1, 2, 3, 4, early-1, not-applicable, 1/2, 2/3. NCI: NA, 0, I, I_II, II, II_III, III, IV."
    },
    "query": {
      "$ref": "#/$defs/Text",
      "description": "Trial text.\nGeneral registry discovery text.",
      "x-positional": 0
    },
    "sex": {
      "$ref": "#/$defs/TrialSex",
      "description": "ClinicalTrials.gov only: registry sex facet; biomcp_help search trial\nClinicalTrials.gov only: registry sex facet."
    },
    "source": {
      "$ref": "#/$defs/TrialSource",
      "description": "clinicaltrials/nci; biomcp_help search trial\nclinicaltrials/nci.\nExplicit provider; defaults to ClinicalTrials.gov and never falls back."
    },
    "sponsor": {
      "$ref": "#/$defs/Text",
      "description": "Sponsor.\nClinicalTrials.gov only: sponsor name; broadens after zero exact matches. Use --sponsor-type for the funding category."
    },
    "sponsor_type": {
      "$ref": "#/$defs/SponsorType",
      "description": "Funding class; biomcp_help search trial\nFunding class.\nClinicalTrials.gov only: registry sponsor funding category; use --sponsor for a sponsor name."
    },
    "status": {
      "$ref": "#/$defs/TrialStatusFilter",
      "description": "Native status; biomcp_help search trial\nNative status.\nExact source status. NCI: Active, Administratively Complete, Approved, Closed to Accrual, Closed to Accrual and Intervention, Complete, INACTIVE, Enrolling by Invitation, Temporarily Closed to Accrual, Temporarily Closed to Accrual and Intervention, Withdrawn. ClinicalTrials.gov uses registry labels."
    },
    "study_type": {
      "$ref": "#/$defs/StudyType",
      "description": "Study type; biomcp_help search trial\nStudy type.\nClinicalTrials.gov only: exact registry study type."
    },
    "updated_since": {
      "$ref": "#/$defs/PartialDate",
      "description": "First date.\nClinicalTrials.gov only: first included registry update date."
    },
    "updated_until": {
      "$ref": "#/$defs/PartialDate",
      "description": "Last date.\nClinicalTrials.gov only: last included registry update date."
    },
    "variant": {
      "$ref": "#/$defs/Text",
      "description": "Variant text.\nClinicalTrials.gov only: literal variant text for registry discovery; no eligibility judgment."
    }
  },
  "title": "TrialSearch",
  "type": "object"
}
