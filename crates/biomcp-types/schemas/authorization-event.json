{
  "$defs": {
    "Reply_Attribution": {
      "description": "Provenance for one source record.",
      "properties": {
        "approved": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source approval date."
        },
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "published": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source publication date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "Reply_AuthorizationDate": {
      "description": "A native date kept with its original role.",
      "properties": {
        "date": {
          "$ref": "#/$defs/Reply_PartialDate",
          "description": "Source date at its stated precision."
        },
        "role": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Native date role, without assigning approval meaning."
        }
      },
      "required": [
        "role",
        "date"
      ],
      "type": "object"
    },
    "Reply_DrugId": {
      "description": "A published native drug record identifier, without a consumer source prefix.",
      "pattern": "^(?:[A-Z][A-Z0-9_.-]*:)?[A-Za-z0-9][A-Za-z0-9_.-]*(/[A-Za-z0-9_.-]+)*$",
      "type": "string"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    }
  },
  "$id": "biodata.authorization-event/4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A source-scoped regulator event; never an identity-card field.",
  "properties": {
    "attribution": {
      "$ref": "#/$defs/Reply_Attribution",
      "description": "One source record and its native provenance."
    },
    "dates": {
      "description": "All native dates with separate roles.",
      "items": {
        "$ref": "#/$defs/Reply_AuthorizationDate"
      },
      "type": "array"
    },
    "indication": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Original indication scope when present."
    },
    "jurisdiction": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Jurisdiction explicitly stated by the source."
    },
    "kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Original native event type."
    },
    "product_number": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Explicit native product number, never a synthesized first product."
    },
    "record": {
      "$ref": "#/$defs/Reply_DrugId",
      "description": "Native regulator record identifier."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Original source status; historical positives imply no current status."
    }
  },
  "required": [
    "record",
    "attribution"
  ],
  "title": "AuthorizationEvent",
  "type": "object"
}
