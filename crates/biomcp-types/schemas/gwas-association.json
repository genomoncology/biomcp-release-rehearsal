{
  "$defs": {
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_FiniteNumber": {
      "description": "A finite decimal that JSON can represent without losing its value to null.",
      "format": "double",
      "type": "number"
    },
    "Reply_GwasAssociation": {
      "description": "Source association with unchanged trait and effect labels.",
      "properties": {
        "alleles": {
          "description": "Every source effect allele paired with its rsID.",
          "items": {
            "$ref": "#/$defs/Reply_GwasEffectAllele"
          },
          "type": "array"
        },
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source author attribution, without local publication inference."
        },
        "beta": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source beta text, including units and direction."
        },
        "ci_lower": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_FiniteNumber"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source lower effect interval bound."
        },
        "ci_upper": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_FiniteNumber"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source upper effect interval bound."
        },
        "exact_p_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_ScientificPValue"
            },
            {
              "type": "null"
            }
          ],
          "description": "Authoritative exact source probability, including double underflow."
        },
        "id": {
          "$ref": "#/$defs/Reply_GwasAssociationId",
          "description": "Native association identity."
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source effect interval."
        },
        "locations": {
          "description": "Native mapping location strings; no assumed assembly or coordinate conversion.",
          "items": {
            "$ref": "#/$defs/Reply_Text"
          },
          "type": "array"
        },
        "mapped_genes": {
          "description": "Original native mapped gene context; reported genes remain in loci.",
          "items": {
            "$ref": "#/$defs/Reply_Text"
          },
          "type": "array"
        },
        "odds_ratio": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_FiniteNumber"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source odds ratio."
        },
        "ontology_traits": {
          "description": "Source mapped trait identifiers and whole labels, without clinical inference.",
          "items": {
            "$ref": "#/$defs/Reply_GwasTrait"
          },
          "type": "array"
        },
        "p_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_FiniteNumber"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reported p value."
        },
        "publication": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source publication identifier."
        },
        "risk_frequency": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source allele frequency text, without interpreting NR."
        },
        "study": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Study accession."
        },
        "traits": {
          "description": "Source reported traits.",
          "items": {
            "$ref": "#/$defs/Reply_Text"
          },
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Reply_GwasAssociationCard": {
      "description": "Exact association card; no second association representation.",
      "properties": {
        "association": {
          "$ref": "#/$defs/Reply_GwasAssociation",
          "description": "The shared source association record."
        }
      },
      "required": [
        "association"
      ],
      "type": "object"
    },
    "Reply_GwasAssociationId": {
      "description": "A positive Catalog association ID qualified by resource kind.",
      "pattern": "^association:(?:18446744073709551615|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_GwasAssociationSection": {
      "description": "Association-only section.",
      "enum": [
        "loci"
      ],
      "type": "string",
      "x-enum-descriptions": [
        "Native locus and reported gene context."
      ]
    },
    "Reply_GwasEffectAllele": {
      "description": "Catalog effect allele paired with its exact rsID.",
      "properties": {
        "allele": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source allele text."
        },
        "rs_id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Source rsID."
        }
      },
      "required": [
        "rs_id"
      ],
      "type": "object"
    },
    "Reply_GwasGet": {
      "description": "Explicit resource sum; impossible section and identity pairings fail during decoding.",
      "oneOf": [
        {
          "description": "Read an association.",
          "properties": {
            "id": {
              "$ref": "#/$defs/Reply_GwasAssociationId",
              "description": "Qualified positive association identity."
            },
            "kind": {
              "const": "association",
              "type": "string"
            },
            "section": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Reply_GwasAssociationSection"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional native locus section."
            },
            "section_limit": {
              "default": 3,
              "description": "Maximum native rows.",
              "format": "uint32",
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            },
            "section_offset": {
              "default": 0,
              "description": "Rows to skip in this relation.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "snapshot": {
              "$ref": "#/$defs/Reply_Text",
              "description": "Retained ancestry reply for local pages without provider access."
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "Read a study.",
          "properties": {
            "id": {
              "$ref": "#/$defs/Reply_GwasStudyId",
              "description": "Exact Catalog accession."
            },
            "kind": {
              "const": "study",
              "type": "string"
            },
            "section": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Reply_GwasStudySection"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional study relation section."
            },
            "section_limit": {
              "default": 3,
              "description": "Maximum native rows.",
              "format": "uint32",
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            },
            "section_offset": {
              "default": 0,
              "description": "Rows to skip in this relation.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "snapshot": {
              "$ref": "#/$defs/Reply_Text",
              "description": "Retained ancestry reply for local pages without provider access."
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "Reply_GwasStudyId": {
      "description": "Exact Catalog study accession; case and leading zeros survive.",
      "pattern": "^GCST(?=[0-9]{6,}$)[0-9]*[1-9][0-9]*$",
      "type": "string"
    },
    "Reply_GwasStudySection": {
      "description": "Study-only sections.",
      "enum": [
        "associations",
        "ancestries"
      ],
      "type": "string",
      "x-enum-descriptions": [
        "Shared association rows.",
        "Independent native ancestry rows."
      ]
    },
    "Reply_GwasTrait": {
      "description": "Source ontology mapping as supplied by GWAS Catalog.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Exact source ontology identifier spelling."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whole source trait label."
        },
        "namespace": {
          "$ref": "#/$defs/Reply_IdentifierNamespace",
          "description": "Native authority; unknown means the source did not state one."
        }
      },
      "required": [
        "namespace",
        "id"
      ],
      "type": "object",
      "x-identifier": true
    },
    "Reply_IdentifierNamespace": {
      "description": "A source-stated authority or an explicit unknown authority, represented by the string unknown.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "Reply_ScientificPValue": {
      "description": "Exact normalized scientific p value; no floating-point conversion is used.",
      "properties": {
        "exponent": {
          "description": "Source base-ten exponent; values below the double range remain exact.",
          "format": "int64",
          "maximum": 0,
          "type": "integer"
        },
        "mantissa": {
          "description": "Source mantissa spelling, including significant trailing zeros.",
          "pattern": "^[1-9](\\.[0-9]+)?$",
          "type": "string"
        }
      },
      "required": [
        "mantissa",
        "exponent"
      ],
      "type": "object"
    },
    "Reply_Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "type": "string",
      "x-enum-descriptions": [
