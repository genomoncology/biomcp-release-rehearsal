{
  "$defs": {
    "Reply_ArticleHeader": {
      "description": "Citation metadata from PubMed or Europe PMC.",
      "properties": {
        "author_count": {
          "description": "Whole source author count.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Publication date at source precision."
        },
        "doi": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Doi"
            },
            {
              "type": "null"
            }
          ],
          "description": "Checked DOI, when supplied."
        },
        "electronic_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Electronic publication date when different from the publication date."
        },
        "europepmc_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_EuropePmcId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Europe PMC source-local identity."
        },
        "first_author": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "First author in source order."
        },
        "first_author_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_SemanticScholarAuthorId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact Semantic Scholar ID for the displayed native first author, when supplied."
        },
        "journal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Journal name."
        },
        "pmcid": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Pmcid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Checked PMC identity, when supplied."
        },
        "pmid": {
          "$ref": "#/$defs/Reply_Pmid",
          "description": "Checked PubMed identity."
        },
        "title": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Whole source title."
        },
        "types": {
          "description": "Clinical publication types.",
          "items": {
            "$ref": "#/$defs/Reply_PublicationType"
          },
          "type": "array"
        },
        "types_unknown": {
          "description": "The provider does not supply checked publication types.",
          "type": "boolean"
        }
      },
      "required": [
        "author_count"
      ],
      "type": "object"
    },
    "Reply_AuthorCountScope": {
      "description": "Scope of source-reported bibliographic counts.",
      "enum": [
        "provider_record"
      ],
      "type": "string"
    },
    "Reply_AuthorCounts": {
      "description": "Counts describe only this provider record, never a global publication corpus.",
      "properties": {
        "citation_count": {
          "description": "Native citations to this record’s indexed papers.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "h_index": {
          "description": "Native h-index for this record’s indexed papers.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "paper_count": {
          "description": "Native indexed paper count.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "scope": {
          "$ref": "#/$defs/Reply_AuthorCountScope",
          "description": "Counts apply only to this provider record."
        }
      },
      "required": [
        "scope"
      ],
      "type": "object"
    },
    "Reply_AuthorHeader": {
      "description": "One source candidate; absent affiliations differ from an empty source collection.",
      "properties": {
        "affiliations": {
          "description": "Native affiliation labels; no employment claim.",
          "items": {
            "$ref": "#/$defs/Reply_Text"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "counts": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_AuthorCounts"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record counts when supplied."
        },
        "id": {
          "$ref": "#/$defs/Reply_AuthorId",
          "description": "Exact qualified provider record."
        },
        "name": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Source display name, never a join key."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Reply_AuthorId": {
      "description": "One provider record. Semantic Scholar emits semantic-scholar:ID. ORCID checksums are checked. Variants imply no relationship.",
      "pattern": "^(semantic-scholar:[1-9][0-9]*|orcid:[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X])$",
      "type": "string"
    },
    "Reply_AuthorLiterature": {
      "description": "Open citation evidence without inferred researcher identities or metrics.",
      "properties": {
        "identity_resolution": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Names remain separate assertions on each paper, even when spelling matches."
        },
        "papers": {
          "description": "Observed citation records, in source order.",
          "items": {
            "$ref": "#/$defs/Reply_AuthorPublication"
          },
          "type": "array"
        }
      },
      "required": [
        "identity_resolution",
        "papers"
      ],
      "type": "object"
    },
    "Reply_AuthorPage": {
      "description": "Native author candidates in provider order; search total counts only this query.",
      "properties": {
        "items": {
          "description": "Source candidates; no deduplication by display name.",
          "items": {
            "$ref": "#/$defs/Reply_AuthorHeader"
          },
          "type": "array"
        },
        "literature": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_AuthorLiterature"
            },
            {
              "type": "null"
            }
          ],
          "description": "Citation-scoped authors and papers; names never establish a person identity."
        },
        "matching_records": {
          "description": "Native matching-record total, if supplied.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Reply_AuthorPublication": {
      "description": "One paper and the author names asserted by its citation source.",
      "properties": {
        "authors": {
          "description": "All received author names, without linking equal names across papers.",
          "items": {
            "$ref": "#/$defs/Reply_Text"
          },
          "type": "array"
        },
        "paper": {
          "$ref": "#/$defs/Reply_ArticleHeader",
          "description": "Citation identity and metadata."
        }
      },
      "required": [
        "paper",
        "authors"
      ],
      "type": "object"
    },
    "Reply_AuthorSearch": {
      "description": "Literal author name query and native window; positional text maps to query.",
      "properties": {
        "limit": {
          "default": 5,
          "description": "Bounded source page size.",
          "format": "uint32",
          "maximum": 25,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Native offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Retained page identity."
        },
        "query": {
          "description": "Literal query from the positional argument.",
          "minLength": 1,
          "type": "string",
          "x-positional": 0
        },
        "source": {
          "$ref": "#/$defs/Reply_AuthorSearchSource",
          "default": "auto",
          "description": "Source; auto uses PubMed if Semantic Scholar is off.\nPubMed accepts names or topics and returns unresolved names on papers."
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "Reply_AuthorSearchSource": {
      "description": "Author identity search or open citation-author discovery.",
      "enum": [
        "semantic-scholar",
        "semanticscholar",
        "pubmed",
        "auto"
      ],
      "type": "string"
    },
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_Doi": {
      "description": "DOI preserving source spelling with ASCII-insensitive equality.",
      "pattern": "^10\\.[0-9]+/[^\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f]+$",
      "type": "string"
    },
    "Reply_EuropePmcId": {
      "description": "Europe PMC source prefix followed by its positive numeric local identifier.",
      "pattern": "^(?=.{1,64}$)[A-Z]{1,8}[0-9]*[1-9][0-9]*$",
      "type": "string"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_Pmcid": {
      "description": "Canonical PMC identifier, with an explicit namespace.",
      "pattern": "^PMC(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_Pmid": {
      "description": "Positive PubMed identifier.",
      "pattern": "^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_PublicationType": {
      "description": "Clinically meaningful PubMed publication types.",
      "type": "string",
      "x-enum-descriptions": [
        " Randomized controlled trial.",
        " Clinical trial.",
        " Phase one trial.",
        " Phase two trial.",
        " Phase three trial.",
        " Phase four trial.",
        " Meta-analysis.",
        " Systematic review.",
        " Review.",
        " Practice guideline.",
        " Guideline.",
        " Case report.",
        " Observational study.",
        " Multicenter study.",
        " Letter.",
        " Comment.",
        " Editorial.",
        " Preprint.",
        " Retracted publication.",
        " Retraction notice.",
        " Erratum."
      ],
      "x-extensible-enum": [
        "randomized-controlled-trial",
        "clinical-trial",
        "clinical-trial-phase-1",
        "clinical-trial-phase-2",
        "clinical-trial-phase-3",
        "clinical-trial-phase-4",
        "meta-analysis",
        "systematic-review",
        "review",
        "practice-guideline",
        "guideline",
        "case-report",
        "observational-study",
        "multicenter-study",
        "letter",
        "comment",
        "editorial",
        "preprint",
        "retracted-publication",
        "retraction-notice",
        "erratum"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "Reply_SemanticScholarAuthorId": {
      "description": "A checked source-local Semantic Scholar author identifier, never a person identity.",
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
