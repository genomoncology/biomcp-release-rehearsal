      },
      "type": "array"
    },
    "query": {
      "$ref": "#/$defs/Reply_AuthorSearch",
      "description": "Parsed query."
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_AuthorPage"
        },
        {
          "type": "null"
        }
      ],
      "description": "Answer when available."
    },
    "schema": {
      "const": "biomcp.author-page/5",
      "type": "string"
    },
    "sources": {
      "description": "Sources actually asked.",
      "items": {
        "$ref": "#/$defs/Reply_SourceOutcome"
      },
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/Reply_Status",
      "description": "Overall outcome."
    }
  },
  "required": [
    "schema",
    "status",
    "query"
  ],
  "title": "Envelope",
  "type": "object"
}
