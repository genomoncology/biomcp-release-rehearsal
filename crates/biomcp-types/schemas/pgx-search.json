{
  "$defs": {
    "GeneSymbol": {
      "description": "Source spelling of a gene symbol, with ASCII case-insensitive identity.",
      "pattern": "^[A-Za-z][A-Za-z0-9._/@-]{0,254}$",
      "type": "string"
    },
    "Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    }
  },
  "$id": "biomcp.pgx-search/3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Checked gene-keyed CPIC pair search. No phenotype, phase or dose is calculated.",
  "properties": {
    "cpic_level": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Literal native level, including compound levels such as B/C."
    },
    "gene": {
      "$ref": "#/$defs/GeneSymbol",
      "description": "Explicit source gene symbol."
    },
    "limit": {
      "default": 5,
      "description": "Rows per native page.",
      "format": "uint32",
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "description": "Native source offset.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "source": {
      "description": "Required CPIC source; ClinPGx is not supported for search.",
      "enum": [
        "cpic"
      ],
      "type": "string"
    }
  },
  "required": [
    "gene",
    "source"
  ],
  "title": "PgxSearch",
  "type": "object"
}
