{
  "$defs": {
    "Reply_Build": {
      "description": "The assembly stated by the source; no default is inferred.",
      "type": "string",
      "x-enum-descriptions": [
        " Genome Reference Consortium human build 37.",
        " Genome Reference Consortium human build 38."
      ],
      "x-extensible-enum": [
        "GRCh37",
        "GRCh38"
      ]
    },
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_NormalizationField": {
      "description": "A provider field name and its unchanged text.",
      "properties": {
        "field": {
          "$ref": "#/$defs/Reply_SourceText",
          "description": "Native field path or assembly label."
        },
        "value": {
          "$ref": "#/$defs/Reply_SourceText",
          "description": "Unchanged source text."
        }
      },
      "required": [
        "field",
        "value"
      ],
      "type": "object"
    },
    "Reply_NormalizationMessage": {
      "description": "Provider warning, error or informational message.",
      "properties": {
        "category": {
          "$ref": "#/$defs/Reply_SourceText",
          "description": "Native message category."
        },
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_SourceText"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native code when supplied."
        },
        "text": {
          "$ref": "#/$defs/Reply_SourceText",
          "description": "Unchanged message body, including whitespace."
        }
      },
      "required": [
        "category",
        "text"
      ],
      "type": "object"
    },
    "Reply_NormalizationResult": {
      "description": "One provider's own descriptions, messages and version metadata.",
      "properties": {
        "corrected": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_SourceText"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source corrected description, without local edits."
        },
        "mappings": {
          "description": "Mapping rows in native service order, labeled by their provider field.",
          "items": {
            "$ref": "#/$defs/Reply_NormalizationField"
          },
          "type": "array"
        },
        "messages": {
          "description": "Provider messages with original codes, text and category.",
          "items": {
            "$ref": "#/$defs/Reply_NormalizationMessage"
          },
          "type": "array"
        },
        "normalized": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_SourceText"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source normalized description, without local edits."
        },
        "outcome": {
          "$ref": "#/$defs/Reply_VariantResolution",
          "description": "Provider outcome; warning rejection remains distinct from transport failure."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "Responsible service."
        },
        "total_mappings": {
          "description": "Count before mapping pagination.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total_messages": {
          "default": 0,
          "description": "Count before provider message pagination.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "description": "Version fields exactly as returned; absent when the service states none.",
          "items": {
            "$ref": "#/$defs/Reply_NormalizationField"
          },
          "type": "array"
        }
      },
      "required": [
        "source",
        "outcome",
        "total_mappings"
      ],
      "type": "object"
    },
    "Reply_NormalizationSource": {
      "description": "Explicit normalization service selection.",
      "enum": [
        "car",
        "mutalyzer",
        "variantvalidator",
        "all"
      ],
      "type": "string"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "Reply_Source": {
