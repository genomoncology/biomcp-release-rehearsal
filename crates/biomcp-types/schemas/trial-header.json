{
  "$defs": {
    "Reply_Capped_Text": {
      "description": "A bounded list with the total before its cap was applied.",
      "properties": {
        "items": {
          "description": "References in stable source order.",
          "items": {
            "$ref": "#/$defs/Reply_Text"
          },
          "type": "array"
        },
        "total": {
          "description": "Distinct references before capping.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total"
      ],
      "type": "object"
    },
    "Reply_NctId": {
      "description": "Canonical ClinicalTrials.gov identifier.",
      "pattern": "^NCT(?!00000000)[0-9]{8}$",
      "type": "string"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    },
    "Reply_TrialPhase": {
      "description": "Source-native registry value.",
      "enum": [
        "EARLY_PHASE1",
        "PHASE1",
        "PHASE2",
        "PHASE3",
        "PHASE4",
        "NA"
      ],
      "type": "string"
    },
    "Reply_TrialStatus": {
      "description": "Publisher Status enum for OverallStatus from\n<https://clinicaltrials.gov/api/v2/studies/enums>.",
      "enum": [
        "ACTIVE_NOT_RECRUITING",
        "COMPLETED",
        "ENROLLING_BY_INVITATION",
        "NOT_YET_RECRUITING",
        "RECRUITING",
        "SUSPENDED",
        "TERMINATED",
        "WITHDRAWN",
        "AVAILABLE",
        "NO_LONGER_AVAILABLE",
        "TEMPORARILY_NOT_AVAILABLE",
        "APPROVED_FOR_MARKETING",
        "WITHHELD",
        "UNKNOWN"
      ],
      "type": "string"
    }
  },
  "$id": "biomcp.trial-header/4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Small source-attributed trial discovery record.",
  "properties": {
    "conditions": {
      "$ref": "#/$defs/Reply_Capped_Text",
      "description": "Source condition names."
    },
    "interventions": {
      "$ref": "#/$defs/Reply_Capped_Text",
      "description": "Source intervention names."
    },
    "nct_id": {
      "$ref": "#/$defs/Reply_NctId",
      "description": "Exact registry identity."
    },
    "phases": {
      "description": "Source phases; absent phases remain absent.",
      "items": {
        "$ref": "#/$defs/Reply_TrialPhase"
      },
      "type": "array"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_TrialStatus"
        },
        {
          "type": "null"
        }
      ],
      "description": "Registry overall status, absent when missing or rejected; independent of site status."
    },
    "title": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Source brief title, absent when missing or rejected."
    },
    "updated": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_PartialDate"
        },
        {
          "type": "null"
        }
      ],
      "description": "Last posted registry update, absent when missing or rejected."
    },
    "url": {
      "$ref": "#/$defs/Reply_Text",
      "description": "Publisher's canonical record URL.",
      "format": "uri"
    }
  },
  "required": [
    "nct_id",
    "conditions",
    "interventions",
    "url"
  ],
  "title": "TrialHeader",
  "type": "object"
}
