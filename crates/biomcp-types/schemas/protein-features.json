    "Reply_SourceNotice": {
      "description": "A source notice or request recovery step.",
      "oneOf": [
        {
          "description": "Source-stated spellings actually searched.",
          "properties": {
            "input": {
              "$ref": "#/$defs/Reply_Text",
              "description": "Whole caller-supplied name."
            },
            "kind": {
              "const": "drug-name-search",
              "type": "string"
            },
            "message": {
              "description": "Why the names were expanded or retained.",
              "type": "string"
            },
            "names": {
              "description": "Names actually searched; ambiguous identities retain the typed name only.",
              "items": {
                "$ref": "#/$defs/Reply_Text"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "input",
            "names",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "Local request limits, source observations and recovery guidance.",
          "properties": {
            "data_date": {
              "description": "Retained publisher dataset date, independent of acquisition and record events.",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "request-guidance",
              "type": "string"
            },
            "message": {
              "description": "Reviewed guidance; any quoted provider wording remains source data.",
              "type": "string"
            },
            "retry_after_seconds": {
              "description": "Seconds left before another source request may be admitted.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "Registered conditions lack the literal words requested in a condition search.",
          "properties": {
            "kind": {
              "const": "condition-word-mismatch",
              "type": "string"
            },
            "message": {
              "description": "The source searches several fields and can expand terms; no expansion cause is inferred.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "A checked provider answer survived a local cache failure.",
          "properties": {
            "kind": {
              "const": "cache-problem",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/Reply_CacheProblem",
              "description": "Bounded local failure without paths or database diagnostics."
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The source still has graph pages after the bounded fetch window.",
          "properties": {
            "fallback": {
              "$ref": "#/$defs/Reply_Text",
              "description": "Default-source command offering another graph view."
            },
            "kind": {
              "const": "graph-truncated",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "fallback"
          ],
          "type": "object"
        },
        {
          "description": "An empty LitVar lookup can be repeated with a caller-supplied rsID.",
          "properties": {
            "kind": {
              "const": "litvar-rsid-hint",
              "type": "string"
            },
            "message": {
              "description": "Guidance that never supplies or infers an rsID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "PubMed supplied a named ESearch warning without changing its phrases.",
          "properties": {
            "kind": {
              "const": "pubmed-warning",
              "type": "string"
            },
            "name": {
              "description": "Original provider warning name, including names added by PubMed later.",
              "type": "string"
            },
            "phrases": {
              "description": "Original provider phrases, preserving whitespace and quotes.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "PubMed did not index these words.",
          "properties": {
            "kind": {
              "const": "not-found-words",
              "type": "string"
            },
            "words": {
              "description": "Whole source words.",
              "items": {
                "$ref": "#/$defs/Reply_Text"
              },
              "type": "array"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Reply_SourceOutcome": {
      "description": "One source's outcome with source notices and request guidance.",
      "properties": {
        "count": {
          "description": "Provider matching count.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "notices": {
          "description": "Source notices and request recovery guidance.",
          "items": {
            "$ref": "#/$defs/Reply_SourceNotice"
          },
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Failure or stale-fallback reason."
        },
        "retrieved_count": {
          "description": "Number of retrieved identities.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "Asked source."
        },
        "state": {
          "$ref": "#/$defs/Reply_SourceState",
          "description": "Retained state."
        },
        "term": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact provider search term."
        },
        "terms": {
          "description": "Publisher terms name from the source registry.",
          "type": "string"
        },
        "terms_url": {
          "description": "Publisher page documenting the terms.",
          "format": "uri",
          "type": "string"
        },
        "use": {
          "$ref": "#/$defs/Reply_Use",
          "description": "Reviewed source use category; publisher terms remain authoritative."
        }
      },
      "required": [
        "source",
        "use",
        "terms",
        "terms_url",
        "state"
      ],
      "type": "object"
    },
    "Reply_SourceState": {
      "description": "State of a source actually asked by the command.",
      "enum": [
        "ok",
        "stale",
        "syncing",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "Reply_Status": {
      "description": "Overall command outcome.",
      "enum": [
        "complete",
        "partial",
        "absent",
        "failed"
      ],
      "type": "string"
    },
    "Reply_Step": {
      "description": "A command argument list spelled from a typed action.",
      "properties": {
        "args": {
          "description": "CLI and MCP arguments.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/Reply_StepKind",
          "description": "Purpose of the action."
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "Reply_StepKind": {
      "description": "Purpose of an available next command.",
      "enum": [
        "restart",
        "section",
        "sort",
        "page",
        "fresh",
        "disambiguate",
        "pivot",
        "sync",
        "key",
        "configure"
      ],
      "type": "string"
    },
    "Reply_Term": {
      "description": "A source label with explicitly supported codings in source order.",
      "properties": {
        "codings": {
          "description": "Documented framework codings.",
          "items": {
            "$ref": "#/$defs/Reply_Coding"
          },
          "type": "array"
        },
        "label": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Original label."
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "Reply_Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    },
    "Reply_UncertainSpan0": {
      "description": "Zero-based interbase span retaining uncertain boundary ranges.",
      "properties": {
        "end": {
          "$ref": "#/$defs/Reply_Bound"
        },
        "start": {
          "$ref": "#/$defs/Reply_Bound"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "Reply_UniProtFeature": {
      "description": "Shared native feature contract without source label remapping.",
      "properties": {
        "alternative": {
          "description": "Every stated alternative, without translation.",
          "items": {
            "$ref": "#/$defs/Reply_AminoAcids"
          },
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Complete source description."
        },
        "evidence": {
          "description": "All original source evidence references.",
          "items": {
            "$ref": "#/$defs/Reply_Text"
          },
          "type": "array"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native feature identifier."
        },
        "kind": {
          "$ref": "#/$defs/Reply_Term",
          "description": "Source feature label; coding only for documented exact feature types."
        },
        "original": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_AminoAcids"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source original residues, when supplied."
        },
        "protein": {
          "$ref": "#/$defs/Reply_UniProtIsoform",
          "description": "Exact source sequence identity."
        },
        "span": {
          "$ref": "#/$defs/Reply_UncertainSpan0",
          "description": "Zero-based interbase coordinates retaining uncertain ranges."
        }
      },
      "required": [
        "protein",
        "span",
        "kind"
      ],
      "type": "object"
    },
    "Reply_UniProtIsoform": {
      "description": "A stated UniProt accession with an optional positive isoform number; never imputes -1.",
      "pattern": "^([OPQ][0-9][A-Z0-9]{3}[0-9]|[A-NR-Z][0-9]([A-Z][A-Z0-9]{2}[0-9]){1,2})(-[1-9][0-9]*)?$",
      "type": "string"
    },
    "Reply_Use": {
      "description": "Reviewed source-use category, without inferring rights in individual records.",
      "enum": [
        "open",
        "attribution",
        "noncommercial",
        "licensed",
        "per-record"
      ],
      "type": "string"
    }
  },
