{
  "$defs": {
    "Reply_AcmgAmp2015Code": {
      "description": "Checked AcmgAmp2015 codes.",
      "enum": [
        "pathogenic",
        "likely_pathogenic",
        "uncertain_significance",
        "likely_benign",
        "benign"
      ],
      "type": "string"
    },
    "Reply_AminoAcids": {
      "description": "Nonempty uppercase standard residues plus U, O and X.",
      "pattern": "^[ACDEFGHIKLMNPQRSTVWYUOX]+$",
      "type": "string"
    },
    "Reply_AmpAscoCap2017LevelCode": {
      "description": "Checked AmpAscoCap2017Level codes.",
      "enum": [
        "level_a",
        "level_b",
        "level_c",
        "level_d"
      ],
      "type": "string"
    },
    "Reply_AmpAscoCap2017TierCode": {
      "description": "Checked AmpAscoCap2017Tier codes.",
      "enum": [
        "tier_i",
        "tier_ii",
        "tier_iii",
        "tier_iv"
      ],
      "type": "string"
    },
    "Reply_Attribution": {
      "description": "Provenance for one source record.",
      "properties": {
        "approved": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source approval date."
        },
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "published": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source publication date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "Reply_Bound": {
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        }
      ],
      "description": "A bounded source range; equal min and max denote an exact boundary.",
      "properties": {
        "max": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "min": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_CivicEvidenceLevelCode": {
      "description": "Source-defined CIViC evidence levels.",
      "enum": [
        "a",
        "b",
        "c",
        "d",
        "e"
      ],
      "type": "string"
    },
    "Reply_ClingenCgcVicc2022Code": {
      "description": "Checked ClingenCgcVicc2022 codes.",
      "enum": [
        "oncogenic",
        "likely_oncogenic",
        "uncertain_significance",
        "likely_benign",
        "benign"
      ],
      "type": "string"
    },
    "Reply_ClingenDosageScoreCode": {
      "enum": [
        "0",
        "1",
        "2",
        "3",
        "30",
        "40"
      ],
      "type": "string"
    },
    "Reply_ClingenGeneValidity2017Code": {
      "enum": [
        "definitive",
        "strong",
        "moderate",
        "limited",
        "disputed",
        "refuted",
        "no_known_disease_relationship"
      ],
      "type": "string"
    },
    "Reply_ClingenLowPenetrance2024Code": {
      "description": "Checked ClingenLowPenetrance2024 codes.",
      "enum": [
        "pathogenic_low_penetrance",
        "likely_pathogenic_low_penetrance",
        "established_risk_allele",
        "likely_risk_allele",
        "uncertain_risk_allele"
      ],
      "type": "string"
    },
    "Reply_ClinvarAlleleOriginCode": {
      "description": "Checked ClinVar allele origin codes.",
      "enum": [
        "germline",
        "somatic",
        "de_novo",
        "inherited",
        "maternal",
        "paternal",
        "biparental",
        "uniparental",
        "not_provided",
        "unknown"
      ],
      "type": "string"
    },
    "Reply_ClinvarClassificationCode": {
      "enum": [
        "germline",
        "somatic_clinical_impact",
        "oncogenicity"
      ],
      "type": "string"
    },
    "Reply_ClinvarReviewStatusCode": {
      "description": "Checked ClinVar review status codes.",
      "enum": [
        "practice_guideline",
        "expert_panel",
        "criteria_provided_multiple_submitters_no_conflicts",
        "criteria_provided_conflicting_classifications",
        "criteria_provided_multiple_submitters",
        "criteria_provided_single_submitter",
        "no_assertion_criteria_provided",
        "no_classification_provided",
        "no_classification_for_the_individual_variant"
      ],
      "type": "string"
    },
    "Reply_Coding": {
      "description": "A code in one explicitly named source framework.",
      "oneOf": [
        {
          "description": "ClinVar publisher review status.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_ClinvarReviewStatusCode"
            },
            "system": {
              "const": "clinvar_review_status",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "ClinVar publisher allele origin.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_ClinvarAlleleOriginCode"
            },
            "system": {
              "const": "clinvar_allele_origin",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "OncoKB oncogenicity vocabulary.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_OncokbOncogenicityCode"
            },
            "system": {
              "const": "oncokb_oncogenicity",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "OncoKB evidence levels.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_OncokbLevelCode"
            },
            "system": {
              "const": "oncokb_level",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "CIViC evidence level.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_CivicEvidenceLevelCode"
            },
            "system": {
              "const": "civic_evidence_level",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "acmg_amp_2015 vocabulary.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_AcmgAmp2015Code"
            },
            "system": {
              "const": "acmg_amp_2015",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "clingen_low_penetrance_2024 vocabulary.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_ClingenLowPenetrance2024Code"
            },
            "system": {
              "const": "clingen_low_penetrance_2024",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "amp_asco_cap_2017_tier vocabulary.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_AmpAscoCap2017TierCode"
            },
            "system": {
              "const": "amp_asco_cap_2017_tier",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "amp_asco_cap_2017_level vocabulary.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_AmpAscoCap2017LevelCode"
            },
            "system": {
              "const": "amp_asco_cap_2017_level",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "clingen_cgc_vicc_2022 vocabulary.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_ClingenCgcVicc2022Code"
            },
            "system": {
              "const": "clingen_cgc_vicc_2022",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "ClinVar classification type.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_ClinvarClassificationCode"
            },
            "system": {
              "const": "clinvar_classification_type",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "Sequence Ontology consequence or edit.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_SoCode"
            },
            "system": {
              "const": "so",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "HPO mode of inheritance.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_HpoInheritanceCode"
            },
            "system": {
              "const": "hpo",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "ClinGen gene validity.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_ClingenGeneValidity2017Code"
            },
            "system": {
              "const": "clingen_gene_validity_2017",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "ClinGen dosage score.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_ClingenDosageScoreCode"
            },
            "system": {
              "const": "clingen_dosage_score",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        }
      ]
    },
    "Reply_HpoInheritanceCode": {
      "enum": [
        "HP:0000006",
        "HP:0000007",
        "HP:0001417",
        "HP:0001427",
        "HP:0032113"
      ],
      "type": "string"
    },
    "Reply_OncokbLevelCode": {
      "description": "Source-defined OncoKB vocabulary.",
      "enum": [
        "level_1",
        "level_2",
        "level_3a",
        "level_3b",
        "level_4",
        "level_r1",
        "level_r2",
        "level_dx1",
        "level_dx2",
        "level_dx3",
        "level_px1",
        "level_px2",
        "level_px3"
      ],
      "type": "string"
    },
    "Reply_OncokbOncogenicityCode": {
      "description": "Source-defined OncoKB vocabulary.",
      "enum": [
        "oncogenic",
        "likely_oncogenic",
        "likely_neutral",
        "inconclusive",
        "resistance",
        "unknown"
      ],
      "type": "string"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_ProteinCoordinateConvention": {
      "description": "Coordinate convention on the native feature before conversion.",
      "enum": [
        "one_based_inclusive"
      ],
      "type": "string"
    },
    "Reply_ProteinFeature": {
      "description": "UniProt feature with source attribution and coordinate provenance.",
      "properties": {
        "attribution": {
          "$ref": "#/$defs/Reply_Attribution",
          "description": "Source record and release facts."
        },
        "feature": {
          "$ref": "#/$defs/Reply_UniProtFeature",
          "description": "Shared feature, including native label and residues."
        },
        "source_coordinates": {
          "$ref": "#/$defs/Reply_ProteinCoordinateConvention",
          "description": "Convention before mathematical conversion."
        }
      },
      "required": [
        "feature",
        "attribution",
        "source_coordinates"
      ],
      "type": "object"
    },
    "Reply_ProteinFeatures": {
      "description": "Native UniProt feature rows, preserving exact labels and uncertain bounds.",
      "properties": {
        "items": {
          "description": "Whole native rows in source order; totals apply only to this collection.",
          "items": {
            "$ref": "#/$defs/Reply_ProteinFeature"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Reply_ProteinFeaturesQuery": {
      "description": "Page five native UniProt features by exact type and displayed residue. No variant effect or clinical meaning is inferred; no bioinformatics tool runs.",
      "properties": {
        "accession": {
          "$ref": "#/$defs/Reply_UniProtIsoform",
          "description": "Exact source protein sequence identity.",
          "x-positional": 0
        },
        "limit": {
          "default": 5,
          "description": "Five rows by default, at most 25.",
          "format": "uint32",
          "maximum": 25,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Native or retained page offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Retained collection identity."
        },
        "position": {
          "description": "Native one-based residue; zero fails during deserialization.",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Exact UniProt native label, without an alias map."
        }
      },
      "required": [
        "accession"
      ],
      "type": "object"
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "Reply_SoCode": {
      "enum": [
        "SO:0001819",
        "SO:0001624",
        "SO:0001574",
        "SO:0001575",
        "SO:0001630",
        "SO:0001627",
        "SO:0001623",
        "SO:0001587",
        "SO:0001583",
        "SO:0001822",
        "SO:0001821",
        "SO:0001589",
        "SO:0001578",
        "SO:0001619",
        "SO:1000002",
        "SO:0000159",
        "SO:0000667",
        "SO:1000035",
        "SO:1000036",
        "SO:1000032",
        "SO:0002073"
      ],
      "type": "string"
    },
