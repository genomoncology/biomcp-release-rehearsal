{
  "$defs": {
    "Reply_AdverseEventAggregate": {
      "description": "Source-native aggregation of matching FAERS reports.",
      "enum": [
        "reactions"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Exact reaction-term buckets from openFDA; reports may contribute to several terms."
      ]
    },
    "Reply_AdverseEventSearch": {
      "description": "Search five report headers by default. MAUDE accepts device text or a manufacturer, product-code or problem filter. One report may list several devices; filters may match different devices. VAERS accepts MMR, COVID19, COVID-19 vaccine or one exact qualified native influenza code, matched without case; use influenza to list codes and labels. Tables remain separate and are never summed. One report may list several vaccines. VAERS returns five reported symptom rows by default; seriousness and age select independent tables. Counts are reports, not people. Reports do not show that a vaccine caused an event and cannot measure risk or compare vaccine safety.",
      "properties": {
        "aggregate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_AdverseEventAggregate"
            },
            {
              "type": "null"
            }
          ],
          "description": "FAERS reaction counts.\nUse reactions for source-native count buckets across matching reports. Counts are not rates or causal associations; a report may contribute to several terms. Requires MedDRA and offset zero.",
          "x-required-component": "meddra"
        },
        "drug": {
          "description": "FAERS drug names; OR.\nFAERS literal drug name; repeat --drug for OR. A standalone OR joining names inside one --drug value is refused. Other filters AND with the names. BioMCP caps the escaped native query, including filters, at FAERS_QUERY_MAX_BYTES (4096 bytes).",
          "items": {
            "$ref": "#/$defs/Reply_Text"
          },
          "type": "array"
        },
        "expand_drug_names": {
          "description": "FAERS only: explicitly search bounded source-stated aliases; literal search remains the default.",
          "type": "boolean"
        },
        "limit": {
          "default": 5,
          "description": "Native report headers, counted FAERS reaction terms or VAERS rows; default five.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "manufacturer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "MAUDE manufacturer.\nMAUDE manufacturer phrase on device.manufacturer_d_name. A report may list several devices; filters may match different devices.",
          "x-required-component": "gmdn"
        },
        "name_snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Retained FAERS name resolution; follow the returned command without changing filters."
        },
        "offset": {
          "default": 0,
          "description": "Native report row offset; reaction counts require zero. VAERS needs its snapshot.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "problem": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "MAUDE product problem.\nMAUDE phrase on native product_problems.",
          "x-required-component": "gmdn"
        },
        "product_code": {
          "description": "MAUDE product codes; OR.\nMAUDE exact native device.device_report_product_code; repeated codes join with OR.",
          "items": {
            "$ref": "#/$defs/Reply_Text"
          },
          "type": "array",
          "x-required-component": "gmdn"
        },
        "reaction": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "FAERS MedDRA phrase.\nFAERS MedDRA term phrase match, not exact equality.",
          "x-required-component": "meddra"
        },
        "received_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "First date, YYYY-MM[-DD].\nInclusive FAERS or MAUDE FDA receipt lower bound, YYYY-MM-DD or YYYY-MM; a month starts on its first day.",
          "format": "date"
        },
        "received_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last date, YYYY-MM[-DD].\nInclusive FAERS or MAUDE FDA receipt upper bound, YYYY-MM-DD or YYYY-MM; a month ends on its last day.",
          "format": "date"
        },
        "section": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_VaersSection"
            },
            {
              "type": "null"
            }
          ],
          "description": "Independent VAERS table; omitted means reported symptoms.",
          "title": "VAERS table.",
          "x-positional": 1
        },
        "serious": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_AdverseEventSerious"
            },
            {
              "type": "null"
            }
          ],
          "description": "FAERS seriousness flag.\nFAERS report flag: any uses the source seriousness flag; the specific flags can overlap. Never a reaction outcome."
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "VAERS snapshot.\nRetained VAERS table for provider-free continuation."
        },
        "source": {
          "$ref": "#/$defs/Reply_AdverseEventSource",
          "default": "faers",
          "description": "Source; default FAERS.\nFAERS by default; VAERS accepts only exact supported vaccine names.",
          "x-required-components": {
            "maude": "gmdn"
          }
        },
        "text": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Drug, device or vaccine.\nLiteral drug text, MAUDE device phrase or exact supported VAERS vaccine.",
          "x-positional": 0
        }
      },
      "type": "object"
    },
    "Reply_AdverseEventSerious": {
      "description": "Report-level seriousness filter, independent of reaction outcome.",
      "enum": [
        "any",
        "death",
        "hospitalization",
        "lifethreatening",
        "disabling",
        "congenital-anomaly",
        "other"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Native report seriousness flag.",
        " Native report death flag.",
        " Native report hospitalization flag.",
        " Native report life-threatening flag.",
        " Native report disabling flag.",
        " Native report congenital anomaly flag.",
        " Native report other serious flag."
      ]
    },
    "Reply_AdverseEventSource": {
      "description": "An explicit source; never probe the other family.",
      "enum": [
        "faers",
        "maude",
        "vaers"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Drug event reports.",
        " Device event reports.",
        " Explicit CDC WONDER vaccine aggregate tables."
      ]
    },
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
