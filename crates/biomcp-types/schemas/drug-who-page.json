{
  "$defs": {
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_DrugNameSelector": {
      "description": "One explicit ChEMBL name filter without fallback or synonym expansion.",
      "type": "string",
      "x-enum-descriptions": [
        " Match the native preferred name exactly, ignoring case.",
        " Match an explicit native synonym exactly, ignoring case."
      ],
      "x-extensible-enum": [
        "preferred",
        "synonym"
      ]
    },
    "Reply_DrugRecallClassification": {
      "description": "FDA's native recall classification, with no local ranking.",
      "type": "string",
      "x-enum-descriptions": [
        " Native Class I.",
        " Native Class II.",
        " Native Class III."
      ],
      "x-extensible-enum": [
        "Class I",
        "Class II",
        "Class III"
      ]
    },
    "Reply_DrugSearch": {
      "description": "Search one drug source. FDA drug recalls accept a name or native firm, classification, status, reason and initiation dates; counts are recall records. Other sources require a name.",
      "properties": {
        "classification": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_DrugRecallClassification"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native FDA classification; drug recalls only."
        },
        "firm": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Literal published recalling firm phrase; drug recalls only."
        },
        "initiated_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Inclusive initiation day, YYYY-MM-DD; drug recalls only."
        },
        "initiated_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Inclusive initiation day, YYYY-MM-DD; drug recalls only."
        },
        "limit": {
          "default": 10,
          "description": "Native candidate rows per page.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "name_selector": {
          "$ref": "#/$defs/Reply_DrugNameSelector",
          "description": "Explicit ChEMBL native name selector; omitted means preferred name."
        },
        "offset": {
          "default": 0,
          "description": "Native rows to skip.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "query": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Search phrase; optional for FDA drug recalls. Drugs@FDA searches brands and ingredients,\nexact names before word matches. openFDA labels search exact then word brand/generic names,\nthen label text (including indications) when no names match; source matches need not be exact names.\nHarmonized recall names match but never become display names.",
          "x-positional": 0
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Phrase in the published recall reason; drug recalls only."
        },
        "source": {
          "$ref": "#/$defs/Reply_DrugSource",
          "default": "mychem",
          "description": "Exactly one source; default MyChem never fans out."
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Literal native recall status; drug recalls only."
        }
      },
      "type": "object"
    },
    "Reply_DrugSource": {
      "description": "A supported drug data source.",
      "type": "string",
      "x-extensible-enum": [
        "who-pq",
        "fda-drug-recall",
        "mychem",
        "chembl",
        "opentargets",
        "civic",
        "openfda-label",
        "drugsfda",
        "ema",
        "ddinter"
      ]
    },
    "Reply_DrugWhoPage": {
      "description": "Source-ordered WHO matches; prequalification does not establish US/EU authorization.",
      "properties": {
        "items": {
          "description": "Bounded native rows in export order.",
          "items": {
            "$ref": "#/$defs/Reply_DrugWhoRow"
          },
          "type": "array"
        },
        "total": {
          "description": "Matching rows in the complete local snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total"
      ],
      "type": "object"
    },
    "Reply_DrugWhoRow": {
      "description": "Every published cell of one WHO finished-product record, including empty cells.",
      "properties": {
        "applicant": {
          "description": "Native Applicant wording.",
          "type": "string"
        },
        "basis_of_listing": {
          "description": "Native Basis of Listing wording.",
          "type": "string"
        },
        "date_of_prequalification": {
          "description": "Native Date of Prequalification text, including spacing and empty strings.",
          "type": "string"
        },
        "dosage_form": {
          "description": "Native Dosage Form cell, independent of the combined cell.",
          "type": "string"
        },
        "inn_dosage_form_strength": {
          "description": "Native combined INN, Dosage Form and Strength cell; never split or interpreted.",
          "type": "string"
        },
        "product_type": {
          "description": "Native Product Type, retained even when empty.",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Exact native WHO Reference Number, including spaces and punctuation."
        },
        "therapeutic_area": {
          "description": "Native Therapeutic Area wording.",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "inn_dosage_form_strength",
        "product_type",
        "therapeutic_area",
        "applicant",
        "dosage_form",
        "basis_of_listing",
        "date_of_prequalification"
      ],
      "type": "object"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "Reply_Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " WikiPathways published pathway catalogs.",
        " Human Protein Atlas.",
        " UniProt.",
        " Integrated InterPro entries.",
        " Complex Portal.",
        " gnomAD.",
        " ClinVar component source policy.",
        " ClinGen Evidence Repository.",
        " GWAS Catalog v2.",
        " ClinGen.",
        " GenCC submitter assessments.",
        " PubMed.",
        " Europe PMC.",
        " NCBI LitVar2.",
        " NCBI LitSense2.",
        " Semantic Scholar.",
        " ORCID public registry.",
        " PMC Open Access bucket.",
        " NIH iCite.",
        " PubTator.",
        " ClinicalTrials.gov.",
        " NCI Clinical Trials Search.",
        " CIViC.",
        " Cancer Hotspots residue recurrence.",
        " AlphaGenome.",
        " OncoKB.",
        " MyVariant.info aggregation.",
        " ClinGen Allele Registry.",
        " Mutalyzer.",
        " VariantValidator.",
        " MyChem.info aggregation.",
        " ChEMBL native records and carried component.",
