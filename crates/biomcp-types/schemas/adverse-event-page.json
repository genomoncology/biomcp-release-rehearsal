{
  "$defs": {
    "Reply_AdverseEventHeader": {
      "description": "Small source report header without a drug title, flattened lists or count buckets.",
      "properties": {
        "event_type": {
          "description": "Native event_type string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "first_received": {
          "description": "Native first_received string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/Reply_ReportId",
          "description": "Exact published source identity."
        },
        "serious": {
          "description": "Native serious string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/Reply_AdverseEventSource",
          "description": "Explicit report family."
        },
        "version": {
          "description": "Native version string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "source"
      ],
      "type": "object"
    },
    "Reply_AdverseEventPage": {
      "description": "Ordered report headers; totals count reports with no population denominator.",
      "properties": {
        "components": {
          "description": "Applicable component terms.",
          "items": {
            "$ref": "#/$defs/Reply_ComponentLabel"
          },
          "type": "array"
        },
        "fetched": {
          "description": "Original retrieval time in Unix seconds, absent for undated legacy recordings.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "items": {
          "description": "Native ordered report candidates.",
          "items": {
            "$ref": "#/$defs/Reply_AdverseEventHeader"
          },
          "type": "array"
        },
        "reaction_match": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_AdverseEventReactionMatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit analyzed reaction selector semantics when a reaction was supplied."
        },
        "source_query": {
          "description": "Exact literal provider expression; reaction selectors use phrase match.",
          "type": "string"
        },
        "source_updated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_SourceUpdated"
            },
            {
              "type": "null"
            }
          ],
          "description": "The publisher last_updated date, separate from retrieval."
        },
        "unit": {
          "$ref": "#/$defs/Reply_ReportUnit",
          "description": "Explicit reports unit for envelope page totals."
        }
      },
      "required": [
        "source_query",
        "unit"
      ],
      "type": "object"
    },
    "Reply_AdverseEventReactionMatch": {
      "description": "Source reaction selector matching semantics.",
      "enum": [
        "phrase-match"
      ],
      "type": "string"
    },
    "Reply_AdverseEventSearch": {
      "description": "Search five report headers by default. MAUDE accepts device text or a manufacturer, product-code or problem filter. One report may list several devices; filters may match different devices. VAERS accepts MMR, COVID19, COVID-19 vaccine or one exact qualified native influenza code, matched without case; use influenza to list codes and labels. Tables remain separate and are never summed. One report may list several vaccines. VAERS returns five reported symptom rows by default; seriousness and age select independent tables. Counts are reports, not people. Reports do not show that a vaccine caused an event and cannot measure risk or compare vaccine safety.",
      "properties": {
        "limit": {
          "default": 5,
          "description": "Native report headers or VAERS rows per page; default five.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "manufacturer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "MAUDE manufacturer phrase on device.manufacturer_d_name. A report may list several devices; filters may match different devices."
        },
        "offset": {
          "default": 0,
          "description": "Native row offset. VAERS continuation requires its retained snapshot.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "problem": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "MAUDE phrase on native product_problems."
        },
        "product_code": {
          "description": "MAUDE exact native device.device_report_product_code; repeated codes join with OR.",
          "items": {
            "$ref": "#/$defs/Reply_Text"
          },
          "type": "array"
        },
        "reaction": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "FAERS MedDRA term phrase match, not exact equality."
        },
        "received_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Inclusive FAERS or MAUDE FDA receipt lower bound, YYYY-MM-DD or YYYY-MM; a month starts on its first day.",
          "format": "date"
        },
        "received_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Inclusive FAERS or MAUDE FDA receipt upper bound, YYYY-MM-DD or YYYY-MM; a month ends on its last day.",
          "format": "date"
        },
        "section": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_VaersSection"
            },
            {
              "type": "null"
            }
          ],
          "description": "Independent VAERS table; omitted means reported symptoms.",
          "x-positional": 1
        },
        "serious": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_AdverseEventSerious"
            },
            {
              "type": "null"
            }
          ],
          "description": "FAERS report flag: any uses the source seriousness flag; the specific flags can overlap. Never a reaction outcome."
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Retained VAERS table for provider-free continuation."
        },
        "source": {
          "$ref": "#/$defs/Reply_AdverseEventSource",
          "default": "faers",
          "description": "FAERS by default; VAERS accepts only exact supported vaccine names."
        },
        "text": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Literal drug text, MAUDE device phrase or exact supported VAERS vaccine.",
          "x-positional": 0
        }
      },
      "type": "object"
    },
    "Reply_AdverseEventSerious": {
      "description": "Report-level seriousness filter, independent of reaction outcome.",
      "enum": [
        "any",
        "death",
        "hospitalization",
        "lifethreatening",
        "disabling",
        "congenital-anomaly",
        "other"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Native report seriousness flag.",
        " Native report death flag.",
        " Native report hospitalization flag.",
        " Native report life-threatening flag.",
        " Native report disabling flag.",
        " Native report congenital anomaly flag.",
        " Native report other serious flag."
      ]
    },
    "Reply_AdverseEventSource": {
      "description": "An explicit source; never probe the other family.",
      "enum": [
        "faers",
        "maude",
        "vaers"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Drug event reports.",
        " Device event reports.",
        " Explicit CDC WONDER vaccine aggregate tables."
      ]
    },
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_ComponentLabel": {
      "description": "Terms attached to a named carried component on a consumer response.",
      "properties": {
        "component": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Native component name."
        },
        "terms": {
          "$ref": "#/$defs/Reply_ComponentTerms",
          "description": "Canonical publisher terms."
        }
      },
      "required": [
        "component",
        "terms"
      ],
      "type": "object"
    },
    "Reply_ComponentTerms": {
      "description": "Terms attached to one independently licensed source component.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Publisher terms name."
        },
        "url": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Publisher terms page.",
          "format": "uri"
        },
        "usage": {
          "$ref": "#/$defs/Reply_Use",
          "description": "Publisher use category."
        }
      },
      "required": [
        "usage",
        "name",
        "url"
      ],
      "type": "object"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "Reply_ReportId": {
      "description": "Opaque published digits with source carried separately, never a prefixed wrapper.",
      "pattern": "^[0-9]+$",
      "type": "string"
    },
    "Reply_ReportUnit": {
      "description": "The count describes reports, never exposed people or causal events.",
      "enum": [
        "reports"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Native report count without a population denominator."
      ]
    },
