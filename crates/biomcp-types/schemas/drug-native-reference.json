{
  "$defs": {
    "Reply_Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    }
  },
  "$id": "biodata.drug-native-reference/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Typed source reference shared by mechanism and indication records.",
  "properties": {
    "ref_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Source reference identifier, when supplied."
    },
    "ref_type": {
      "$ref": "#/$defs/Reply_Text",
      "description": "Native reference type."
    },
    "ref_url": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Source reference link, when supplied.",
      "format": "uri"
    }
  },
  "required": [
    "ref_type"
  ],
  "title": "DrugNativeReference",
  "type": "object"
}
