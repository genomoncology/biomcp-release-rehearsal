{
  "$defs": {
    "Reply_Attribution": {
      "description": "Provenance for one source record.",
      "properties": {
        "approved": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source approval date."
        },
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "published": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source publication date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "Reply_Bound": {
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        }
      ],
      "description": "A bounded source range; equal min and max denote an exact boundary.",
      "properties": {
        "max": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "min": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_InterProId": {
      "description": "An integrated InterPro entry accession, distinct from a member signature.",
      "pattern": "^IPR[0-9]{6}$",
      "type": "string"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_ProteinDomainFragment": {
      "description": "One native match fragment after coordinate conversion.",
      "properties": {
        "dc_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Literal discontinuity status supplied by InterPro."
        },
        "span": {
          "$ref": "#/$defs/Reply_UncertainSpan0",
          "description": "Converted interbase span with uncertainty retained."
        }
      },
      "required": [
        "span"
      ],
      "type": "object"
    },
    "Reply_ProteinDomainLocation": {
      "description": "One native InterPro location group retaining all discontinuous fragments.",
      "properties": {
        "fragments": {
          "description": "All native fragments; never reduced to a min/max hull.",
          "items": {
            "$ref": "#/$defs/Reply_ProteinDomainFragment"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Reply_ProteinDomainMatch": {
      "description": "One native integrated InterPro match; not every entry type is a domain.",
      "properties": {
        "attribution": {
          "$ref": "#/$defs/Reply_Attribution",
          "description": "Source record and release facts."
        },
        "entry_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Literal source entry type, including family, site and repeat."
        },
        "id": {
          "$ref": "#/$defs/Reply_InterProId",
          "description": "Integrated entry accession, distinct from member signatures."
        },
        "locations": {
          "description": "Every native location group in source order.",
          "items": {
            "$ref": "#/$defs/Reply_ProteinDomainLocation"
          },
          "type": "array"
        },
        "member_signatures": {
          "description": "Source member signatures remain distinct from integrated entries.",
          "items": {
            "$ref": "#/$defs/Reply_ProteinMemberSignature"
          },
          "type": "array"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native integrated name."
        },
        "protein": {
          "$ref": "#/$defs/Reply_UniProtIsoform",
          "description": "Exact native protein identity."
        },
        "protein_length": {
          "description": "Source protein length when supplied.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "taxon": {
          "description": "Source taxon when supplied.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "protein",
        "attribution"
      ],
      "type": "object"
    },
    "Reply_ProteinDomains": {
      "description": "Whole native rows with the independent unfiltered source count.",
      "properties": {
        "items": {
          "description": "Bounded retained rows in source order.",
          "items": {
            "$ref": "#/$defs/Reply_ProteinDomainMatch"
          },
          "type": "array"
        },
        "native_total": {
          "description": "Native source total before type selection or exact participant admission.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "native_total"
      ],
      "type": "object"
    },
    "Reply_ProteinDomainsQuery": {
      "description": "Page five native InterPro matches with original types and fragments. No structure or clinical meaning is inferred; no bioinformatics tool runs.",
      "properties": {
        "accession": {
          "$ref": "#/$defs/Reply_UniProtIsoform",
          "description": "Exact source protein sequence identity.",
          "x-positional": 0
        },
        "limit": {
          "default": 5,
          "description": "Five rows by default, at most 25.",
          "format": "uint32",
          "maximum": 25,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Native or retained page offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Retained collection identity."
        },
        "type": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Exact native InterPro type, not a normalized domain label."
        }
      },
      "required": [
        "accession"
      ],
      "type": "object"
    },
    "Reply_ProteinMemberSignature": {
      "description": "A member database signature, not an integrated IPR entry.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Native signature accession."
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native member signature name."
        },
        "namespace": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Native member database name."
        }
      },
      "required": [
        "namespace",
        "id"
      ],
      "type": "object",
      "x-identifier": true
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
