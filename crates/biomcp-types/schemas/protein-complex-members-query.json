{
  "$defs": {
    "ComplexPortalId": {
      "description": "An exact Complex Portal accession.",
      "pattern": "^CPX-[1-9][0-9]*$",
      "type": "string"
    },
    "Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    },
    "UniProtIsoform": {
      "description": "A stated UniProt accession with an optional positive isoform number; never imputes -1.",
      "pattern": "^([OPQ][0-9][A-Z0-9]{3}[0-9]|[A-NR-Z][0-9]([A-Z][A-Z0-9]{2}[0-9]){1,2})(-[1-9][0-9]*)?$",
      "type": "string"
    }
  },
  "$id": "biomcp.protein-complex-members-query/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Page five native participants of an exact Complex Portal complex containing the anchor. No interaction or clinical meaning is inferred; no bioinformatics tool runs.",
  "properties": {
    "accession": {
      "$ref": "#/$defs/UniProtIsoform",
      "description": "Exact source protein sequence identity.",
      "x-positional": 0
    },
    "complex": {
      "$ref": "#/$defs/ComplexPortalId",
      "description": "Exact complex whose native participants contain the anchor."
    },
    "limit": {
      "default": 5,
      "description": "Five rows by default, at most 25.",
      "format": "uint32",
      "maximum": 25,
      "minimum": 1,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "description": "Native or retained page offset.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "pool": {
      "$ref": "#/$defs/Text",
      "description": "Retained collection identity."
    }
  },
  "required": [
    "accession",
    "complex"
  ],
  "title": "ProteinComplexMembersQuery",
  "type": "object"
}
