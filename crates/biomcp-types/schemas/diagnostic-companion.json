{
  "$defs": {
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_CompanionDiagnosticRelation": {
      "description": "A physical companion-table row; the two table layouts cannot acquire each other’s cells.",
      "oneOf": [
        {
          "description": "One complete native individual table row.",
          "properties": {
            "cells": {
              "$ref": "#/$defs/Reply_CompanionIndividualCells",
              "description": "Whole cells keyed by this table’s exact headers."
            },
            "device_ids": {
              "description": "Device facts from this row’s own dedicated device cell only.",
              "items": {
                "$ref": "#/$defs/Reply_DiagnosticDeviceId"
              },
              "type": "array"
            },
            "drug_applications": {
              "description": "Unambiguous typed applications owned by this row’s drug cell.",
              "items": {
                "$ref": "#/$defs/Reply_DiagnosticDrugApplication"
              },
              "type": "array"
            },
            "index": {
              "description": "Zero-based physical data-row index in its table.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "individual",
              "type": "string"
            },
            "snapshot": {
              "description": "Immutable local snapshot revision, not a publisher row ID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "snapshot",
            "index",
            "cells"
          ],
          "type": "object"
        },
        {
          "description": "One complete native group table row.",
          "properties": {
            "cells": {
              "$ref": "#/$defs/Reply_CompanionGroupCells",
              "description": "Whole cells keyed by this table’s exact headers."
            },
            "device_ids": {
              "description": "Device facts from this row’s own dedicated device cell only.",
              "items": {
                "$ref": "#/$defs/Reply_DiagnosticDeviceId"
              },
              "type": "array"
            },
            "drug_applications": {
              "description": "Unambiguous typed applications owned by this row’s drug cell.",
              "items": {
                "$ref": "#/$defs/Reply_DiagnosticDrugApplication"
              },
              "type": "array"
            },
            "index": {
              "description": "Zero-based physical data-row index in its table.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "group",
              "type": "string"
            },
            "snapshot": {
              "description": "Immutable local snapshot revision, not a publisher row ID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "snapshot",
            "index",
            "cells"
          ],
          "type": "object"
        }
      ]
    },
    "Reply_CompanionGroupCells": {
      "description": "Known native group-table cells keyed by their exact source headers.",
      "properties": {
        "Device Indication for a Specific Group of Oncology Therapeutic Products and Trade Name (Generic) – NDA/BLA": {
          "$ref": "#/$defs/Reply_DiagnosticCell",
          "description": "Complete original drug_group cell."
        },
        "Diagnostic Name\n(Manufacturer)": {
          "$ref": "#/$defs/Reply_DiagnosticCell",
          "description": "Complete original diagnostic cell."
        },
        "Indication(s) - Sample Type": {
          "$ref": "#/$defs/Reply_DiagnosticCell",
          "description": "Complete original indication cell."
        },
        "PMA (Approval Date)": {
          "$ref": "#/$defs/Reply_DiagnosticCell",
          "description": "Complete original device cell."
        }
      },
      "required": [
        "Diagnostic Name\n(Manufacturer)",
        "Indication(s) - Sample Type",
        "PMA (Approval Date)",
        "Device Indication for a Specific Group of Oncology Therapeutic Products and Trade Name (Generic) – NDA/BLA"
      ],
      "type": "object"
    },
    "Reply_CompanionIndividualCells": {
      "description": "Known native individual-table cells keyed by their exact source headers.",
      "properties": {
        "Biomarker(s)": {
          "$ref": "#/$defs/Reply_DiagnosticCell",
          "description": "Complete original biomarker cell."
        },
        "Biomarker(s) (Details)": {
          "$ref": "#/$defs/Reply_DiagnosticCell",
          "description": "Complete original details cell."
        },
        "Diagnostic Name (Manufacturer)": {
          "$ref": "#/$defs/Reply_DiagnosticCell",
          "description": "Complete original diagnostic cell."
        },
        "Drug Trade Name (Generic) NDA / BLA": {
          "$ref": "#/$defs/Reply_DiagnosticCell",
          "description": "Complete original drug cell."
        },
        "Indication - Sample Type": {
          "$ref": "#/$defs/Reply_DiagnosticCell",
          "description": "Complete original indication cell."
        },
        "PMA / 510(k) /\n513(f)(2) / HDE (Approval / Clearance / Grant Date)": {
          "$ref": "#/$defs/Reply_DiagnosticCell",
          "description": "Complete original device cell."
        }
      },
      "required": [
        "Diagnostic Name (Manufacturer)",
        "Indication - Sample Type",
        "Drug Trade Name (Generic) NDA / BLA",
        "Biomarker(s)",
        "Biomarker(s) (Details)",
        "PMA / 510(k) /\n513(f)(2) / HDE (Approval / Clearance / Grant Date)"
      ],
      "type": "object"
    },
    "Reply_DiagnosticCell": {
      "description": "Whole physical source-table cell and its own links.",
      "properties": {
        "links": {
          "description": "Only links physically owned by this cell, in native order.",
          "items": {
            "$ref": "#/$defs/Reply_DiagnosticCellLink"
          },
          "type": "array"
        },
        "text": {
          "description": "Original complete text, including empty strings and line breaks.",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "Reply_DiagnosticCellLink": {
      "description": "Source link without a name-based identity inference.",
      "properties": {
        "href": {
          "description": "Original source URL.",
          "format": "uri-reference",
          "type": "string"
        },
        "label": {
          "description": "Native label when the capture supplies one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "href"
      ],
      "type": "object"
    },
    "Reply_DiagnosticCompanion": {
      "description": "Whole distinct physical companion-table rows with cell-owned identifiers.",
      "properties": {
        "count_unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_DiagnosticCountUnit"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact meaning of the envelope total; supplied by the owning source command."
        },
        "distinct_id_total": {
          "description": "Distinct complete native IDs across the selected relation collection.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "items": {
          "description": "Complete source-owned rows in native order; envelope totals count native rows.",
          "items": {
            "$ref": "#/$defs/Reply_CompanionDiagnosticRelation"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Reply_DiagnosticCountUnit": {
      "description": "Meaning of the envelope's total for a source-owned diagnostic page.",
      "enum": [
        "recall-records",
        "device-submissions",
        "product-identities",
        "test-identities",
        "native-relation-rows",
        "native-method-entries"
      ],
      "type": "string"
    },
    "Reply_DiagnosticDeviceId": {
      "description": "Source device identifier; DEN and H identifiers imply no executable get.",
      "pattern": "^(P[0-9]{6}(/S(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2}))?|K[0-9]{6}|DEN[0-9]{6}|H[0-9]{6})$",
      "type": "string"
    },
    "Reply_DiagnosticDrugApplication": {
      "description": "A typed drug application established by its own complete source cell and link.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_FdaDrugApplication",
          "description": "Published NDA/BLA prefix and six digits."
        },
        "url": {
          "description": "The same cell’s owned source URL.",
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "id",
        "url"
      ],
      "type": "object"
    },
    "Reply_DiagnosticSearch": {
      "description": "Search five source records by default. FDA device recalls cover every medical device; totals count recall records, without harm inference.",
      "properties": {
        "biomarker": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact table-0 cell.\nExact table-0 biomarker cell; unsupported in the group table."
        },
        "bundle_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stored bundle revision.\nImmutable stored bundle revision retained by a continuation."
        },
        "condition_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact MedGen:CUI.\nExact MedGen:CUI identifier only."
        },
        "decision_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "First date, YYYY-MM-DD.\nInclusive native decision date, YYYY-MM-DD; PMA and 510(k) only."
        },
        "decision_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last date, YYYY-MM-DD.\nInclusive native decision date, YYYY-MM-DD; PMA and 510(k) only."
        },
        "device_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_DiagnosticDeviceId"
            },
            {
              "type": "null"
            }
          ],
          "description": "PMA or K identifier.\nExact PMA application, application/supplement or native K identity."
        },
        "drug_application": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_FdaDrugApplication"
            },
            {
              "type": "null"
            }
          ],
          "description": "NDA/BLA application.\nCell-owned typed NDA/BLA application."
        },
        "gene": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_GeneSymbol"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact gene symbol.\nExact source gene_symbol field, without alias expansion."
        },
        "gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_NcbiGeneId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact NCBI GeneID.\nExact source GeneID, exclusive with gene symbol."
        },
        "initiated_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "First date, YYYY-MM-DD.\nInclusive initiation date, YYYY-MM-DD; FDA device recalls only."
        },
        "initiated_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last date, YYYY-MM-DD.\nInclusive initiation date, YYYY-MM-DD; FDA device recalls only."
        },
        "limit": {
          "default": 5,
          "description": "Five results by default; at most fifty source rows or product headers.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "manufacturer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Manufacturer phrase.\nWHO manufacturer words, native FDA applicant (PMA/510(k)) or recalling_firm phrase."
        },
        "marker": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "WHO marker phrase.\nLiteral whole-word phrase in WHO's Pathogen/Disease/Marker cell."
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native device name.\nNative trade_name (PMA) or device_name (510(k)) phrase."
        },
        "offset": {
          "default": 0,
          "description": "Zero-based source result offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "product_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "FDA product code.\nExact native FDA device recall product code."
        },
        "source": {
          "$ref": "#/$defs/Reply_DiagnosticSearchSource",
          "description": "Native diagnostic source.\nExplicit native GTR, WHO IVD, FDA PMA, 510(k), companion or medical device recall discovery."
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_GtrTestType"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native test_type.\nExact native test_type value."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "Reply_DiagnosticSearchSource": {
      "description": "One explicit diagnostic discovery source.",
      "enum": [
        "gtr",
        "fda-cdx",
        "fda-pma",
        "fda-510k",
        "who-ivd",
        "fda-device-recall"
      ],
      "type": "string"
    },
    "Reply_FdaDrugApplication": {
      "description": "Cell-owned drug application preserving native NDA/BLA prefix and leading zeros.",
      "pattern": "^(NDA|BLA)[0-9]{6}$",
      "type": "string"
    },
    "Reply_GeneSymbol": {
      "description": "Source spelling of a gene symbol, with ASCII case-insensitive identity.",
      "pattern": "^[A-Za-z][A-Za-z0-9._/@-]{0,254}$",
      "type": "string"
    },
    "Reply_GtrTestType": {
      "description": "Native GTR relation test category, not an offering or authorization judgment.",
      "enum": [
        "Clinical",
        "Research",
        "Clinical microbial"
      ],
      "type": "string"
    },
    "Reply_NcbiGeneId": {
      "description": "A positive NCBI Gene identifier in canonical decimal text.",
      "pattern": "^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "Reply_Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " WikiPathways published pathway catalogs.",
        " Human Protein Atlas.",
        " UniProt.",
        " Integrated InterPro entries.",
        " Complex Portal.",
        " gnomAD.",
        " ClinVar component source policy.",
        " ClinGen Evidence Repository.",
        " GWAS Catalog v2.",
        " ClinGen.",
        " GenCC submitter assessments.",
        " PubMed.",
        " Europe PMC.",
        " NCBI LitVar2.",
        " NCBI LitSense2.",
        " Semantic Scholar.",
        " ORCID public registry.",
        " PMC Open Access bucket.",
        " NIH iCite.",
        " PubTator.",
        " ClinicalTrials.gov.",
        " NCI Clinical Trials Search.",
        " CIViC.",
        " Cancer Hotspots residue recurrence.",
        " AlphaGenome.",
        " OncoKB.",
        " MyVariant.info aggregation.",
        " ClinGen Allele Registry.",
        " Mutalyzer.",
        " VariantValidator.",
        " MyChem.info aggregation.",
        " ChEMBL native records and carried component.",
        " Open Targets.",
        " openFDA SPL labels.",
        " Drugs@FDA application records.",
        " European Medicines Agency.",
