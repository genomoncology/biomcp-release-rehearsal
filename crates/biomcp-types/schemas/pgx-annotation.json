{
  "$defs": {
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_ClinPgxAccession": {
      "description": "A ClinPGx object accession, distinct from the protein allele namespace PaId.",
      "pattern": "^PA[1-9][0-9]*$",
      "type": "string"
    },
    "Reply_FiniteNumber": {
      "description": "A finite decimal that JSON can represent without losing its value to null.",
      "format": "double",
      "type": "number"
    },
    "Reply_IdentifierNamespace": {
      "description": "A source-stated authority or an explicit unknown authority, represented by the string unknown.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    },
    "Reply_Identifier_int64": {
      "description": "An authority and its unchanged native identifier; unknown means the authority was not stated.",
      "properties": {
        "id": {
          "description": "Native identifier value, with its original scalar type and precision.",
          "format": "int64",
          "type": "integer"
        },
        "namespace": {
          "$ref": "#/$defs/Reply_IdentifierNamespace",
          "description": "Native authority spelling; the literal unknown carries an unstated authority."
        }
      },
      "required": [
        "namespace",
        "id"
      ],
      "type": "object",
      "x-identifier": true
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PgxAllelePhenotype": {
      "description": "Source-native PgxAllelePhenotype fields; no clinical interpretation.",
      "properties": {
        "allele": {
          "description": "Native `allele`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/Reply_Identifier_int64",
          "description": "Native `id`; literal source value."
        },
        "limitedEvidence": {
          "description": "Native `limitedEvidence`; literal source value.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "phenotype": {
          "description": "Native `phenotype`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Reply_PgxAnnotation": {
      "description": "Complete proved base-tier annotation.",
      "properties": {
        "annotation": {
          "$ref": "#/$defs/Reply_PgxAnnotationDetail",
          "description": "Complete native base record, including history and genotype text."
        },
        "header": {
          "$ref": "#/$defs/Reply_PgxAnnotationIdentity",
          "description": "Exact selected source identity."
        }
      },
      "required": [
        "header",
        "annotation"
      ],
      "type": "object"
    },
    "Reply_PgxAnnotationDetail": {
      "description": "Source-native PgxAnnotationDetail fields; no clinical interpretation.",
      "properties": {
        "accessionId": {
          "$ref": "#/$defs/Reply_ClinPgxAccession",
          "description": "Native `accessionId`; literal source value."
        },
        "allelePhenotypes": {
          "description": "Native `allelePhenotypes`; literal source value.",
          "items": {
            "$ref": "#/$defs/Reply_PgxAllelePhenotype"
          },
          "type": "array"
        },
        "conflictingVariantAnnotationIds": {
          "description": "Native `conflictingVariantAnnotationIds`; literal source value.",
          "items": {
            "$ref": "#/$defs/Reply_Identifier_int64"
          },
          "type": "array"
        },
        "history": {
          "description": "Native `history`; literal source value.",
          "items": {
            "$ref": "#/$defs/Reply_PgxAnnotationHistory"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/Reply_Identifier_int64",
          "description": "Native `id`; literal source value."
        },
        "levelOfEvidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PgxEvidenceTerm"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native `levelOfEvidence`; literal source value."
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PgxLocation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native `location`; literal source value."
        },
        "name": {
          "description": "Native `name`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "objCls": {
          "description": "Native `objCls`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "overrideLevel": {
          "description": "Native `overrideLevel`; literal source value.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "overrideLevelDescription": {
          "description": "Native `overrideLevelDescription` when supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "pediatric": {
          "description": "Native `pediatric`; literal source value.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "relatedAlleles": {
          "description": "Native `relatedAlleles`; literal source value.",
          "items": {
            "$ref": "#/$defs/Reply_PgxObjectReference"
          },
          "type": "array"
        },
        "relatedChemicals": {
          "description": "Native `relatedChemicals`; literal source value.",
          "items": {
            "$ref": "#/$defs/Reply_PgxObjectReference"
          },
          "type": "array"
        },
        "relatedChemicalsLogic": {
          "description": "Native `relatedChemicalsLogic`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "relatedDiseases": {
          "description": "Native `relatedDiseases`; literal source value.",
          "items": {
            "$ref": "#/$defs/Reply_PgxObjectReference"
          },
          "type": "array"
        },
        "relatedGuidelines": {
          "description": "Native `relatedGuidelines`; literal source value.",
          "items": {
            "$ref": "#/$defs/Reply_PgxObjectReference"
          },
          "type": "array"
        },
        "relatedLabels": {
          "description": "Native `relatedLabels`; literal source value.",
          "items": {
            "$ref": "#/$defs/Reply_PgxObjectReference"
          },
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_FiniteNumber"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native `score`; literal source value."
        },
        "scoreDetails": {
          "description": "Native `scoreDetails`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "types": {
          "description": "Native `types`; literal source value.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "accessionId"
      ],
      "type": "object"
    },
    "Reply_PgxAnnotationGet": {
      "description": "Exact single clinical annotation get, with no inferred source or annotation kind.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_ClinPgxAccession",
          "description": "Checked ClinPGx accession, never a shared PaId."
        },
        "source": {
          "$ref": "#/$defs/Reply_PgxSource",
          "description": "Required ClinPGx source."
        }
      },
      "required": [
        "id",
        "source"
      ],
      "type": "object"
    },
    "Reply_PgxAnnotationHistory": {
      "description": "Source-native PgxAnnotationHistory fields; no clinical interpretation.",
      "properties": {
        "date": {
          "description": "Native `date`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "description": "Native `description` when supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/Reply_Identifier_int64",
          "description": "Native `id`; literal source value."
        },
        "type": {
          "description": "Native `type`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Native `version`; literal source value.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Reply_PgxAnnotationIdentity": {
      "description": "Exact clinical annotation identity, distinct from any genomic allele identity.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_ClinPgxAccession",
          "description": "Selected exact accession."
        },
        "source": {
          "$ref": "#/$defs/Reply_PgxSource",
          "description": "Explicit ClinPGx source."
        }
      },
      "required": [
        "source",
        "id"
      ],
      "type": "object"
    },
    "Reply_PgxCrossReference": {
      "description": "Source-native PgxCrossReference fields; no clinical interpretation.",
      "properties": {
        "_url": {
          "description": "Native `_url`; literal source value.",
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/Reply_Identifier_int64",
          "description": "Native `id`; literal source value."
        },
        "name": {
          "description": "Native `name` when supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "resource": {
          "description": "Native `resource`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "resourceId": {
          "description": "Native `resourceId`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Reply_PgxDiplotypeReference": {
      "description": "Native location diplotype reference; its numeric ID is not a ClinPGx accession.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_Identifier_int64",
          "description": "Native `id`; no expression, phase or phenotype is inferred."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Reply_PgxEvidenceTerm": {
      "description": "Source-native PgxEvidenceTerm fields; no clinical interpretation.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_Identifier_int64",
          "description": "Native `id`; literal source value."
        },
        "resource": {
          "description": "Native `resource`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "synonyms": {
          "description": "Native `synonyms` when supplied.",
          "items": {
            "$ref": "#/$defs/Reply_PgxUnobserved"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "term": {
          "description": "Native `term`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "termId": {
          "description": "Native `termId`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "valid": {
          "description": "Native `valid` when supplied.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Reply_PgxLocation": {
      "description": "Source-native PgxLocation fields; no clinical interpretation.",
      "properties": {
        "buildVersion": {
          "description": "Native `buildVersion` when supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "chromosomeId": {
          "description": "Native `chromosomeId` when supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "chromosomeName": {
          "description": "Native `chromosomeName` when supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "copyNumber": {
          "description": "Native `copyNumber`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "diplotypes": {
          "description": "Native `diplotypes`; literal source value.",
          "items": {
            "$ref": "#/$defs/Reply_PgxDiplotypeReference"
          },
          "type": "array"
        },
        "displayName": {
          "description": "Native `displayName`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "genes": {
          "description": "Native `genes`; literal source value.",
          "items": {
            "$ref": "#/$defs/Reply_PgxObjectReference"
          },
          "type": "array"
        },
        "gpPosition": {
          "description": "Native `gpPosition`; literal source value.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "haplotypes": {
          "description": "Native `haplotypes`; literal source value.",
          "items": {
            "$ref": "#/$defs/Reply_PgxObjectReference"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/Reply_Identifier_int64",
          "description": "Native `id`; literal source value."
        },
        "linkedObjects": {
          "description": "Native `linkedObjects`; literal source value.",
          "items": {
            "$ref": "#/$defs/Reply_PgxObjectReference"
          },
          "type": "array"
        },
        "refSeqCrossReference": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PgxCrossReference"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native `refSeqCrossReference` when supplied."
        },
        "refSeqPosition": {
          "description": "Native `refSeqPosition`; literal source value.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "rsid": {
          "description": "Native `rsid` when supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "tagGene": {
          "description": "Native `tagGene`; literal source value.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "type": {
          "description": "Native `type`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "variant": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PgxObjectReference"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native `variant` when supplied."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Reply_PgxObjectReference": {
      "description": "Source-native PgxObjectReference fields; no clinical interpretation.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_ClinPgxAccession",
          "description": "Native `id`; literal source value."
        },
        "name": {
          "description": "Native `name` when supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "objCls": {
          "description": "Native `objCls` when supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "description": "Native `symbol` when supplied.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Reply_PgxSource": {
      "description": "Explicit independent source.",
      "enum": [
        "cpic",
        "clinpgx"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " CPIC source-native records.",
        " ClinPGx annotation records."
      ]
    },
    "Reply_PgxUnobserved": {
      "description": "No element shape was captured for these empty arrays. Populated values require new source proof.",
      "not": {}
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
