{
  "$defs": {
    "Reply_ResearchEnvelope": {
      "description": "Forward-compatible envelope metadata; entity fields use their CLI schemas.",
      "properties": {
        "schema": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Original CLI schema identity; its schema describes all entity fields."
        },
        "status": {
          "$ref": "#/$defs/Reply_Status",
          "description": "Original command outcome."
        }
      },
      "required": [
        "schema",
        "status"
      ],
      "type": "object"
    },
    "Reply_ResearchHit": {
      "description": "A citable exact source record, without inferred identity or relevance.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Exact quoted get argument list, excluding the get verb."
        },
        "title": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Original source title, or its exact identifier when no title is supplied."
        },
        "url": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Nonempty canonical source record URL.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "title",
        "url"
      ],
      "type": "object"
    },
    "Reply_ResearchSearchMetadata": {
      "description": "Search disclosures preserve the original CLI response without inventing hits.",
      "properties": {
        "envelope": {
          "$ref": "#/$defs/Reply_ResearchEnvelope",
          "description": "Complete original CLI envelope."
        },
        "note": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Explains where unprojected rows remain available."
        },
        "omitted_rows": {
          "description": "Native rows that lack an exact citable get target.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "envelope",
        "omitted_rows",
        "note"
      ],
      "type": "object"
    },
    "Reply_Status": {
      "description": "Overall command outcome.",
      "enum": [
        "complete",
        "partial",
        "absent",
        "failed"
      ],
      "type": "string"
    },
    "Reply_Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    }
  },
  "$id": "biomcp.research-search/3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Research search response.",
  "properties": {
    "metadata": {
      "$ref": "#/$defs/Reply_ResearchSearchMetadata",
      "description": "Original response and projection disclosures."
    },
    "results": {
      "description": "Citable records in unchanged CLI order.",
      "items": {
        "$ref": "#/$defs/Reply_ResearchHit"
      },
      "type": "array"
    }
  },
  "required": [
    "metadata"
  ],
  "title": "ResearchSearch",
  "type": "object"
}
