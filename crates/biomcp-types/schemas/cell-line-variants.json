{
  "$defs": {
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_Capped_CellLineVariation": {
      "description": "A bounded list with the total before its cap was applied.",
      "properties": {
        "items": {
          "description": "References in stable source order.",
          "items": {
            "$ref": "#/$defs/Reply_CellLineVariation"
          },
          "type": "array"
        },
        "total": {
          "description": "Distinct references before capping.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total"
      ],
      "type": "object"
    },
    "Reply_CellLineGene": {
      "description": "A native variation gene member with only a source-supplied HGNC identity.",
      "properties": {
        "hgnc": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_HgncId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present only if this source member explicitly carries the HGNC identifier."
        },
        "reference": {
          "$ref": "#/$defs/Reply_CellLineXref",
          "description": "Complete original source gene cross-reference."
        }
      },
      "required": [
        "reference"
      ],
      "type": "object"
    },
    "Reply_CellLineGet": {
      "description": "One exact identity and an optional bounded named section.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_CellLineInput",
          "description": "One exact primary accession or qualified source ID.",
          "x-positional": 0
        },
        "section": {
          "$ref": "#/$defs/Reply_CellLineSection",
          "description": "Omit for the default card; all returns bounded first pages without an assay count.",
          "x-positional": 1
        },
        "section_limit": {
          "description": "Explicit row limit for each requested collection; native variation defaults to three.",
          "format": "uint32",
          "maximum": 25,
          "minimum": 1,
          "type": "integer"
        },
        "section_offset": {
          "default": 0,
          "description": "Offset within each independently requested collection.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Reply_CellLineInput": {
      "description": "An exact accession or a database-qualified source identity; never a name lookup.",
      "pattern": "^(CVCL_[A-Z0-9]{4}|[A-Za-z0-9_.-]+:[^\\s\\x00-\\x1f\\x7f-\\x9f]+)$",
      "type": "string"
    },
    "Reply_CellLineProvenance": {
      "description": "One complete native source row; reference, institution and database provenance stay independent.",
      "properties": {
        "institution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native institution name if supplied."
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_CellLineReference"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native publication reference if supplied."
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native institution value if supplied."
        },
        "xref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_CellLineXref"
            },
            {
              "type": "null"
            }
          ],
          "description": "Complete native database provenance if supplied."
        }
      },
      "type": "object"
    },
    "Reply_CellLineReference": {
      "description": "One native internal publication reference, without requiring PubMed.",
      "properties": {
        "resource_internal_ref": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Complete native resource reference, for example PubMed=9305600."
        }
      },
      "required": [
        "resource_internal_ref"
      ],
      "type": "object"
    },
    "Reply_CellLineRelease": {
      "description": "Publisher release identity, fetched independently from record data.",
      "properties": {
        "updated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native release update date."
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native release version."
        }
      },
      "type": "object"
    },
    "Reply_CellLineSection": {
      "description": "Named disclosure sections; all requests each bounded first page without an assay count.",
      "enum": [
        "names",
        "identity",
        "xrefs",
        "variants",
        "chembl",
        "all"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Native display names.",
        " Independent species, diseases and qualified warnings.",
        " Complete source cross-reference rows.",
        " Complete native variation rows.",
        " Exact accession-linked ChEMBL cell metadata.",
        " Bounded first page of every named section."
      ]
    },
    "Reply_CellLineVariants": {
      "description": "Whole native variation rows with collection-local totals and offset.",
      "properties": {
        "accession": {
          "$ref": "#/$defs/Reply_CellosaurusAccession",
          "description": "Selected exact primary accession."
        },
        "fetched": {
          "description": "Original complete-card retrieval seconds, distinct from source release.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "items": {
          "$ref": "#/$defs/Reply_Capped_CellLineVariation",
          "description": "Whole source rows and the total in this collection only."
        },
        "offset": {
          "description": "Offset within this collection, never within another section.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_CellLineRelease"
            },
            {
              "type": "null"
            }
          ],
          "description": "Independently fetched publisher release."
        }
      },
      "required": [
        "accession",
        "items",
        "offset"
      ],
      "type": "object"
    },
    "Reply_CellLineVariation": {
      "description": "One complete native variation row; descriptions do not become normalized alleles.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Complete native mutation description including all coordinate spellings."
        },
        "genes": {
          "description": "Every native gene member, including both fusion members.",
          "items": {
            "$ref": "#/$defs/Reply_CellLineGene"
          },
          "type": "array"
        },
        "mutation_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native open mutation label."
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Complete native variation note."
        },
        "provenance": {
          "description": "Every native provenance row in source order; no PMID is required.",
          "items": {
            "$ref": "#/$defs/Reply_CellLineProvenance"
          },
          "type": "array"
        },
        "references": {
          "description": "Every other variation cross-reference in native order.",
          "items": {
            "$ref": "#/$defs/Reply_CellLineXref"
          },
          "type": "array"
        },
        "variation_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native open variation label."
        },
        "zygosity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native zygosity label; absence is not inferred."
        }
      },
      "type": "object"
    },
    "Reply_CellLineXref": {
      "description": "One complete native cross-reference; database and accession form the source identity.",
      "properties": {
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native source category when supplied."
        },
        "discontinued": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native discontinuation qualifier, including values such as probable."
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Native accession, including any internal prefix."
        },
        "iri": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native IRI when supplied."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native display label when supplied."
        },
        "namespace": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Native database name; no fixed vocabulary."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native source URL when supplied.",
          "format": "uri"
        }
      },
      "required": [
        "namespace",
        "id"
      ],
      "type": "object",
      "x-identifier": true
    },
    "Reply_CellosaurusAccession": {
      "description": "A checked Cellosaurus accession; primary identity is verified by the adapter.",
      "pattern": "^CVCL_[A-Z0-9]{4}$",
      "type": "string"
    },
    "Reply_HgncId": {
      "description": "An HGNC identifier with canonical namespace and positive numeric value.",
      "pattern": "^HGNC:(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "Reply_Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
