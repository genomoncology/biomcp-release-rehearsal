{
  "$defs": {
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_DiagnosticCountUnit": {
      "description": "Meaning of the envelope's total for a source-owned diagnostic page.",
      "enum": [
        "recall-records",
        "product-identities",
        "test-identities",
        "native-relation-rows",
        "native-method-entries"
      ],
      "type": "string"
    },
    "Reply_DiagnosticGet": {
      "description": "Get one exact source record or supported section. A listing is not authorization; a companion row is not a treatment recommendation.",
      "properties": {
        "bundle_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Immutable stored bundle revision retained by a continuation."
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Exact native identity, including version for GTR.",
          "x-positional": 0
        },
        "section": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_DiagnosticSection"
            },
            {
              "type": "null"
            }
          ],
          "description": "GTR: genes, conditions, methods. PMA: regulatory, supplements.\nWHO, 510(k) and device recalls have no sections; omit for the card.",
          "x-positional": 1
        },
        "section_limit": {
          "description": "Maximum native rows; omitted means five rows, or one regulatory fragment.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "section_offset": {
          "default": 0,
          "description": "Zero-based native row or fragment offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/Reply_DiagnosticGetSource",
          "description": "Explicit source: GTR accession/version, WHO Product ID, PMA P number,\n510(k) K number or device recall Z-NNNN-YYYY."
        },
        "supplement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PmaSupplement"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact native PMA supplement; absent selects the base row."
        }
      },
      "required": [
        "id",
        "source"
      ],
      "type": "object"
    },
    "Reply_DiagnosticGetSource": {
      "description": "One explicit exact diagnostic record source.",
      "enum": [
        "gtr",
        "who-ivd",
        "fda-pma",
        "fda-510k",
        "fda-device-recall"
      ],
      "type": "string"
    },
    "Reply_DiagnosticPmaHeader": {
      "description": "Compact exact PMA row identity; its native empty base cell is explicit.",
      "properties": {
        "applicant": {
          "description": "Native applicant when supplied, including explicit empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "decision_code": {
          "description": "Native decision_code when supplied, including explicit empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "decision_date": {
          "description": "Native decision_date when supplied, including explicit empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "pma_number": {
          "$ref": "#/$defs/Reply_PmaNumber",
          "description": "Native application."
        },
        "supplement_number": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PmaSupplementCell"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent differs from explicit empty base cell."
        },
        "trade_name": {
          "description": "Native trade_name when supplied, including explicit empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Exact source record URL.",
          "format": "uri"
        }
      },
      "required": [
        "pma_number",
        "url"
      ],
      "type": "object"
    },
    "Reply_DiagnosticPmaRegulatory": {
      "description": "Dated metadata belonging only to the selected submission.",
      "properties": {
        "advisory_committee": {
          "description": "Native advisory_committee when supplied, including empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "advisory_committee_description": {
          "description": "Native advisory_committee_description when supplied, including empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "date_received": {
          "description": "Native date_received when supplied, including empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "fed_reg_notice_date": {
          "description": "Native fed_reg_notice_date when supplied, including empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "product_code": {
          "description": "Native product_code when supplied, including empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "supplement_reason": {
          "description": "Native supplement_reason when supplied, including empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "supplement_type": {
          "description": "Native supplement_type when supplied, including empty.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Reply_DiagnosticRegulatory": {
      "description": "Exact selected submission regulatory text fragments.",
      "properties": {
        "count_unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_DiagnosticCountUnit"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact meaning of the envelope total; supplied by the owning source command."
        },
        "distinct_id_total": {
          "description": "Distinct complete native IDs across the selected relation collection.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "items": {
          "description": "Complete source-owned rows in native order; envelope totals count native rows.",
          "items": {
            "$ref": "#/$defs/Reply_DiagnosticRegulatoryFragment"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Reply_DiagnosticRegulatoryField": {
      "description": "Regulatory text available in this source tier.",
      "enum": [
        "ao_statement"
      ],
      "type": "string"
    },
    "Reply_DiagnosticRegulatoryFragment": {
      "description": "One bounded regulatory fragment from the exact selected native submission.",
      "properties": {
        "field": {
          "$ref": "#/$defs/Reply_DiagnosticRegulatoryField",
          "description": "Native text field being continued."
        },
        "metadata": {
          "$ref": "#/$defs/Reply_DiagnosticPmaRegulatory",
          "description": "Native metadata for this exact record, without a duplicated whole statement."
        },
        "offset": {
          "description": "Fragment offset, independent of characters and supplement rows.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "submission": {
          "$ref": "#/$defs/Reply_DiagnosticPmaHeader",
          "description": "Exact selected native record and its dated regulatory metadata."
        },
        "text": {
          "description": "Complete unmodified text fragment; omitted when the source statement is absent.",
          "type": "string"
        },
        "total": {
          "description": "Total mechanical fragments.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "submission",
        "metadata",
        "field",
        "offset",
        "total"
      ],
      "type": "object"
    },
    "Reply_DiagnosticSection": {
      "description": "Source-supported diagnostic sections; no all section.",
      "enum": [
        "genes",
        "conditions",
        "methods",
        "regulatory",
        "supplements"
      ],
      "type": "string",
      "x-enum-descriptions": [
        "GTR native gene rows; five per page.",
        "GTR native condition rows; five per page.",
        "GTR native method entries; five per page.",
        "Selected PMA submission statement; one fragment per page.",
        "PMA base application supplement headers; five per page."
      ]
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PmaNumber": {
      "description": "Native FDA PMA base application number.",
      "pattern": "^P[0-9]{6}$",
      "type": "string"
    },
    "Reply_PmaSupplement": {
      "description": "Explicit native PMA supplement selector; no invented base alias.",
      "pattern": "^S(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$",
      "type": "string"
    },
    "Reply_PmaSupplementCell": {
      "description": "Native PMA supplement cell; empty denotes base and never becomes S000.",
      "pattern": "^($|S(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2}))$",
      "type": "string"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "Reply_Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " WikiPathways published pathway catalogs.",
        " Human Protein Atlas.",
        " UniProt.",
        " Integrated InterPro entries.",
        " Complex Portal.",
        " gnomAD.",
        " ClinVar component source policy.",
        " ClinGen Evidence Repository.",
        " GWAS Catalog v2.",
        " ClinGen.",
        " GenCC submitter assessments.",
        " PubMed.",
        " Europe PMC.",
        " NCBI LitVar2.",
        " NCBI LitSense2.",
        " Semantic Scholar.",
        " ORCID public registry.",
        " PMC Open Access bucket.",
        " NIH iCite.",
        " PubTator.",
        " ClinicalTrials.gov.",
