{
  "$defs": {
    "Reply_Doi": {
      "description": "DOI preserving source spelling with ASCII-insensitive equality.",
      "pattern": "^10\\.[0-9]+/[^\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f]+$",
      "type": "string"
    },
    "Reply_EuropePmcId": {
      "description": "Europe PMC source prefix followed by its positive numeric local identifier.",
      "pattern": "^(?=.{1,64}$)[A-Z]{1,8}[0-9]*[1-9][0-9]*$",
      "type": "string"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_Pmcid": {
      "description": "Canonical PMC identifier, with an explicit namespace.",
      "pattern": "^PMC(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_Pmid": {
      "description": "Positive PubMed identifier.",
      "pattern": "^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_PublicationType": {
      "description": "Clinically meaningful PubMed publication types.",
      "type": "string",
      "x-enum-descriptions": [
        " Randomized controlled trial.",
        " Clinical trial.",
        " Phase one trial.",
        " Phase two trial.",
        " Phase three trial.",
        " Phase four trial.",
        " Meta-analysis.",
        " Systematic review.",
        " Review.",
        " Practice guideline.",
        " Guideline.",
        " Case report.",
        " Observational study.",
        " Multicenter study.",
        " Letter.",
        " Comment.",
        " Editorial.",
        " Preprint.",
        " Retracted publication.",
        " Retraction notice.",
        " Erratum."
      ],
      "x-extensible-enum": [
        "randomized-controlled-trial",
        "clinical-trial",
        "clinical-trial-phase-1",
        "clinical-trial-phase-2",
        "clinical-trial-phase-3",
        "clinical-trial-phase-4",
        "meta-analysis",
        "systematic-review",
        "review",
        "practice-guideline",
        "guideline",
        "case-report",
        "observational-study",
        "multicenter-study",
        "letter",
        "comment",
        "editorial",
        "preprint",
        "retracted-publication",
        "retraction-notice",
        "erratum"
      ]
    },
    "Reply_SemanticScholarAuthorId": {
      "description": "A checked source-local Semantic Scholar author identifier, never a person identity.",
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "Reply_Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    }
  },
  "$id": "biomcp.article-header/5",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Citation metadata from PubMed or Europe PMC.",
  "properties": {
    "author_count": {
      "description": "Whole source author count.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "date": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_PartialDate"
        },
        {
          "type": "null"
        }
      ],
      "description": "Publication date at source precision."
    },
    "doi": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Doi"
        },
        {
          "type": "null"
        }
      ],
      "description": "Checked DOI, when supplied."
    },
    "electronic_date": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_PartialDate"
        },
        {
          "type": "null"
        }
      ],
      "description": "Electronic publication date when different from the publication date."
    },
    "europepmc_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_EuropePmcId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Europe PMC source-local identity."
    },
    "first_author": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "First author in source order."
    },
    "first_author_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_SemanticScholarAuthorId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact Semantic Scholar ID for the displayed native first author, when supplied."
    },
    "journal": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Journal name."
    },
    "pmcid": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Pmcid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Checked PMC identity, when supplied."
    },
    "pmid": {
      "$ref": "#/$defs/Reply_Pmid",
      "description": "Checked PubMed identity."
    },
    "title": {
      "$ref": "#/$defs/Reply_Text",
      "description": "Whole source title."
    },
    "types": {
      "description": "Clinical publication types.",
      "items": {
        "$ref": "#/$defs/Reply_PublicationType"
      },
      "type": "array"
    },
    "types_unknown": {
      "description": "The provider does not supply checked publication types.",
      "type": "boolean"
    }
  },
  "required": [
    "author_count"
  ],
  "title": "ArticleHeader",
  "type": "object"
}
