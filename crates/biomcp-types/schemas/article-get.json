{
  "$defs": {
    "ArticleInput": {
      "description": "A validated canonical ArticleInput string.",
      "pattern": "(^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$|^PMC(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$|(?=PPR)^(?=.{1,64}$)[A-Z]{1,8}[0-9]*[1-9][0-9]*$|^(?:https?://doi\\.org/)?10\\.[0-9]+/[^\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f]+$)",
      "type": "string"
    },
    "ArticleSectionWord": {
      "description": "Article section request including all landed sections.",
      "enum": [
        "annotations",
        "fulltext",
        "supplements",
        "tldr",
        "citations",
        "indexing",
        "pdf",
        "all"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Normalized text-mined entities from PubTator3.",
        " Licensed PMC body outline.",
        " Supplementary files confirmed by PMC metadata.",
        " Machine-written Semantic Scholar summary and counts.",
        " Citation counts from NIH iCite.",
        " MeSH, keywords and author indexing from the citation.",
        " Publisher PDF link without downloading.",
        " Every landed article section."
      ]
    }
  },
  "$id": "biomcp.article-get/3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Get one to twenty article inputs in caller order.",
  "properties": {
    "input": {
      "description": "PubMed, PMC or DOI identifiers in input order.",
      "items": {
        "$ref": "#/$defs/ArticleInput"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array",
      "x-positional": 0
    },
    "section": {
      "description": "Requested section words; trailing words and --section share this field.",
      "items": {
        "$ref": "#/$defs/ArticleSectionWord"
      },
      "type": "array",
      "x-trailing-section": true
    }
  },
  "required": [
    "input"
  ],
  "title": "ArticleGet",
  "type": "object"
}
