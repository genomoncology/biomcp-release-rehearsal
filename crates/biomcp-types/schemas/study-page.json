{
  "$defs": {
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_CbioportalCancerTypeId": {
      "description": "Native cBioPortal cancer-type code, with no OncoTree equivalence.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "type": "string"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_Pmid": {
      "description": "Positive PubMed identifier.",
      "pattern": "^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "Reply_Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " WikiPathways published pathway catalogs.",
        " Human Protein Atlas.",
        " UniProt.",
        " Integrated InterPro entries.",
        " Complex Portal.",
        " gnomAD.",
        " ClinVar component source policy.",
        " ClinGen Evidence Repository.",
        " GWAS Catalog v2.",
        " ClinGen.",
        " GenCC submitter assessments.",
        " PubMed.",
        " Europe PMC.",
        " NCBI LitVar2.",
        " NCBI LitSense2.",
        " Semantic Scholar.",
        " ORCID public registry.",
        " PMC Open Access bucket.",
        " NIH iCite.",
        " PubTator.",
        " ClinicalTrials.gov.",
        " NCI Clinical Trials Search.",
        " CIViC.",
        " Cancer Hotspots residue recurrence.",
        " AlphaGenome.",
        " OncoKB.",
        " MyVariant.info aggregation.",
        " ClinGen Allele Registry.",
        " Mutalyzer.",
        " VariantValidator.",
        " MyChem.info aggregation.",
        " ChEMBL native records and carried component.",
        " Open Targets.",
        " openFDA SPL labels.",
        " Drugs@FDA application records.",
        " European Medicines Agency.",
        " WHO finished pharmaceutical products.",
        " DDInter interaction records.",
        " MyChem DrugBank Open identity subset only.",
        " MyChem DrugCentral component.",
        " MyChem Guide to Pharmacology component.",
        " MyChem UNII identities.",
        " MyChem NDC package identities.",
        " MyChem openFDA cross-references only.",
        " Ontology Lookup Service.",
        " MyDisease.info aggregation.",
        " Monarch associations.",
        " SEER Explorer.",
        " MONDO published ontology content.",
        " Disease Ontology published content.",
        " NCI Thesaurus ontology content.",
        " HPO-published annotations.",
        " Reviewed Orphadata Science content.",
        " Separately licensed OMIM payload only.",
        " openFDA FAERS drug adverse event reports.",
        " CDC WONDER vaccine report summaries.",
        " openFDA MAUDE device event reports.",
        " Source-reported MedDRA reaction labels and versions.",
        " Source-carried GMDN device terminology.",
        " NCBI Genetic Testing Registry public reports.",
        " WHO prequalified in vitro diagnostics.",
        " FDA companion diagnostic device tables.",
        " openFDA premarket approval submissions.",
        " FDA native 510(k) clearance records.",
        " openFDA medical device product recall records.",
        " FDA drug enforcement recall records.",
        " Clinical Pharmacogenetics Implementation Consortium.",
        " ClinPGx pharmacogenomics annotations.",
        " Public cBioPortal with study-specific reuse terms.",
        " Cellosaurus cell line identity."
      ],
      "x-extensible-enum": [
        "hgnc",
        "mygene",
        "reactome",
        "wikipathways",
        "hpa",
        "uniprot",
        "interpro",
        "complex-portal",
        "gnomad",
        "clinvar",
        "erepo",
        "gwas",
        "clingen",
        "gencc",
        "pubmed",
        "europepmc",
        "litvar",
        "litsense",
        "semantic-scholar",
        "orcid",
        "pmc-oa",
        "icite",
        "pubtator",
        "ctgov",
        "nci",
        "civic",
        "hotspots",
        "alphagenome",
        "oncokb",
        "myvariant",
        "car",
        "mutalyzer",
        "variantvalidator",
        "mychem",
        "chembl",
        "opentargets",
        "openfda-label",
        "drugsfda",
        "ema",
        "who-pq",
        "ddinter",
        "drugbank-open",
        "drugcentral",
        "gtopdb",
        "unii",
        "ndc",
        "openfda-xref",
        "ols",
        "mydisease",
        "monarch",
        "seer",
        "mondo",
        "doid",
        "ncit",
        "hpo",
        "orphanet",
        "omim",
        "faers",
        "vaers",
        "maude",
        "meddra",
        "gmdn",
        "gtr",
        "who-ivd",
        "fda-cdx",
        "fda-pma",
        "fda-510k",
        "fda-device-recall",
        "fda-drug-recall",
        "cpic",
        "clinpgx",
        "cbioportal",
        "cellosaurus"
      ]
    },
    "Reply_SourceNotice": {
      "description": "A source notice or request recovery step.",
      "oneOf": [
        {
          "description": "Local request limits, source observations and recovery guidance.",
          "properties": {
            "kind": {
              "const": "request-guidance",
              "type": "string"
            },
            "message": {
              "description": "Reviewed guidance; any quoted provider wording remains source data.",
              "type": "string"
            },
            "retry_after_seconds": {
              "description": "Seconds left before another source request may be admitted.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "Registered conditions lack the literal words requested in a condition search.",
          "properties": {
            "kind": {
              "const": "condition-word-mismatch",
              "type": "string"
            },
            "message": {
              "description": "The source searches several fields and can expand terms; no expansion cause is inferred.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "A checked provider answer survived a local cache failure.",
          "properties": {
            "kind": {
              "const": "cache-problem",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/Reply_CacheProblem",
              "description": "Bounded local failure without paths or database diagnostics."
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The source still has graph pages after the bounded fetch window.",
          "properties": {
            "fallback": {
              "$ref": "#/$defs/Reply_Text",
              "description": "Default-source command offering another graph view."
            },
            "kind": {
              "const": "graph-truncated",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "fallback"
          ],
          "type": "object"
        },
        {
          "description": "An empty LitVar lookup can be repeated with a caller-supplied rsID.",
          "properties": {
            "kind": {
              "const": "litvar-rsid-hint",
              "type": "string"
            },
            "message": {
              "description": "Guidance that never supplies or infers an rsID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "PubMed supplied a named ESearch warning without changing its phrases.",
          "properties": {
            "kind": {
              "const": "pubmed-warning",
              "type": "string"
            },
            "name": {
              "description": "Original provider warning name, including names added by PubMed later.",
              "type": "string"
            },
            "phrases": {
              "description": "Original provider phrases, preserving whitespace and quotes.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "PubMed did not index these words.",
          "properties": {
            "kind": {
              "const": "not-found-words",
              "type": "string"
            },
            "words": {
              "description": "Whole source words.",
              "items": {
                "$ref": "#/$defs/Reply_Text"
              },
              "type": "array"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Reply_SourceOutcome": {
      "description": "One source's outcome with source notices and request guidance.",
      "properties": {
        "count": {
          "description": "Provider matching count.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "notices": {
          "description": "Source notices and request recovery guidance.",
          "items": {
            "$ref": "#/$defs/Reply_SourceNotice"
          },
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Failure or stale-fallback reason."
        },
        "retrieved_count": {
          "description": "Number of retrieved identities.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "Asked source."
        },
        "state": {
          "$ref": "#/$defs/Reply_SourceState",
          "description": "Retained state."
        },
        "term": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact provider search term."
        },
        "terms": {
          "description": "Publisher terms name from the source registry.",
          "type": "string"
        },
        "terms_url": {
          "description": "Publisher page documenting the terms.",
          "format": "uri",
          "type": "string"
        },
        "use": {
          "$ref": "#/$defs/Reply_Use",
          "description": "Reviewed source use category; publisher terms remain authoritative."
        }
      },
      "required": [
        "source",
        "use",
        "terms",
        "terms_url",
        "state"
      ],
      "type": "object"
    },
    "Reply_SourceState": {
      "description": "State of a source actually asked by the command.",
      "enum": [
        "ok",
        "stale",
        "syncing",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "Reply_Status": {
      "description": "Overall command outcome.",
      "enum": [
        "complete",
        "partial",
        "absent",
        "failed"
      ],
      "type": "string"
    },
    "Reply_Step": {
      "description": "A command argument list spelled from a typed action.",
      "properties": {
        "args": {
          "description": "CLI and MCP arguments.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/Reply_StepKind",
          "description": "Purpose of the action."
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "Reply_StepKind": {
      "description": "Purpose of an available next command.",
      "enum": [
        "restart",
        "section",
        "sort",
        "page",
        "fresh",
        "disambiguate",
        "pivot",
        "sync",
        "key",
        "configure"
      ],
      "type": "string"
    },
    "Reply_StudyHeader": {
      "description": "Compact source study identity; source codes and counts retain their own scope.",
      "properties": {
        "allSampleCount": {
          "description": "Native allSampleCount, never a patient or profiled-gene denominator.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cancerTypeId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_CbioportalCancerTypeId"
            },
            {
              "type": "null"
            }
          ],
          "description": "cBioPortal namespace only; no ontology inference."
        },
        "citation": {
          "description": "Native citation, absent for unpublished records.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native study name."
        },
        "pmids": {
          "description": "Every validated source PMID in native order, including repetitions; absent remains absent.",
          "items": {
            "$ref": "#/$defs/Reply_Pmid"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "referenceGenome": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native study metadata label, never a coordinate assembly."
        },
        "studyId": {
          "$ref": "#/$defs/Reply_StudyId",
          "description": "Exact case-sensitive source identity."
        }
      },
      "required": [
        "studyId"
      ],
      "type": "object"
    },
    "Reply_StudyId": {
      "description": "Opaque case-sensitive cBioPortal study identity, without repair.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "type": "string"
    },
    "Reply_StudyPage": {
      "description": "Source-ordered checked study headers from one retained catalog.",
      "properties": {
        "items": {
          "description": "Whole source headers, without expanded descriptions.",
          "items": {
            "$ref": "#/$defs/Reply_StudyHeader"
          },
          "type": "array"
        },
        "page": {
          "$ref": "#/$defs/Reply_PageInfo",
          "description": "Snapshot-scoped matching counts and offset."
        },
        "snapshot": {
          "$ref": "#/$defs/Reply_StudySnapshot",
          "description": "Catalog acquisition provenance."
        }
      },
      "required": [
        "page",
        "snapshot"
      ],
      "type": "object"
    },
    "Reply_StudySearch": {
      "anyOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "cancer_type"
          ]
        }
      ],
      "description": "Literal stored metadata search; text is never parsed as a query language. No frequency, denominator, survival or comparison is calculated. Source counts keep their native names.",
      "properties": {
        "cancer_type": {
          "$ref": "#/$defs/Reply_CbioportalCancerTypeId",
          "description": "Exact cBioPortal cancer-type code; no OncoTree conversion."
        },
        "limit": {
          "default": 5,
          "description": "Maximum headers per page.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Zero-based offset in the checked snapshot.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Opaque continuation retaining the catalog revision and selectors."
        },
        "text": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Literal study ID, name or description text, without synonyms or typo repair.",
          "x-positional": 0
        }
      },
      "type": "object"
    },
    "Reply_StudySnapshot": {
      "description": "Metadata catalog revision and acquisition time; never a biological release date.",
      "properties": {
        "acquired": {
          "description": "Catalog acquisition wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "revision": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Immutable bundle revision."
        }
      },
      "required": [
        "revision",
        "acquired"
      ],
      "type": "object"
    },
    "Reply_Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    },
    "Reply_Use": {
      "description": "Reviewed source-use category, without inferring rights in individual records.",
      "enum": [
        "open",
        "attribution",
        "noncommercial",
        "licensed",
        "per-record"
      ],
      "type": "string"
    }
  },
  "$id": "biomcp.study-page/5",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One versioned command response; schema identity comes only from its body type.\nJSON readers ignore unknown fields and unknown growable enum values within a major.",
  "properties": {
    "local_error": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_CacheProblem"
        },
        {
          "type": "null"
        }
      ],
      "description": "Bounded local cache failure, independent of provider outcomes."
    },
    "next": {
      "description": "Available next commands.",
      "items": {
        "$ref": "#/$defs/Reply_Step"
      },
      "type": "array"
    },
    "page": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_PageInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Search page metadata."
    },
    "problems": {
      "description": "Rejected source fields.",
      "items": {
        "$ref": "#/$defs/Reply_Problem"
      },
      "type": "array"
    },
    "query": {
      "$ref": "#/$defs/Reply_StudySearch",
      "description": "Parsed query."
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_StudyPage"
        },
        {
          "type": "null"
        }
      ],
      "description": "Answer when available."
    },
    "schema": {
      "const": "biomcp.study-page/5",
      "type": "string"
    },
    "sources": {
      "description": "Sources actually asked.",
      "items": {
        "$ref": "#/$defs/Reply_SourceOutcome"
      },
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/Reply_Status",
      "description": "Overall outcome."
    }
  },
  "required": [
    "schema",
    "status",
    "query"
  ],
  "title": "Envelope",
  "type": "object"
}
