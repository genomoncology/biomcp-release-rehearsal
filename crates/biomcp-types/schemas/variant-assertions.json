  "$id": "biomcp.variant-assertions/5",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Page assertions from one explicitly selected evidence source.",
  "properties": {
    "assertion": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native assertion accession or document ID."
    },
    "input": {
      "$ref": "#/$defs/VariantInput",
      "description": "Checked Variation ID for ClinVar, or CAid for ERepo.",
      "x-positional": 0
    },
    "limit": {
      "description": "Assertions per page; omitted uses the native source default.",
      "format": "uint32",
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "description": "Assertions to skip in source order.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/AssertionSource",
      "description": "One native source; no fallback or text search."
    },
    "version": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "VCV archive or ERepo document version; RCV/SCV selectors match a returned native version."
    }
  },
  "required": [
    "input",
    "source"
  ],
  "title": "VariantAssertionsGet",
  "type": "object"
}
