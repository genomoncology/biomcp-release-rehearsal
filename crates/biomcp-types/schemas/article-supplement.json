{
  "$defs": {
    "ArticleInput": {
      "description": "A validated canonical ArticleInput string.",
      "pattern": "(^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$|^PMC(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$|(?=PPR)^(?=.{1,64}$)[A-Z]{1,8}[0-9]*[1-9][0-9]*$|^(?:https?://doi\\.org/)?10\\.[0-9]+/[^\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f]+$)",
      "type": "string"
    },
    "SheetRows": {
      "description": "Inclusive original one-based row range. The parser additionally requires the end to be at least the start and fewer than 200 rows after it.",
      "pattern": "^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})-(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    }
  },
  "$id": "biomcp.article-supplement/3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Read a checked supplement file or page its original rows.",
  "properties": {
    "file": {
      "$ref": "#/$defs/Text",
      "description": "Exact file name from the supplements section.",
      "x-positional": 1
    },
    "find": {
      "$ref": "#/$defs/Text",
      "description": "Literal case-insensitive needle."
    },
    "input": {
      "$ref": "#/$defs/ArticleInput",
      "description": "PubMed or PMC identity.",
      "x-positional": 0
    },
    "offset": {
      "default": 0,
      "description": "Matching-row or text-fragment offset.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "replace": {
      "description": "Replace an existing destination only when explicitly requested with save.",
      "type": "boolean"
    },
    "rows": {
      "$ref": "#/$defs/SheetRows",
      "description": "Inclusive original row range."
    },
    "save": {
      "$ref": "#/$defs/Text",
      "description": "Save the whole original document to an explicit file or existing folder."
    },
    "sheet": {
      "$ref": "#/$defs/Text",
      "description": "Sheet name for row selection."
    },
    "variant": {
      "$ref": "#/$defs/Text",
      "description": "Explicit protein substitution."
    }
  },
  "required": [
    "input",
    "file"
  ],
  "title": "ArticleSupplement",
  "type": "object"
}
