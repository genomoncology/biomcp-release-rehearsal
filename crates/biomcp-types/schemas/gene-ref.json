{
  "$defs": {
    "Reply_EnsemblGeneId": {
      "description": " A human Ensembl gene stable identifier with a separately retained version.",
      "pattern": "^ENSG[0-9]{11}(\\.(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))?$",
      "type": "string"
    },
    "Reply_HgncId": {
      "description": "An HGNC identifier with canonical namespace and positive numeric value.",
      "pattern": "^HGNC:(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_NcbiGeneId": {
      "description": "A positive NCBI Gene identifier in canonical decimal text.",
      "pattern": "^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    }
  },
  "$id": "biodata.gene-ref/3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A source-stated gene reference; its label never implies an identifier.",
  "properties": {
    "ensembl_gene_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_EnsemblGeneId"
        },
        {
          "type": "null"
        }
      ]
    },
    "hgnc_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_HgncId"
        },
        {
          "type": "null"
        }
      ]
    },
    "label": {
      "$ref": "#/$defs/Reply_Text"
    },
    "ncbi_gene_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_NcbiGeneId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "label"
  ],
  "title": "GeneRef",
  "type": "object"
}
