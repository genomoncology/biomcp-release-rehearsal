{
  "$defs": {
    "Reply_CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version"
      ],
      "type": "string"
    },
    "Reply_CivicClaimKind": {
      "description": "CIViC native claim collection.",
      "enum": [
        "evidence",
        "assertions"
      ],
      "type": "string"
    },
    "Reply_CivicEvidenceLevel": {
      "description": "Native CIViC evidence level.",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ],
      "type": "string"
    },
    "Reply_CivicEvidenceStatus": {
      "description": "Native CIViC evidence review status.",
      "enum": [
        "accepted",
        "submitted",
        "rejected"
      ],
      "type": "string"
    },
    "Reply_DrugGet": {
      "description": "A source-selected drug request echoed with a native ID after name resolution.",
      "properties": {
        "civic_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "CIViC continuation.\nNative continuation cursor for that exact drug, profile and claim collection."
        },
        "civic_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_CivicClaimKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "CIViC collection.\nIndependent native evidence or assertion collection within the selected profile."
        },
        "civic_profile": {
          "description": "Selected native CIViC molecular profile for a drug-scoped claim stream.",
          "format": "uint64",
          "maximum": 2147483647,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "document_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "FDA letter document ID.\nExact native Drugs@FDA approval letter document ID. Text is bounded to 25 MiB, 100 pages\nand 6144 escaped bytes per fragment. No-text scans are explicit."
        },
        "evidence_level": {
          "description": "A–E\nNative CIViC evidence levels; repeat to include several levels.",
          "items": {
            "$ref": "#/$defs/Reply_CivicEvidenceLevel"
          },
          "type": "array"
        },
        "evidence_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_CivicEvidenceStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "Status\nNative CIViC evidence status; omitted preserves the source's existing default."
        },
        "input": {
          "$ref": "#/$defs/Reply_DrugId"
        },
        "label_section": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact openFDA SPL field.\nExact published openFDA SPL section field, including table fields; required for the label section."
        },
        "product_number": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "FDA product number.\nExplicit native application product number, only for approvals."
        },
        "section": {
          "description": "Explicit named disclosures; empty means identity only.",
          "items": {
            "$ref": "#/$defs/Reply_DrugSection"
          },
          "title": "Source sections.",
          "type": "array",
          "x-positional": 1
        },
        "section_limit": {
          "description": "Named section page size, refused on an identity-only card.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "section_offset": {
          "description": "Named section continuation, refused on an identity-only card.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/Reply_DrugSource"
        }
      },
      "required": [
        "input",
        "source"
      ],
      "type": "object"
    },
    "Reply_DrugId": {
      "description": "A published native drug record identifier, without a consumer source prefix.",
      "pattern": "^(?:[A-Z][A-Z0-9_.-]*:)?[A-Za-z0-9][A-Za-z0-9_.-]*(/[A-Za-z0-9_.-]+)*$",
      "type": "string"
    },
    "Reply_DrugRecallCard": {
      "description": "Native detail fields from the selected recall record.",
      "properties": {
        "code_info": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Published product code information."
        },
        "distribution_pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Published distribution pattern."
        },
        "header": {
          "$ref": "#/$defs/Reply_DrugRecallHeader",
          "description": "Native recall header."
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Published reason for recall."
        },
        "voluntary_mandated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native voluntary or mandated status."
        }
      },
      "required": [
        "header"
      ],
      "type": "object"
    },
    "Reply_DrugRecallHeader": {
      "description": "One native drug recall record, independent of its event.",
      "properties": {
        "classification": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native FDA classification, without local interpretation."
        },
        "firm": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Published recalling firm."
        },
        "initiated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native recall initiation day."
        },
        "product_description": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Published product wording; harmonized names never enter this field."
        },
        "recall_number": {
          "$ref": "#/$defs/Reply_DrugRecallNumber",
          "description": "Native recall number."
        },
        "reported": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native enforcement report day."
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Published recall status."
        }
      },
      "required": [
        "recall_number"
      ],
      "type": "object"
    },
    "Reply_DrugRecallNumber": {
      "description": "Native FDA drug recall number, independent of its event number.",
      "pattern": "^D-[0-9]{4}-[0-9]{4}$",
      "type": "string"
    },
    "Reply_DrugSection": {
      "description": "Explicit drug disclosures; identity cards never expand into these sections.",
      "type": "string",
      "x-enum-descriptions": [
        " All native identity cross-references and product links, mechanically paged.",
        " Native target and mechanism relations.",
        " Native indication wording.",
        " Native CIViC therapy evidence and profile context.",
        " One exact native label heading.",
        " Native application and product history rows.",
        " Source-scoped regulator events.",
        " Native DDInter partner rows and levels; five rows per default page, with explicit section limits preserved."
      ],
      "x-extensible-enum": [
        "xrefs",
        "targets",
        "indications",
        "civic",
        "label",
        "approvals",
        "regulatory",
        "interactions"
      ]
    },
    "Reply_DrugSource": {
      "description": "A supported drug data source.",
      "type": "string",
      "x-extensible-enum": [
        "who-pq",
        "fda-drug-recall",
        "mychem",
        "chembl",
        "opentargets",
        "civic",
        "openfda-label",
        "drugsfda",
        "ema",
        "ddinter"
      ]
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
