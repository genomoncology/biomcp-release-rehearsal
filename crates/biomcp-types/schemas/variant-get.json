    "VariantResolver": {
      "description": "Explicit source service for reference-qualified notation.",
      "enum": [
        "car",
        "mutalyzer",
        "variantvalidator"
      ],
      "type": "string"
    },
    "VariantSection": {
      "description": "Named variant source sections, without automatic expansion of identity cards.",
      "enum": [
        "clinvar",
        "erepo",
        "population",
        "gwas",
        "civic",
        "alphagenome",
        "oncokb",
        "hotspots",
        "predict",
        "conservation",
        "cosmic",
        "all"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " ClinVar native assertions.",
        " ClinGen native assertions.",
        " gnomAD population observations.",
        " GWAS Catalog associations.",
        " CIViC molecular-profile evidence.",
        " Keyed AlphaGenome native numeric scorer values.",
        " Keyed OncoKB annotation with explicit tumor context and build.",
        " Cancer Hotspots candidate residue counts; no established exact allele join or clinical actionability.",
        " MyVariant source predictor scores.",
        " MyVariant conservation scores.",
        " Historical COSMIC fragments carried by MyVariant; parent-to-fragment allele identity remains unverified.",
        " Every implemented variant section."
      ]
    }
  },
  "$id": "biomcp.variant-get/7",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Read an rsID, CAid, clinvar:N, VCV accession, reference-qualified HGVS or VCF-style genomic coordinates such as 7-140753336-A-T through the shared resolver. MyVariant identity lookups default to GRCh38; --build overrides it. Chromosome genomic HGVS requires --build. Use search variant --gene BRAF --protein V600E or search variant --gene PTEN --coding c.333G>T for gene shorthand. Every candidate remains available; source assertions do not classify the variant for the caller.",
  "properties": {
    "build": {
      "anyOf": [
        {
          "$ref": "#/$defs/Build"
        },
        {
          "type": "null"
        }
      ],
      "description": "MyVariant identity assembly defaults to GRCh38; chromosome genomic HGVS requires an explicit build."
    },
    "civic_cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native CIViC cursor, retained unchanged."
    },
    "civic_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/CivicClaimKind"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native CIViC claim collection within the selected profile."
    },
    "civic_profile": {
      "description": "Selected CIViC molecular profile for native claim paging.",
      "format": "uint64",
      "maximum": 2147483647,
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "evidence_level": {
      "description": "Native CIViC evidence levels; repeat to include several levels.",
      "items": {
        "$ref": "#/$defs/CivicEvidenceLevel"
      },
      "type": "array"
    },
    "evidence_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/CivicEvidenceStatus"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native CIViC evidence status; omitted preserves the source's existing default."
    },
    "input": {
      "$ref": "#/$defs/VariantInput",
      "description": "rsID, CAid, clinvar:N, VCV accession, reference-qualified HGVS or VCF-style genomic coordinates.",
      "x-positional": 0
    },
    "limit": {
      "default": 10,
      "description": "Candidate rows per page; more remain reachable through typed next commands.",
      "format": "uint32",
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "description": "Candidate rows to skip in source order.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "resolver": {
      "$ref": "#/$defs/VariantResolver",
      "default": "car",
      "description": "Resolver for reference-qualified notation; never repairs the input locally."
    },
    "section": {
      "description": "Named source sections; omitted by default. Each calls its own source. all keeps bounded pages and source skips; it never enables a missing key.",
      "items": {
        "$ref": "#/$defs/VariantSection"
      },
      "type": "array",
      "x-positional": 1
    },
    "section_limit": {
      "description": "Rows per named source section page; omitted uses the native source default.",
      "format": "uint32",
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
    },
    "section_offset": {
      "default": 0,
      "description": "Source rows to skip independently of identity candidate paging.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "tumor_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Explicit tumor context for keyed OncoKB annotation."
    }
  },
  "required": [
    "input"
  ],
  "title": "VariantGet",
  "type": "object",
  "x-reply-query-titles": [
    "VariantGetQuery"
  ]
}
