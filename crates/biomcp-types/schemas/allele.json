{
  "$defs": {
    "Reply_Accession": {
      "description": "A reference sequence accession: RefSeq or Ensembl with its version, or LRG.",
      "pattern": "^(?:(?:N[CGMPRTW]|X[MPR])_(?:[0-9]{6}|(?!000)[0-9]{9})\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|ENS[GTP][0-9]{11}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|LRG_0*(?:0|(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))(?:[tp]0*(?:0|(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})))?)$",
      "type": "string"
    },
    "Reply_Sequence": {
      "description": "A literal IUPAC DNA sequence; empty sequences express insertions or deletions.",
      "pattern": "^[ACGTNRYSWKMBDHV]*$",
      "type": "string"
    },
    "Reply_SequenceLocation": {
      "description": "An interbase interval on one versioned sequence accession.",
      "properties": {
        "sequence": {
          "$ref": "#/$defs/Reply_Accession",
          "description": "Versioned source sequence, without an inferred genome build."
        },
        "span": {
          "$ref": "#/$defs/Reply_Span0",
          "description": "Zero-based half-open bounds."
        }
      },
      "required": [
        "sequence",
        "span"
      ],
      "type": "object"
    },
    "Reply_Span0": {
      "description": "A zero-based half-open span with ordered bounds; empty spans are valid.",
      "properties": {
        "end": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    }
  },
  "$id": "biodata.allele/3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Source-stated interbase replacement; equality never claims normalized equivalence.",
  "properties": {
    "alternate": {
      "$ref": "#/$defs/Reply_Sequence"
    },
    "location": {
      "$ref": "#/$defs/Reply_SequenceLocation"
    },
    "reference": {
      "$ref": "#/$defs/Reply_Sequence"
    }
  },
  "required": [
    "location",
    "reference",
    "alternate"
  ],
  "title": "Allele",
  "type": "object"
}
